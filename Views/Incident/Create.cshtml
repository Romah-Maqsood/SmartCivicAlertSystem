@{
    Layout = null;
    ViewData["Title"] = "Report New Incident";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #E8EDF5;
            color: #1A1F36;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .form-container {
            width: 100%;
            max-width: 700px;
            margin: 40px 20px;
        }

        .form-card {
            background: #FFFFFF;
            border-radius: 24px;
            padding: 32px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
            border: 1px solid #EAECF0;
        }

        .form-header {
            text-align: center;
            margin-bottom: 28px;
        }

            .form-header i {
                font-size: 48px;
                color: #2563EB;
                margin-bottom: 12px;
            }

            .form-header h1 {
                font-size: 24px;
                font-weight: 700;
                color: #1A1F36;
                margin-bottom: 6px;
            }

            .form-header p {
                font-size: 13px;
                color: #6B7280;
            }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 500;
            color: #1A1F36;
            margin-bottom: 8px;
        }

            .form-label i {
                color: #2563EB;
                font-size: 14px;
            }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            background: #FFFFFF;
            border: 1px solid #EAECF0;
            border-radius: 12px;
            font-family: inherit;
            font-size: 14px;
            color: #1A1F36;
            transition: all 0.2s ease;
        }

            .form-control:focus {
                outline: none;
                border-color: #2563EB;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
            }

        textarea.form-control {
            resize: vertical;
            min-height: 100px;
        }

        select.form-control {
            cursor: pointer;
            appearance: none;
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="%236B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>');
            background-repeat: no-repeat;
            background-position: right 16px center;
        }

        .location-group {
            display: flex;
            gap: 10px;
        }

            .location-group input {
                flex: 1;
            }

        .btn-coordinates {
            background: #6B7280;
            color: white;
            border: none;
            padding: 0 20px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

            .btn-coordinates:hover {
                background: #4B5563;
                transform: translateY(-1px);
            }

        .coordinates-info {
            font-size: 11px;
            color: #6B7280;
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .coordinates-info i {
                font-size: 12px;
            }

            .coordinates-info.success {
                color: #10B981;
            }

            .coordinates-info.warning {
                color: #F59E0B;
            }

            .coordinates-info.error {
                color: #DC2626;
            }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .btn-group {
            display: flex;
            gap: 16px;
            margin-top: 28px;
        }

        .btn-submit {
            flex: 1;
            background: #2563EB;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 40px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .btn-submit:hover {
                background: #1D4ED8;
                transform: translateY(-1px);
            }

        .btn-cancel {
            flex: 1;
            background: #F1F5F9;
            color: #5A6A7F;
            border: none;
            padding: 12px 20px;
            border-radius: 40px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            text-align: center;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .btn-cancel:hover {
                background: #E2E8F0;
            }

        .alert-success {
            background: #DCFCE7;
            color: #166534;
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
        }

        .alert-error {
            background: #FEF2F2;
            color: #DC2626;
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
        }

        @@media (max-width: 640px) {
            .form-card {
                padding: 24px;
            }

            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .btn-group {
                flex-direction: column;
            }

            .form-container {
                margin: 20px 16px;
            }

            .location-group {
                flex-direction: column;
            }

            .btn-coordinates {
                padding: 10px;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div class="form-container">
        <div class="form-card">
            <div class="form-header">
                <i class="fas fa-clipboard-list"></i>
                <h1>Report New Incident</h1>
                <p>Fill out the details below to submit your report</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
            <div class="alert-success">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            </div>
            }

            @if (ViewBag.Error != null)
            {
            <div class="alert-error">
                <i class="fas fa-exclamation-triangle"></i> @ViewBag.Error
            </div>
            }

            <form method="post" action="/Incident/Create">
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-heading"></i> Title
                    </label>
                    <input type="text" name="Title" class="form-control" placeholder="e.g., Fire in Market, Water Leak" required />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-align-left"></i> Description
                    </label>
                    <textarea name="Description" class="form-control" placeholder="Describe the incident in detail..." required></textarea>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-location-dot"></i> Location
                    </label>
                    <div class="location-group">
                        <input type="text" name="Location" id="Location" class="form-control" placeholder="e.g., Gulshan Chowrangi, Karachi" required />
                        <button type="button" class="btn-coordinates" id="getCoordinatesBtn">
                            <i class="fas fa-map-pin"></i> Get Coordinates
                        </button>
                    </div>
                    <div id="coordinatesInfo" class="coordinates-info">
                        <i class="fas fa-info-circle"></i> Enter location and click "Get Coordinates"
                    </div>
                    <input type="hidden" name="Latitude" id="Latitude" />
                    <input type="hidden" name="Longitude" id="Longitude" />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-chart-line"></i> Severity
                        </label>
                        <select name="Severity" class="form-control" required>
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                            <option value="Critical">Critical</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-building"></i> Department
                        </label>
                        <select name="Department" class="form-control">
                            <option value="Unassigned">Auto-assign (AI)</option>
                            <option value="Fire Department">Fire Department</option>
                            <option value="Police Department">Police Department</option>
                            <option value="Rescue/Medical">Rescue/Medical</option>
                            <option value="Roads Department">Roads Department</option>
                            <option value="Electric Department">Electric Department</option>
                        </select>
                    </div>
                </div>

                <div class="btn-group">
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-paper-plane"></i> Submit Incident
                    </button>
                    <a href="/Citizen/Index" class="btn-cancel">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script>
        const getCoordinatesBtn = document.getElementById('getCoordinatesBtn');
        const locationInput = document.getElementById('Location');
        const latitudeInput = document.getElementById('Latitude');
        const longitudeInput = document.getElementById('Longitude');
        const coordinatesInfo = document.getElementById('coordinatesInfo');

        if (getCoordinatesBtn) {
            getCoordinatesBtn.addEventListener('click', getCoordinates);
        }

        async function getCoordinates() {
            const location = locationInput.value.trim();

            if (!location) {
                coordinatesInfo.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Please enter a location first';
                coordinatesInfo.className = 'coordinates-info warning';
                return;
            }

            getCoordinatesBtn.innerHTML = '<i class="fas fa-spinner fa-pulse"></i> Loading...';
            getCoordinatesBtn.disabled = true;
            coordinatesInfo.innerHTML = '<i class="fas fa-spinner fa-pulse"></i> Fetching coordinates...';
            coordinatesInfo.className = 'coordinates-info';

            try {
                const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(location)}&limit=1`, {
                    headers: { 'Accept-Language': 'en' }
                });

                const data = await response.json();

                if (data && data.length > 0) {
                    const lat = parseFloat(data[0].lat);
                    const lon = parseFloat(data[0].lon);
                    latitudeInput.value = lat;
                    longitudeInput.value = lon;
                    coordinatesInfo.innerHTML = `<i class="fas fa-check-circle"></i> Coordinates found: ${lat.toFixed(6)}, ${lon.toFixed(6)}`;
                    coordinatesInfo.className = 'coordinates-info success';
                } else {
                    latitudeInput.value = '';
                    longitudeInput.value = '';
                    coordinatesInfo.innerHTML = `<i class="fas fa-exclamation-triangle"></i> Could not find coordinates for "${location}".`;
                    coordinatesInfo.className = 'coordinates-info warning';
                }
            } catch (error) {
                latitudeInput.value = '';
                longitudeInput.value = '';
                coordinatesInfo.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Error fetching coordinates. Please try again.';
                coordinatesInfo.className = 'coordinates-info error';
            } finally {
                getCoordinatesBtn.innerHTML = '<i class="fas fa-map-pin"></i> Get Coordinates';
                getCoordinatesBtn.disabled = false;
            }
        }
    </script>
</body>
</html>