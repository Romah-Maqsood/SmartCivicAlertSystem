@{
    Layout = null;
    ViewData["Title"] = "Report New Incident";
}
@model SmartCityPulse.Models.Incident

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Report New Incident - Smart Civic Alert</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: transparent;
            color: #1A1F36;
        }

        .form-container {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            width: 100%;
        }

        .form-wrapper {
            max-width: 650px;
            width: 100%;
            margin: 40px 0;
        }

        .toast-notification {
            position: fixed;
            top: 25px;
            right: 25px;
            background: #10B981;
            color: white;
            padding: 14px 24px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 14px;
            font-weight: 500;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
            z-index: 9999;
            animation: slideInRight 0.3s ease forwards;
        }

            .toast-notification.error {
                background: #EF4444;
            }

            .toast-notification.warning {
                background: #F59E0B;
            }

        @@keyframes slideInRight {
            from {
                transform: translateX(100%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @@keyframes fadeOut {
            from {
                opacity: 1;
                transform: translateX(0);
            }

            to {
                opacity: 0;
                transform: translateX(100%);
            }
        }

        .back-button-container {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 20px;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #FFFFFF;
            color: #4B5563;
            padding: 8px 18px;
            border-radius: 40px;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.3s ease;
            border: 1px solid #E5E7EB;
            cursor: pointer;
            text-decoration: none;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
        }

            .btn-back:hover {
                background: #F9FAFB;
                border-color: #2563EB;
                color: #2563EB;
                transform: translateY(-1px);
            }

        .form-card {
            background: #FFFFFF;
            border-radius: 24px;
            padding: 32px 36px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
            border: 1px solid #EAECF0;
        }

        .form-header {
            text-align: center;
            margin-bottom: 28px;
            padding-bottom: 20px;
            border-bottom: 1px solid #EAECF0;
        }

            .form-header i {
                font-size: 48px;
                color: #2563EB;
                margin-bottom: 12px;
            }

            .form-header h2 {
                font-size: 22px;
                font-weight: 700;
                color: #1A1F36;
                margin-bottom: 6px;
            }

            .form-header p {
                font-size: 13px;
                color: #6B7280;
            }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #1A1F36;
            margin-bottom: 8px;
        }

            .form-label i {
                color: #2563EB;
                font-size: 14px;
            }

            .form-label .required {
                color: #DC2626;
                margin-left: 4px;
            }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            background: #FFFFFF;
            border: 1.5px solid #EAECF0;
            border-radius: 12px;
            font-family: inherit;
            font-size: 14px;
            color: #1A1F36;
            transition: all 0.2s ease;
        }

            .form-control:focus {
                outline: none;
                border-color: #2563EB;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
            }

        textarea.form-control {
            resize: vertical;
            min-height: 100px;
        }

        select.form-control {
            cursor: pointer;
            appearance: none;
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="%236B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>');
            background-repeat: no-repeat;
            background-position: right 16px center;
        }

        .image-upload-area {
            border: 2px dashed #EAECF0;
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background: #F8FAFC;
        }

            .image-upload-area:hover {
                border-color: #2563EB;
                background: #EFF6FF;
            }

            .image-upload-area i {
                font-size: 40px;
                color: #94A3B8;
                margin-bottom: 12px;
            }

            .image-upload-area p {
                font-size: 13px;
                color: #6B7280;
            }

        .image-preview {
            margin-top: 16px;
            position: relative;
            display: inline-block;
        }

            .image-preview img {
                max-width: 100%;
                max-height: 200px;
                border-radius: 12px;
                border: 1px solid #EAECF0;
            }

        .remove-image {
            position: absolute;
            top: -10px;
            right: -10px;
            background: #DC2626;
            color: white;
            border: none;
            border-radius: 50%;
            width: 28px;
            height: 28px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .ai-vision-btn {
            background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 12px;
        }

            .ai-vision-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
            }

            .ai-vision-btn:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        .department-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .department-group select {
                flex: 1;
            }

        .ai-suggest-btn {
            background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

            .ai-suggest-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
            }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .btn-submit {
            width: 100%;
            background: #2563EB;
            color: white;
            border: none;
            padding: 14px 20px;
            border-radius: 40px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 8px;
        }

            .btn-submit:hover {
                background: #1D4ED8;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
            }

            .btn-submit:disabled {
                opacity: 0.7;
                cursor: not-allowed;
                transform: none;
            }

        .loading-spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid white;
            border-radius: 50%;
            border-top-color: transparent;
            animation: spin 0.6s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .location-group {
            display: flex;
            gap: 10px;
        }

            .location-group input {
                flex: 1;
            }

        .btn-coordinates {
            background: #6B7280;
            color: white;
            border: none;
            padding: 0 20px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

            .btn-coordinates:hover {
                background: #4B5563;
            }

        .coordinates-info {
            font-size: 11px;
            color: #6B7280;
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .coordinates-info.success {
                color: #10B981;
            }

            .coordinates-info.warning {
                color: #F59E0B;
            }

            .coordinates-info.error {
                color: #DC2626;
            }

        .optional-text {
            font-size: 11px;
            color: #9CA3AF;
            margin-left: 8px;
        }

        @@media (max-width: 768px) {
            .form-wrapper {
                margin: 20px;
            }

            .form-card {
                padding: 24px;
            }

            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .location-group {
                flex-direction: column;
            }

            .btn-coordinates {
                padding: 10px;
                justify-content: center;
            }

            .department-group {
                flex-direction: column;
            }

            .ai-suggest-btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div class="form-container">
        <div class="form-wrapper">
            <div class="back-button-container">
                <button class="btn-back" id="backButton">
                    <i class="fas fa-arrow-left"></i> Back to My Reports
                </button>
            </div>

            <div class="form-card">
                <div class="form-header">
                    <i class="fas fa-camera"></i>
                    <h2>Report New Incident</h2>
                    <p>Upload a photo (optional) or fill details manually</p>
                </div>

                <form id="incidentForm" enctype="multipart/form-data">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-image"></i> Incident Photo <span class="optional-text">(Optional - AI can analyze if provided)</span>
                        </label>
                        <div class="image-upload-area" id="imageUploadArea">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <p>Click or drag to upload incident photo</p>
                            <p style="font-size: 11px; margin-top: 8px;">JPG, PNG (Max 5MB)</p>
                        </div>
                        <input type="file" id="imageInput" name="ImageFile" accept="image/jpeg,image/png,image/jpg" style="display: none;">
                        <div id="imagePreviewContainer" style="display: none;" class="image-preview">
                            <img id="imagePreview" alt="Preview">
                            <button type="button" class="remove-image" id="removeImageBtn">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <button type="button" id="aiVisionAnalyzeBtn" class="ai-vision-btn" style="display: none;">
                            <i class="fas fa-robot"></i> Analyze with AI Vision
                        </button>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-heading"></i> Title <span class="required">*</span>
                        </label>
                        <input type="text" name="Title" id="Title" class="form-control" placeholder="e.g., Fire in Market, Car Accident, Theft Report" required />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-align-left"></i> Description <span class="required">*</span>
                        </label>
                        <textarea name="Description" id="Description" class="form-control" placeholder="Describe the incident in detail..." required></textarea>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-location-dot"></i> Location <span class="required">*</span>
                        </label>
                        <div class="location-group">
                            <input type="text" name="Location" id="Location" class="form-control" placeholder="e.g., Gulshan Chowrangi, Karachi" required />
                            <button type="button" class="btn-coordinates" id="getCoordinatesBtn">
                                <i class="fas fa-map-pin"></i> Get Coordinates
                            </button>
                        </div>
                        <div id="coordinatesInfo" class="coordinates-info">
                            <i class="fas fa-info-circle"></i> Enter location and click "Get Coordinates"
                        </div>
                        <input type="hidden" name="Latitude" id="Latitude" />
                        <input type="hidden" name="Longitude" id="Longitude" />
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-chart-line"></i> Severity <span class="required">*</span>
                            </label>
                            <select name="Severity" id="Severity" class="form-control" required>
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-building"></i> Department
                            </label>
                            <div class="department-group">
                                <select name="Department" id="Department" class="form-control">
                                    <option value="Fire Department">Fire Department</option>
                                    <option value="Police Department">Police Department</option>
                                    <option value="Rescue Department">Rescue Department</option>
                                </select>
                                <button type="button" class="ai-suggest-btn" id="aiSuggestDeptBtn">
                                    <i class="fas fa-robot"></i> AI Suggest
                                </button>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn-submit" id="submitBtn">
                        <i class="fas fa-paper-plane"></i> Submit Incident
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        // ==================== IMAGE UPLOAD & AI VISION (OPTIONAL) ====================
        let selectedImageFile = null;

        const imageUploadArea = document.getElementById('imageUploadArea');
        const imageInput = document.getElementById('imageInput');
        const imagePreviewContainer = document.getElementById('imagePreviewContainer');
        const imagePreview = document.getElementById('imagePreview');
        const removeImageBtn = document.getElementById('removeImageBtn');
        const aiVisionAnalyzeBtn = document.getElementById('aiVisionAnalyzeBtn');

        imageUploadArea.addEventListener('click', () => imageInput.click());
        imageInput.addEventListener('change', handleImageSelect);
        removeImageBtn.addEventListener('click', removeImage);

        function handleImageSelect(e) {
            const file = e.target.files[0];
            if (!file) return;

            const allowedTypes = ['image/jpeg', 'image/png', 'image/jpg'];
            if (!allowedTypes.includes(file.type)) {
                showToast('Please select JPG or PNG image', 'error');
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                showToast('Image size must be less than 5MB', 'error');
                return;
            }

            selectedImageFile = file;
            const reader = new FileReader();
            reader.onload = function(e) {
                imagePreview.src = e.target.result;
                imagePreviewContainer.style.display = 'inline-block';
                imageUploadArea.style.display = 'none';
                aiVisionAnalyzeBtn.style.display = 'inline-flex';
            };
            reader.readAsDataURL(file);
        }

        function removeImage() {
            selectedImageFile = null;
            imageInput.value = '';
            imagePreviewContainer.style.display = 'none';
            imageUploadArea.style.display = 'block';
            aiVisionAnalyzeBtn.style.display = 'none';
        }

        // AI Vision Analysis
        if (aiVisionAnalyzeBtn) {
            aiVisionAnalyzeBtn.addEventListener('click', async () => {
                if (!selectedImageFile) {
                    showToast('Please select an image first', 'warning');
                    return;
                }

                const formData = new FormData();
                formData.append('image', selectedImageFile);

                aiVisionAnalyzeBtn.disabled = true;
                aiVisionAnalyzeBtn.innerHTML = '<span class="loading-spinner"></span> AI Vision Analyzing...';

                try {
                    const response = await fetch('/Incident/AnalyzeImage', {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        if (result.title) document.getElementById('Title').value = result.title;
                        if (result.description) document.getElementById('Description').value = result.description;
                        if (result.severity) document.getElementById('Severity').value = result.severity;
                        if (result.department) document.getElementById('Department').value = result.department;
                        showToast('AI Vision analysis complete! Form fields have been updated.', 'success');
                    } else {
                        showToast(result.message || 'AI Vision analysis failed', 'error');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showToast('Network error. Please try again.', 'error');
                } finally {
                    aiVisionAnalyzeBtn.disabled = false;
                    aiVisionAnalyzeBtn.innerHTML = '<i class="fas fa-robot"></i> Analyze with AI Vision';
                }
            });
        }

        // ==================== AI DEPARTMENT SUGGESTION ====================
        const aiSuggestBtn = document.getElementById('aiSuggestDeptBtn');
        const titleInput = document.getElementById('Title');
        const descInput = document.getElementById('Description');
        const departmentSelect = document.getElementById('Department');

        if (aiSuggestBtn) {
            aiSuggestBtn.addEventListener('click', suggestDepartment);
        }

        function suggestDepartment() {
            const title = titleInput.value.trim();
            const description = descInput.value.trim();

            if (!title && !description) {
                showToast('Please enter title or description first', 'warning');
                return;
            }

            aiSuggestBtn.innerHTML = '<span class="loading-spinner"></span> Analyzing...';
            aiSuggestBtn.disabled = true;

            setTimeout(() => {
                const textToAnalyze = `${title} ${description}`;
                let suggestedDepartment = "Fire Department";
                let confidence = "Medium";
                const lowerText = textToAnalyze.toLowerCase();

                if (lowerText.includes('fire') || lowerText.includes('smoke') || lowerText.includes('gas') ||
                    lowerText.includes('burn') || lowerText.includes('explosion') || lowerText.includes('leak') ||
                    lowerText.includes('blast') || lowerText.includes('bomb')) {
                    suggestedDepartment = "Fire Department";
                    confidence = "High";
                }
                else if (lowerText.includes('theft') || lowerText.includes('robbery') || lowerText.includes('crime') ||
                         lowerText.includes('stolen') || lowerText.includes('snatched') || lowerText.includes('murder') ||
                         lowerText.includes('fight') || lowerText.includes('assault') || lowerText.includes('attack') ||
                         lowerText.includes('harassment')) {
                    suggestedDepartment = "Police Department";
                    confidence = "High";
                }
                else if (lowerText.includes('accident') || lowerText.includes('injured') || lowerText.includes('medical') ||
                         lowerText.includes('ambulance') || lowerText.includes('hurt') || lowerText.includes('bleeding') ||
                         lowerText.includes('unconscious') || lowerText.includes('heart') || lowerText.includes('collapse') ||
                         lowerText.includes('emergency')) {
                    suggestedDepartment = "Rescue Department";
                    confidence = "High";
                }
                else {
                    if (lowerText.includes('road') || lowerText.includes('vehicle') || lowerText.includes('car') ||
                        lowerText.includes('traffic')) {
                        suggestedDepartment = "Rescue Department";
                        confidence = "Medium";
                    } else {
                        suggestedDepartment = "Police Department";
                        confidence = "Low";
                    }
                }

                departmentSelect.value = suggestedDepartment;
                showToast(`🤖 AI suggested: ${suggestedDepartment} (${confidence} confidence)`, 'success');

                aiSuggestBtn.innerHTML = '<i class="fas fa-robot"></i> AI Suggest';
                aiSuggestBtn.disabled = false;
            }, 500);
        }

        // ==================== GET COORDINATES ====================
        const getCoordinatesBtn = document.getElementById('getCoordinatesBtn');
        const locationInput = document.getElementById('Location');
        const latitudeInput = document.getElementById('Latitude');
        const longitudeInput = document.getElementById('Longitude');
        const coordinatesInfo = document.getElementById('coordinatesInfo');

        if (getCoordinatesBtn) {
            getCoordinatesBtn.addEventListener('click', getCoordinates);
        }

        async function getCoordinates() {
            const location = locationInput.value.trim();
            if (!location) {
                coordinatesInfo.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Please enter a location first';
                coordinatesInfo.className = 'coordinates-info warning';
                return;
            }

            getCoordinatesBtn.innerHTML = '<i class="fas fa-spinner fa-pulse"></i> Loading...';
            getCoordinatesBtn.disabled = true;
            coordinatesInfo.innerHTML = '<i class="fas fa-spinner fa-pulse"></i> Fetching coordinates...';
            coordinatesInfo.className = 'coordinates-info';

            try {
                const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(location)}&limit=1`, {
                    headers: { 'Accept-Language': 'en' }
                });
                const data = await response.json();

                if (data && data.length > 0) {
                    const lat = parseFloat(data[0].lat);
                    const lon = parseFloat(data[0].lon);
                    latitudeInput.value = lat;
                    longitudeInput.value = lon;
                    coordinatesInfo.innerHTML = `<i class="fas fa-check-circle"></i> Coordinates found: ${lat.toFixed(6)}, ${lon.toFixed(6)}`;
                    coordinatesInfo.className = 'coordinates-info success';
                } else {
                    latitudeInput.value = '';
                    longitudeInput.value = '';
                    coordinatesInfo.innerHTML = `<i class="fas fa-exclamation-triangle"></i> Could not find coordinates for "${location}".`;
                    coordinatesInfo.className = 'coordinates-info warning';
                }
            } catch (error) {
                latitudeInput.value = '';
                longitudeInput.value = '';
                coordinatesInfo.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Error fetching coordinates. Please try again.';
                coordinatesInfo.className = 'coordinates-info error';
            } finally {
                getCoordinatesBtn.innerHTML = '<i class="fas fa-map-pin"></i> Get Coordinates';
                getCoordinatesBtn.disabled = false;
            }
        }

        // ==================== TOAST NOTIFICATION ====================
        function showToast(message, type = 'success') {
            const existingToast = document.querySelector('.toast-notification');
            if (existingToast) existingToast.remove();

            const toast = document.createElement('div');
            toast.className = `toast-notification ${type}`;

            let icon = 'fa-check-circle';
            if (type === 'error') icon = 'fa-exclamation-triangle';
            if (type === 'warning') icon = 'fa-exclamation-circle';

            toast.innerHTML = `<i class="fas ${icon}"></i> ${message}`;
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.style.animation = 'fadeOut 0.3s ease forwards';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // ==================== BACK BUTTON ====================
        const backButton = document.getElementById('backButton');
        if (backButton) {
            backButton.addEventListener('click', function() {
                if (window.parent && window.parent.loadViewFromChild) {
                    window.parent.loadViewFromChild('myreports', null);
                } else {
                    window.location.href = '/Citizen/MyReports';
                }
            });
        }

        // ==================== FORM SUBMISSION (WITH SUCCESS TOAST & REDIRECT) ====================
        const form = document.getElementById('incidentForm');
        const submitBtn = document.getElementById('submitBtn');

        if (form) {
            form.addEventListener('submit', async function(e) {
                e.preventDefault();

                // Validate required fields
                const title = document.getElementById('Title').value.trim();
                const description = document.getElementById('Description').value.trim();
                const location = document.getElementById('Location').value.trim();

                if (!title) {
                    showToast('Please enter a title', 'warning');
                    return;
                }
                if (!description) {
                    showToast('Please enter a description', 'warning');
                    return;
                }
                if (!location) {
                    showToast('Please enter a location', 'warning');
                    return;
                }

                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="loading-spinner"></span> Submitting...';

                const submitFormData = new FormData();
                submitFormData.append('Title', title);
                submitFormData.append('Description', description);
                submitFormData.append('Location', location);
                submitFormData.append('Latitude', latitudeInput.value || '');
                submitFormData.append('Longitude', longitudeInput.value || '');
                submitFormData.append('Severity', document.getElementById('Severity').value);
                submitFormData.append('Department', document.getElementById('Department').value);

                if (selectedImageFile) {
                    submitFormData.append('ImageFile', selectedImageFile);
                }

                try {
                    const response = await fetch('/Incident/Create', {
                        method: 'POST',
                        body: submitFormData
                    });

                    const result = await response.json();

                    if (result.success) {
                        // Show success toast message
                        showToast('✅ Incident reported successfully! Redirecting to dashboard...', 'success');

                        // Clear form
                        form.reset();
                        selectedImageFile = null;
                        imageInput.value = '';
                        imagePreviewContainer.style.display = 'none';
                        imageUploadArea.style.display = 'block';
                        aiVisionAnalyzeBtn.style.display = 'none';
                        latitudeInput.value = '';
                        longitudeInput.value = '';
                        coordinatesInfo.innerHTML = '<i class="fas fa-info-circle"></i> Enter location and click "Get Coordinates"';
                        coordinatesInfo.className = 'coordinates-info';

                        // Redirect to Citizen Dashboard after 2 seconds
                        setTimeout(() => {
                            if (window.parent && window.parent.loadViewFromChild) {
                                window.parent.loadViewFromChild('dashboard', null);
                            } else {
                                window.location.href = '/Citizen/Index';
                            }
                        }, 2000);
                    } else {
                        showToast(result.message || '❌ Failed to report incident. Please try again.', 'error');
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit Incident';
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showToast('❌ Network error. Please try again.', 'error');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit Incident';
                }
            });
        }
    </script>
</body>
</html>