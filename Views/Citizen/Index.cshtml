@{
    Layout = null;
    ViewData["Title"] = "Citizen Dashboard";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #E8EDF5;
            color: #1A1F36;
        }

        .dashboard {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 260px;
            background: #FFFFFF;
            border-right: 1px solid #EAECF0;
            position: fixed;
            height: 100vh;
            display: flex;
            flex-direction: column;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 100;
        }

        .sidebar.collapsed {
            width: 72px;
        }

        .sidebar.collapsed .logo h2,
        .sidebar.collapsed .nav-item span,
        .sidebar.collapsed .footer-item span {
            display: none;
        }

        .sidebar.collapsed .nav-item,
        .sidebar.collapsed .footer-item {
            justify-content: center;
            padding: 12px 0;
        }

        .sidebar.collapsed .nav-item i,
        .sidebar.collapsed .footer-item i {
            margin: 0;
            font-size: 20px;
        }

        .sidebar.collapsed .sidebar-header {
            justify-content: center;
            padding: 20px 0;
        }

        .sidebar.collapsed .logo {
            justify-content: center;
        }

        .sidebar-header {
            padding: 20px 16px;
            border-bottom: 1px solid #EAECF0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo i {
            font-size: 24px;
            color: #2563EB;
        }

        .logo h2 {
            font-size: 15px;
            font-weight: 700;
            color: #1A1F36;
            letter-spacing: -0.3px;
        }

        .logo span {
            color: #2563EB;
        }

        .hamburger {
            cursor: pointer;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.2s ease;
            color: #6B7280;
        }

        .hamburger:hover {
            background: #F1F5F9;
            color: #2563EB;
        }

        .hamburger i {
            font-size: 18px;
        }

        .nav-menu {
            flex: 1;
            padding: 20px 12px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            margin: 2px 0;
            color: #5A6A7F;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.2s ease;
            border-radius: 10px;
        }

        .nav-item i {
            width: 20px;
            font-size: 16px;
        }

        .nav-item:hover {
            background: #F1F5F9;
            color: #2563EB;
        }

        .nav-item.active {
            background: #EFF6FF;
            color: #2563EB;
        }

        .nav-item.sos {
            background: #FEF2F2;
            color: #DC2626;
            margin-top: 8px;
        }

        .nav-item.sos:hover {
            background: #FEE2E2;
        }

        .nav-footer {
            padding: 16px 12px;
            border-top: 1px solid #EAECF0;
        }

        .footer-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            color: #5A6A7F;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            border-radius: 10px;
            transition: all 0.2s ease;
        }

        .footer-item:hover {
            background: #F1F5F9;
            color: #2563EB;
        }

        .footer-item.logout {
            color: #DC2626;
        }

        .footer-item.logout:hover {
            background: #FEF2F2;
        }

        .main-content {
            margin-left: 260px;
            flex: 1;
            padding: 24px 32px;
            background: #E8EDF5;
            transition: margin-left 0.3s ease;
            min-height: 100vh;
        }

        .sidebar.collapsed ~ .main-content {
            margin-left: 72px;
        }

        /* Welcome Header - Sirf Dashboard Mein */
        .welcome-header {
            margin-bottom: 28px;
        }

        .welcome-header h1 {
            font-size: 22px;
            font-weight: 700;
            color: #1A1F36;
        }

        .welcome-header h1 i {
            color: #2563EB;
            margin-right: 8px;
            font-size: 20px;
        }

        .welcome-header p {
            font-size: 13px;
            color: #6B7280;
            margin-top: 6px;
        }

        /* Success Message - Sirf Dashboard Mein Dikhega */
        .alert-success {
            background: #DCFCE7;
            color: #166534;
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 18px 20px;
            transition: all 0.3s ease;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
        }

        .stat-card.total::before { background: #3B82F6; }
        .stat-card.resolved::before { background: #10B981; }
        .stat-card.pending::before { background: #F59E0B; }
        .stat-card.critical::before { background: #EF4444; }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
        }

        .stat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .stat-header .stat-label {
            font-size: 12px;
            font-weight: 500;
            color: #6B7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-header i {
            font-size: 24px;
            opacity: 0.7;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 800;
            color: #1A1F36;
            margin-bottom: 6px;
        }

        .stat-trend {
            font-size: 11px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .trend-up { color: #10B981; }
        .trend-down { color: #EF4444; }

        .row-2cols {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 28px;
        }

        .chart-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        }

        .card-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        .card-title h3 {
            font-size: 14px;
            font-weight: 600;
            color: #1A1F36;
        }

        .card-title a {
            font-size: 11px;
            color: #2563EB;
            text-decoration: none;
        }

        canvas {
            max-height: 200px;
            width: 100%;
        }

        .quick-action-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
            border-top: 3px solid #2563EB;
        }

        .quick-action-card h3 {
            font-size: 14px;
            font-weight: 600;
            color: #1A1F36;
            margin-bottom: 8px;
        }

        .quick-action-card p {
            font-size: 12px;
            color: #6B7280;
            margin-bottom: 16px;
        }

        .btn-report {
            background: #2563EB;
            color: white;
            padding: 8px 16px;
            border-radius: 40px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            width: fit-content;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-report:hover {
            background: #1D4ED8;
            transform: translateY(-1px);
        }

        .recent-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        }

        .table-responsive {
            overflow-x: auto;
        }

        .incident-table {
            width: 100%;
            border-collapse: collapse;
        }

        .incident-table th {
            text-align: left;
            padding: 10px 0;
            color: #6B7280;
            font-size: 11px;
            font-weight: 500;
            border-bottom: 1px solid #EAECF0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .incident-table td {
            padding: 10px 0;
            font-size: 12px;
            color: #1A1F36;
            border-bottom: 1px solid #EAECF0;
        }

        .status-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 50px;
            font-size: 10px;
            font-weight: 500;
        }

        .status-resolved { background: #DCFCE7; color: #166534; }
        .status-progress { background: #FEF3C7; color: #92400E; }
        .status-open { background: #DBEAFE; color: #1E40AF; }

        .severity-critical { color: #DC2626; font-weight: 600; }
        .severity-high { color: #F97316; font-weight: 600; }
        .severity-medium { color: #EAB308; font-weight: 600; }
        .severity-low { color: #10B981; font-weight: 600; }

        .action-link {
            color: #2563EB;
            text-decoration: none;
            font-size: 11px;
        }

        .critical-alert {
            background: #FEF2F2;
            border-left: 3px solid #DC2626;
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .critical-alert i {
            color: #DC2626;
            margin-right: 8px;
        }

        .critical-alert a {
            color: #DC2626;
            text-decoration: none;
            font-size: 12px;
            font-weight: 500;
        }

        .chatbot-widget {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 1000;
        }

        .chatbot-toggle {
            width: 50px;
            height: 50px;
            background: #2563EB;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
            transition: all 0.3s ease;
        }

        .chatbot-toggle:hover {
            transform: scale(1.05);
            background: #1D4ED8;
        }

        .chatbot-toggle i {
            font-size: 22px;
            color: white;
        }

        .chatbot-container {
            position: absolute;
            bottom: 65px;
            right: 0;
            width: 320px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.15);
            display: none;
            flex-direction: column;
            overflow: hidden;
            border: 1px solid #EAECF0;
        }

        .chatbot-container.show {
            display: flex;
        }

        .chatbot-header {
            background: #2563EB;
            padding: 12px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
        }

        .chatbot-header span {
            font-weight: 500;
            font-size: 13px;
        }

        .chatbot-header i {
            cursor: pointer;
        }

        .chatbot-messages {
            height: 280px;
            overflow-y: auto;
            padding: 14px;
            background: #F9FAFB;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .message {
            display: flex;
        }

        .message.bot {
            justify-content: flex-start;
        }

        .message.user {
            justify-content: flex-end;
        }

        .message-content {
            max-width: 80%;
            padding: 8px 12px;
            border-radius: 16px;
            font-size: 12px;
            line-height: 1.4;
        }

        .message.bot .message-content {
            background: white;
            border: 1px solid #EAECF0;
            color: #1A1F36;
        }

        .message.user .message-content {
            background: #2563EB;
            color: white;
        }

        .chatbot-input {
            padding: 10px 12px;
            border-top: 1px solid #EAECF0;
            display: flex;
            gap: 8px;
            background: white;
        }

        .chatbot-input input {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid #EAECF0;
            border-radius: 40px;
            font-family: inherit;
            font-size: 12px;
            outline: none;
        }

        .chatbot-input input:focus {
            border-color: #2563EB;
        }

        .chatbot-input button {
            width: 34px;
            height: 34px;
            background: #2563EB;
            color: white;
            border: none;
            border-radius: 50%;
            cursor: pointer;
        }

        .sos-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .sos-modal.show {
            display: flex;
        }

        .sos-modal-content {
            background: white;
            border-radius: 24px;
            padding: 28px;
            max-width: 360px;
            text-align: center;
        }

        .sos-modal-content i {
            font-size: 44px;
            color: #DC2626;
            margin-bottom: 14px;
        }

        .sos-buttons {
            display: flex;
            gap: 12px;
            margin-top: 20px;
            justify-content: center;
        }

        .sos-confirm {
            background: #DC2626;
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 40px;
            cursor: pointer;
            font-weight: 500;
        }

        .sos-cancel {
            background: #E5E7EB;
            color: #1A1F36;
            border: none;
            padding: 8px 20px;
            border-radius: 40px;
            cursor: pointer;
            font-weight: 500;
        }

        .content-section {
            display: none;
        }

        .content-section.active {
            display: block;
        }

        @@media (max-width: 1024px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .row-2cols { grid-template-columns: 1fr; }
        }

        @@media (max-width: 768px) {
            .sidebar { width: 100%; position: relative; height: auto; }
            .sidebar.collapsed { width: 100%; }
            .main-content { margin-left: 0; padding: 20px; }
            .sidebar.collapsed ~ .main-content { margin-left: 0; }
            .stats-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <i class="fas fa-city"></i>
                    <h2>SMART CIVIC <span>ALERT</span></h2>
                </div>
                <div class="hamburger" id="toggleSidebar">
                    <i class="fas fa-bars"></i>
                </div>
            </div>

            <div class="nav-menu">
                <a href="#" class="nav-item active" data-page="dashboard">
                    <i class="fas fa-chart-pie"></i> <span>Dashboard</span>
                </a>
                <a href="#" class="nav-item" data-page="myreports">
                    <i class="fas fa-file-alt"></i> <span>My Reports</span>
                </a>
                <a href="#" class="nav-item" data-page="mapview">
                    <i class="fas fa-map-marker-alt"></i> <span>Map View</span>
                </a>
                <a href="#" class="nav-item" data-page="notifications">
                    <i class="fas fa-bell"></i> <span>Notifications</span>
                </a>
                <a href="#" class="nav-item" data-page="reports">
                    <i class="fas fa-download"></i> <span>Reports (PDF)</span>
                </a>
                <a href="#" class="nav-item sos" id="sosButton">
                    <i class="fas fa-exclamation-triangle"></i> <span>SOS Emergency</span>
                </a>
                <a href="#" class="nav-item" data-page="safetytips">
                    <i class="fas fa-shield-alt"></i> <span>Safety Tips</span>
                </a>
            </div>

            <div class="nav-footer">
                <a href="#" class="footer-item" data-page="profile">
                    <i class="fas fa-user-circle"></i> <span>My Profile</span>
                </a>
                <a href="/Account/Logout" class="footer-item logout">
                    <i class="fas fa-sign-out-alt"></i> <span>Logout</span>
                </a>
            </div>
        </div>

        <div class="main-content">
            <!-- DASHBOARD SECTION -->
            <div id="dashboard-section" class="content-section active">
                <!-- Welcome Message - Sirf Dashboard Mein -->
                <div class="welcome-header">
                    <h1><i class="fas fa-hand-wave"></i> Welcome back, @ViewBag.UserName!</h1>
                    <p>Track your incidents, report issues, and stay updated.</p>
                </div>

                <!-- Success Message - Sirf Dashboard Mein -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert-success">
                        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                    </div>
                }

                <div class="stats-grid">
                    <div class="stat-card total">
                        <div class="stat-header">
                            <span class="stat-label">Total Reports</span>
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="stat-value">@ViewBag.TotalIncidents</div>
                        <div class="stat-trend trend-up"><i class="fas fa-arrow-up"></i> from last month</div>
                    </div>
                    <div class="stat-card resolved">
                        <div class="stat-header">
                            <span class="stat-label">Resolved</span>
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="stat-value">@ViewBag.ResolvedIncidents</div>
                        <div class="stat-trend trend-up"><i class="fas fa-arrow-up"></i> from last month</div>
                    </div>
                    <div class="stat-card pending">
                        <div class="stat-header">
                            <span class="stat-label">Pending</span>
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="stat-value">@ViewBag.PendingIncidents</div>
                        <div class="stat-trend trend-down"><i class="fas fa-arrow-down"></i> from last month</div>
                    </div>
                    <div class="stat-card critical">
                        <div class="stat-header">
                            <span class="stat-label">Critical</span>
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="stat-value">@ViewBag.CriticalIncidents</div>
                        <div class="stat-trend trend-down"><i class="fas fa-arrow-down"></i> from last month</div>
                    </div>
                </div>

                <div class="row-2cols">
                    <div class="chart-card">
                        <div class="card-title">
                            <h3><i class="fas fa-chart-bar"></i> Incident Trends (Last 7 Days)</h3>
                            <a href="#" data-page="myreports">View Details →</a>
                        </div>
                        <canvas id="incidentChart"></canvas>
                    </div>
                    <div class="quick-action-card">
                        <h3><i class="fas fa-clipboard-list"></i> Report an incident?</h3>
                        <p>Your report will be routed to the right department instantly.</p>
                        <a href="#" class="btn-report" data-page="newincident">
                            <i class="fas fa-plus-circle"></i> New Incident
                        </a>
                    </div>
                </div>

                @if (ViewBag.CriticalIncidents > 0)
                {
                    <div class="critical-alert">
                        <div>
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>@ViewBag.CriticalIncidents critical incidents</strong> require immediate attention!
                        </div>
                        <a href="#" data-page="myreports">View Details →</a>
                    </div>
                }

                <div class="recent-card">
                    <div class="card-title">
                        <h3><i class="fas fa-history"></i> Recent Incidents</h3>
                        <a href="#" data-page="myreports">View All →</a>
                    </div>
                    <div class="table-responsive">
                        <table class="incident-table">
                            <thead>
                                <tr><th>ID</th><th>Title</th><th>Location</th><th>Severity</th><th>Status</th><th>Date</th><th>Action</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var incident in ViewBag.MyIncidents)
                                {
                                    <tr>
                                        <td>#@(incident.Id?.Length >= 6 ? incident.Id.Substring(0, 6) : incident.Id)</td>
                                        <td>@(incident.Title?.Length > 25 ? incident.Title.Substring(0, 22) + "..." : incident.Title)</td>
                                        <td>@(incident.Location?.Length > 20 ? incident.Location.Substring(0, 17) + "..." : incident.Location)</td>
                                        <td class="severity-@(incident.Severity?.ToLower())">@incident.Severity</td>
                                        <td><span class="status-badge status-@(incident.Status?.ToLower())">@incident.Status</span></td>
                                        <td>@incident.ReportedAt.ToString("MMM dd")</td>
                                        <td><a href="#" class="action-link" data-page="details" data-id="@incident.Id"><i class="fas fa-eye"></i> Track</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- MY REPORTS SECTION - NO WELCOME MESSAGE -->
            <div id="myreports-section" class="content-section">
                <div class="recent-card">
                    <div class="card-title">
                        <h3><i class="fas fa-file-alt"></i> All My Reports</h3>
                        <a href="#" data-page="newincident">+ New Incident</a>
                    </div>
                    <div class="table-responsive">
                        <table class="incident-table">
                            <thead>
                                <tr><th>ID</th><th>Title</th><th>Location</th><th>Severity</th><th>Status</th><th>Date</th><th>Action</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var incident in ViewBag.AllIncidents)
                                {
                                    <tr>
                                        <td>#@(incident.Id?.Length >= 6 ? incident.Id.Substring(0, 6) : incident.Id)</td>
                                        <td>@incident.Title</td>
                                        <td>@incident.Location</td>
                                        <td class="severity-@(incident.Severity?.ToLower())">@incident.Severity</td>
                                        <td><span class="status-badge status-@(incident.Status?.ToLower())">@incident.Status</span></td>
                                        <td>@incident.ReportedAt.ToString("MMM dd, yyyy")</td>
                                        <td><a href="#" class="action-link" data-page="details" data-id="@incident.Id"><i class="fas fa-eye"></i> Track</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- MAP VIEW SECTION - NO WELCOME MESSAGE -->
            <div id="mapview-section" class="content-section">
                <div class="chart-card">
                    <div class="card-title"><h3><i class="fas fa-map-marker-alt"></i> Incident Map</h3></div>
                    <div style="height: 400px; background: #E2E8F0; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <p style="color: #6B7280;"><i class="fas fa-map"></i> Map view coming soon...</p>
                    </div>
                </div>
            </div>

            <!-- NOTIFICATIONS SECTION - NO WELCOME MESSAGE -->
            <div id="notifications-section" class="content-section">
                <div class="recent-card">
                    <div class="card-title"><h3><i class="fas fa-bell"></i> Notifications</h3></div>
                    <p style="color: #6B7280; text-align: center; padding: 40px;">No new notifications</p>
                </div>
            </div>

            <!-- REPORTS SECTION - NO WELCOME MESSAGE -->
            <div id="reports-section" class="content-section">
                <div class="chart-card">
                    <div class="card-title"><h3><i class="fas fa-download"></i> Download Reports</h3></div>
                    <div style="display: flex; gap: 16px; justify-content: center; padding: 20px;">
                        <button class="btn-report" onclick="alert('PDF download started')"><i class="fas fa-file-pdf"></i> Download PDF</button>
                        <button class="btn-report" style="background: #10B981;" onclick="alert('CSV download started')"><i class="fas fa-file-excel"></i> Download CSV</button>
                    </div>
                </div>
            </div>

            <!-- PROFILE SECTION - NO WELCOME MESSAGE -->
            <div id="profile-section" class="content-section">
                <div class="chart-card">
                    <div class="card-title"><h3><i class="fas fa-user-circle"></i> My Profile</h3></div>
                    <div style="padding: 20px;">
                        <p><strong>Name:</strong> @ViewBag.UserName</p>
                        <p><strong>Email:</strong> @ViewBag.UserEmail</p>
                        <p><strong>Role:</strong> Citizen</p>
                        <button class="btn-report" style="margin-top: 20px;" onclick="alert('Edit profile feature coming soon')">Edit Profile</button>
                    </div>
                </div>
            </div>

            <!-- SAFETY TIPS SECTION - NO WELCOME MESSAGE -->
            <div id="safetytips-section" class="content-section">
                <div class="recent-card">
                    <div class="card-title"><h3><i class="fas fa-shield-alt"></i> Safety Tips</h3></div>
                    <div style="padding: 20px;">
                        <ul style="list-style: none;">
                            <li style="padding: 10px 0;"><i class="fas fa-phone" style="color: #2563EB;"></i> Emergency: Dial 1122 for Rescue, 15 for Police, 16 for Fire</li>
                            <li style="padding: 10px 0;"><i class="fas fa-location-dot"></i> Always share your exact location when reporting an incident</li>
                            <li style="padding: 10px 0;"><i class="fas fa-camera"></i> Take photos of the incident for better assessment</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- DETAILS SECTION -->
            <div id="details-section" class="content-section">
                <div class="chart-card" id="detailsContent">
                    <div class="card-title"><h3><i class="fas fa-info-circle"></i> Incident Details</h3><a href="#" data-page="dashboard">← Back</a></div>
                    <div style="padding: 20px; text-align: center;">Loading...</div>
                </div>
            </div>

            <!-- NEW INCIDENT SECTION -->
            <div id="newincident-section" class="content-section">
                <div class="chart-card">
                    <div class="card-title"><h3><i class="fas fa-plus-circle"></i> Report New Incident</h3><a href="#" data-page="dashboard">← Back</a></div>
                    <iframe src="/Incident/Create" style="width: 100%; min-height: 500px; border: none; border-radius: 12px;"></iframe>
                </div>
            </div>
        </div>
    </div>

    <div class="chatbot-widget">
        <div class="chatbot-container" id="chatbotContainer">
            <div class="chatbot-header">
                <span><i class="fas fa-robot"></i> City Assistant</span>
                <i class="fas fa-times" onclick="toggleChatbot()"></i>
            </div>
            <div class="chatbot-messages" id="chatMessages">
                <div class="message bot"><div class="message-content">Hello! I'm your City Assistant. How can I help you today?</div></div>
            </div>
            <div class="chatbot-input">
                <input type="text" id="chatInput" placeholder="Ask me anything..." onkeypress="handleChatKeyPress(event)">
                <button onclick="sendChatMessage()"><i class="fas fa-paper-plane"></i></button>
            </div>
        </div>
        <div class="chatbot-toggle" onclick="toggleChatbot()"><i class="fas fa-comment-dots"></i></div>
    </div>

    <div id="sosModal" class="sos-modal">
        <div class="sos-modal-content">
            <i class="fas fa-exclamation-triangle"></i>
            <h3>Emergency SOS!</h3>
            <p>Are you sure you want to send an emergency alert?</p>
            <div class="sos-buttons">
                <button class="sos-confirm" id="confirmSos">Send Alert</button>
                <button class="sos-cancel" id="cancelSos">Cancel</button>
            </div>
        </div>
    </div>

    <script>
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggleSidebar');
        toggleBtn.addEventListener('click', () => { sidebar.classList.toggle('collapsed'); });

        const ctx = document.getElementById('incidentChart').getContext('2d');
        const weeklyData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.WeeklyData));
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['6d', '5d', '4d', '3d', '2d', 'Yes', 'Today'],
                datasets: [{ label: 'Incidents Reported', data: weeklyData, backgroundColor: '#2563EB', borderRadius: 6, barPercentage: 0.6 }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: { legend: { position: 'top', labels: { boxWidth: 10, font: { size: 10 } } } },
                scales: { y: { beginAtZero: true, grid: { color: '#EAECF0' }, ticks: { stepSize: 1 } }, x: { grid: { display: false } } }
            }
        });

        document.querySelectorAll('[data-page]').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const page = this.getAttribute('data-page');
                const id = this.getAttribute('data-id');
                document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));
                if (this.classList.contains('nav-item')) this.classList.add('active');
                document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active'));
                const target = document.getElementById(`${page}-section`);
                if (target) target.classList.add('active');
                if (page === 'details' && id) loadDetails(id);
            });
        });

        function loadDetails(id) {
            fetch(`/Citizen/GetIncidentJson/${id}`)
                .then(res => res.json())
                .then(data => {
                    document.getElementById('detailsContent').innerHTML = `
                        <div class="card-title"><h3><i class="fas fa-info-circle"></i> Incident Details</h3><a href="#" data-page="dashboard">← Back</a></div>
                        <div style="padding: 20px;">
                            <p><strong>ID:</strong> #${data.id}</p>
                            <p><strong>Title:</strong> ${data.title}</p>
                            <p><strong>Description:</strong> ${data.description}</p>
                            <p><strong>Location:</strong> ${data.location}</p>
                            <p><strong>Severity:</strong> <span class="severity-${data.severity.toLowerCase()}">${data.severity}</span></p>
                            <p><strong>Status:</strong> <span class="status-badge status-${data.status.toLowerCase()}">${data.status}</span></p>
                            <p><strong>Reported:</strong> ${new Date(data.reportedAt).toLocaleString()}</p>
                        </div>
                    `;
                }).catch(() => document.getElementById('detailsContent').innerHTML = '<div style="padding:20px;text-align:center;color:red;">Error loading</div>');
        }

        function toggleChatbot() { document.getElementById('chatbotContainer').classList.toggle('show'); }
        function handleChatKeyPress(e) { if (e.key === 'Enter') sendChatMessage(); }
        function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const msg = input.value.trim();
            if (!msg) return;
            const container = document.getElementById('chatMessages');
            container.innerHTML += `<div class="message user"><div class="message-content">${escapeHtml(msg)}</div></div>`;
            input.value = '';
            container.scrollTop = container.scrollHeight;
            setTimeout(() => {
                container.innerHTML += `<div class="message bot"><div class="message-content">Thank you! Our team will respond soon.</div></div>`;
                container.scrollTop = container.scrollHeight;
            }, 500);
        }
        function escapeHtml(t) { const d = document.createElement('div'); d.textContent = t; return d.innerHTML; }

        const sosModal = document.getElementById('sosModal');
        document.getElementById('sosButton').addEventListener('click', e => { e.preventDefault(); sosModal.classList.add('show'); });
        document.getElementById('cancelSos').addEventListener('click', () => sosModal.classList.remove('show'));
        document.getElementById('confirmSos').addEventListener('click', () => window.location.href = '/Citizen/CreateEmergency');
        window.addEventListener('click', e => { if (e.target === sosModal) sosModal.classList.remove('show'); });
    </script>
</body>
</html>