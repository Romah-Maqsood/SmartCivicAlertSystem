@{
    Layout = null;
    ViewData["Title"] = "Citizen Dashboard";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #E8EDF5;
            color: #1A1F36;
        }

        .dashboard {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 260px;
            background: #FFFFFF;
            border-right: 1px solid #EAECF0;
            position: fixed;
            height: 100vh;
            display: flex;
            flex-direction: column;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 100;
        }

            .sidebar.collapsed {
                width: 72px;
            }

                .sidebar.collapsed .logo h2,
                .sidebar.collapsed .nav-item span,
                .sidebar.collapsed .footer-item span {
                    display: none;
                }

                .sidebar.collapsed .nav-item,
                .sidebar.collapsed .footer-item {
                    justify-content: center;
                    padding: 12px 0;
                }

                    .sidebar.collapsed .nav-item i,
                    .sidebar.collapsed .footer-item i {
                        margin: 0;
                        font-size: 20px;
                    }

                .sidebar.collapsed .sidebar-header {
                    justify-content: center;
                    padding: 20px 0;
                }

                .sidebar.collapsed .logo {
                    justify-content: center;
                }

        .sidebar-header {
            padding: 20px 16px;
            border-bottom: 1px solid #EAECF0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .logo i {
                font-size: 24px;
                color: #2563EB;
            }

            .logo h2 {
                font-size: 15px;
                font-weight: 700;
                color: #1A1F36;
                letter-spacing: -0.3px;
            }

            .logo span {
                color: #2563EB;
            }

        .hamburger {
            cursor: pointer;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.2s ease;
            color: #6B7280;
        }

            .hamburger:hover {
                background: #F1F5F9;
                color: #2563EB;
            }

            .hamburger i {
                font-size: 18px;
            }

        .nav-menu {
            flex: 1;
            padding: 20px 12px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            margin: 2px 0;
            color: #5A6A7F;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.2s ease;
            border-radius: 10px;
            cursor: pointer;
        }

            .nav-item i {
                width: 20px;
                font-size: 16px;
            }

            .nav-item:hover {
                background: #F1F5F9;
                color: #2563EB;
            }

            .nav-item.active {
                background: #EFF6FF;
                color: #2563EB;
            }

            .nav-item.sos {
                background: #FEF2F2;
                color: #DC2626;
                margin-top: 8px;
            }

                .nav-item.sos:hover {
                    background: #FEE2E2;
                }

        .nav-footer {
            padding: 16px 12px;
            border-top: 1px solid #EAECF0;
        }

        .footer-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            color: #5A6A7F;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            border-radius: 10px;
            transition: all 0.2s ease;
            cursor: pointer;
        }

            .footer-item:hover {
                background: #F1F5F9;
                color: #2563EB;
            }

            .footer-item.logout {
                color: #DC2626;
            }

                .footer-item.logout:hover {
                    background: #FEF2F2;
                }

        .main-content {
            margin-left: 260px;
            flex: 1;
            padding: 24px 32px;
            background: #E8EDF5;
            transition: margin-left 0.3s ease;
            min-height: 100vh;
        }

        .sidebar.collapsed ~ .main-content {
            margin-left: 72px;
        }

        .welcome-header {
            margin-bottom: 28px;
        }

            .welcome-header h1 {
                font-size: 22px;
                font-weight: 700;
                color: #1A1F36;
            }

                .welcome-header h1 i {
                    color: #2563EB;
                    margin-right: 8px;
                    font-size: 20px;
                }

            .welcome-header p {
                font-size: 13px;
                color: #6B7280;
                margin-top: 6px;
            }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 18px 20px;
            transition: all 0.3s ease;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
            position: relative;
            overflow: hidden;
        }

            .stat-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
            }

            .stat-card.total::before {
                background: #3B82F6;
            }

            .stat-card.resolved::before {
                background: #10B981;
            }

            .stat-card.pending::before {
                background: #F59E0B;
            }

            .stat-card.critical::before {
                background: #EF4444;
            }

            .stat-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
            }

        .stat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

            .stat-header .stat-label {
                font-size: 12px;
                font-weight: 500;
                color: #6B7280;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .stat-header i {
                font-size: 24px;
                opacity: 0.7;
            }

        .stat-value {
            font-size: 28px;
            font-weight: 800;
            color: #1A1F36;
            margin-bottom: 6px;
        }

        .stat-trend {
            font-size: 11px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .trend-up {
            color: #10B981;
        }

        .trend-down {
            color: #EF4444;
        }

        .row-2cols {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 28px;
        }

        .chart-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        }

        .card-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

            .card-title h3 {
                font-size: 14px;
                font-weight: 600;
                color: #1A1F36;
            }

            .card-title a {
                font-size: 11px;
                color: #2563EB;
                text-decoration: none;
                cursor: pointer;
            }

        canvas {
            max-height: 200px;
            width: 100%;
        }

        .quick-action-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
            border-top: 3px solid #2563EB;
        }

            .quick-action-card h3 {
                font-size: 14px;
                font-weight: 600;
                color: #1A1F36;
                margin-bottom: 8px;
            }

            .quick-action-card p {
                font-size: 12px;
                color: #6B7280;
                margin-bottom: 16px;
            }

        .btn-report {
            background: #2563EB;
            color: white;
            padding: 8px 16px;
            border-radius: 40px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            width: fit-content;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

            .btn-report:hover {
                background: #1D4ED8;
                transform: translateY(-1px);
            }

        .recent-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        }

        .table-responsive {
            overflow-x: auto;
        }

        .incident-table {
            width: 100%;
            border-collapse: collapse;
        }

            .incident-table th {
                text-align: left;
                padding: 10px 0;
                color: #6B7280;
                font-size: 11px;
                font-weight: 500;
                border-bottom: 1px solid #EAECF0;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .incident-table td {
                padding: 10px 0;
                font-size: 12px;
                color: #1A1F36;
                border-bottom: 1px solid #EAECF0;
            }

        .status-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 50px;
            font-size: 10px;
            font-weight: 500;
        }

        .status-resolved {
            background: #DCFCE7;
            color: #166534;
        }

        .status-progress {
            background: #FEF3C7;
            color: #92400E;
        }

        .status-open {
            background: #DBEAFE;
            color: #1E40AF;
        }

        .severity-critical {
            color: #DC2626;
            font-weight: 600;
        }

        .severity-high {
            color: #F97316;
            font-weight: 600;
        }

        .severity-medium {
            color: #EAB308;
            font-weight: 600;
        }

        .severity-low {
            color: #10B981;
            font-weight: 600;
        }

        .action-link {
            color: #2563EB;
            text-decoration: none;
            font-size: 11px;
            cursor: pointer;
        }

        .critical-alert {
            background: #FEF2F2;
            border-left: 3px solid #DC2626;
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .critical-alert i {
                color: #DC2626;
                margin-right: 8px;
            }

            .critical-alert a {
                color: #DC2626;
                text-decoration: none;
                font-size: 12px;
                font-weight: 500;
                cursor: pointer;
            }

        /* Dynamic Content Area */
        .dynamic-content {
            background: transparent;
            min-height: 500px;
        }

        .loading-spinner {
            text-align: center;
            padding: 60px;
            background: #FFFFFF;
            border-radius: 16px;
            color: #6B7280;
        }

            .loading-spinner i {
                font-size: 40px;
                margin-bottom: 16px;
                display: inline-block;
            }

        .chatbot-widget {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 1000;
        }

        .chatbot-toggle {
            width: 50px;
            height: 50px;
            background: #2563EB;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
            transition: all 0.3s ease;
        }

            .chatbot-toggle:hover {
                transform: scale(1.05);
                background: #1D4ED8;
            }

            .chatbot-toggle i {
                font-size: 22px;
                color: white;
            }

        .chatbot-container {
            position: absolute;
            bottom: 65px;
            right: 0;
            width: 320px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.15);
            display: none;
            flex-direction: column;
            overflow: hidden;
            border: 1px solid #EAECF0;
        }

            .chatbot-container.show {
                display: flex;
            }

        .chatbot-header {
            background: #2563EB;
            padding: 12px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
        }

            .chatbot-header span {
                font-weight: 500;
                font-size: 13px;
            }

            .chatbot-header i {
                cursor: pointer;
            }

        .chatbot-messages {
            height: 280px;
            overflow-y: auto;
            padding: 14px;
            background: #F9FAFB;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .message {
            display: flex;
        }

            .message.bot {
                justify-content: flex-start;
            }

            .message.user {
                justify-content: flex-end;
            }

        .message-content {
            max-width: 80%;
            padding: 8px 12px;
            border-radius: 16px;
            font-size: 12px;
            line-height: 1.4;
        }

        .message.bot .message-content {
            background: white;
            border: 1px solid #EAECF0;
            color: #1A1F36;
        }

        .message.user .message-content {
            background: #2563EB;
            color: white;
        }

        .chatbot-input {
            padding: 10px 12px;
            border-top: 1px solid #EAECF0;
            display: flex;
            gap: 8px;
            background: white;
        }

            .chatbot-input input {
                flex: 1;
                padding: 8px 12px;
                border: 1px solid #EAECF0;
                border-radius: 40px;
                font-family: inherit;
                font-size: 12px;
                outline: none;
            }

                .chatbot-input input:focus {
                    border-color: #2563EB;
                }

            .chatbot-input button {
                width: 34px;
                height: 34px;
                background: #2563EB;
                color: white;
                border: none;
                border-radius: 50%;
                cursor: pointer;
            }

        .sos-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

            .sos-modal.show {
                display: flex;
            }

        .sos-modal-content {
            background: white;
            border-radius: 24px;
            padding: 28px;
            max-width: 360px;
            text-align: center;
        }

            .sos-modal-content i {
                font-size: 44px;
                color: #DC2626;
                margin-bottom: 14px;
            }

        .sos-buttons {
            display: flex;
            gap: 12px;
            margin-top: 20px;
            justify-content: center;
        }

        .sos-confirm {
            background: #DC2626;
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 40px;
            cursor: pointer;
            font-weight: 500;
        }

        .sos-cancel {
            background: #E5E7EB;
            color: #1A1F36;
            border: none;
            padding: 8px 20px;
            border-radius: 40px;
            cursor: pointer;
            font-weight: 500;
        }

        @@media (max-width: 1024px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .row-2cols {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .sidebar {
                width: 100%;
                position: relative;
                height: auto;
            }

                .sidebar.collapsed {
                    width: 100%;
                }

            .main-content {
                margin-left: 0;
                padding: 20px;
            }

            .sidebar.collapsed ~ .main-content {
                margin-left: 0;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
        /* Enhanced SOS Modal Styles */
        .sos-modal-content {
            background: white;
            border-radius: 24px;
            padding: 32px;
            max-width: 400px;
            text-align: center;
            animation: modalPopIn 0.3s ease;
        }

        @@keyframes modalPopIn {
            from {
                transform: scale(0.9);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        .sos-warning-icon {
            width: 70px;
            height: 70px;
            background: #FEF2F2;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px auto;
        }

            .sos-warning-icon i {
                font-size: 35px;
                color: #DC2626;
            }

        .sos-modal-content h3 {
            font-size: 18px;
            margin-bottom: 12px;
            color: #DC2626;
        }

        .sos-modal-content p {
            font-size: 13px;
            color: #6B7280;
            margin-bottom: 16px;
        }

        .sos-buttons {
            display: flex;
            gap: 12px;
            margin-top: 20px;
            justify-content: center;
        }

        .sos-confirm {
            background: #DC2626;
            color: white;
            border: none;
            padding: 10px 24px;
            border-radius: 40px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

            .sos-confirm:hover {
                background: #B91C1C;
                transform: scale(1.02);
            }

        .sos-cancel {
            background: #F1F5F9;
            color: #1A1F36;
            border: none;
            padding: 10px 24px;
            border-radius: 40px;
            cursor: pointer;
            font-weight: 500;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

            .sos-cancel:hover {
                background: #E2E8F0;
            }

        /* ==================== CHATBOT STYLES ==================== */
        .chatbot-widget {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 1000;
        }

        .chatbot-toggle {
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(37, 99, 235, 0.4);
            transition: all 0.3s ease;
            border: none;
        }

            .chatbot-toggle:hover {
                transform: scale(1.05);
                box-shadow: 0 6px 20px rgba(37, 99, 235, 0.5);
            }

            .chatbot-toggle i {
                font-size: 24px;
                color: white;
            }

        .chatbot-container {
            position: absolute;
            bottom: 75px;
            right: 0;
            width: 360px;
            height: 480px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            display: none;
            flex-direction: column;
            overflow: hidden;
            border: 1px solid #EAECF0;
            animation: slideUp 0.3s ease;
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .chatbot-container.show {
            display: flex;
        }

        .chatbot-header {
            background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
        }

        .chatbot-header-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .chatbot-avatar {
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .chatbot-avatar i {
                font-size: 20px;
            }

        .chatbot-header-text h4 {
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .chatbot-header-text p {
            font-size: 11px;
            opacity: 0.8;
        }

        .chatbot-close {
            cursor: pointer;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: all 0.2s ease;
        }

            .chatbot-close:hover {
                background: rgba(255, 255, 255, 0.2);
            }

        .chatbot-messages {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            background: #F9FAFB;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

            /* Custom Scrollbar */
            .chatbot-messages::-webkit-scrollbar {
                width: 5px;
            }

            .chatbot-messages::-webkit-scrollbar-track {
                background: #E5E7EB;
                border-radius: 10px;
            }

            .chatbot-messages::-webkit-scrollbar-thumb {
                background: #94A3B8;
                border-radius: 10px;
            }

        .message {
            display: flex;
            animation: messageFadeIn 0.3s ease;
        }

        @@keyframes messageFadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .message.bot {
            justify-content: flex-start;
        }

        .message.user {
            justify-content: flex-end;
        }

        .message-content {
            max-width: 80%;
            padding: 10px 14px;
            border-radius: 18px;
            font-size: 13px;
            line-height: 1.5;
        }

        .message.bot .message-content {
            background: white;
            border: 1px solid #EAECF0;
            color: #1A1F36;
            border-bottom-left-radius: 4px;
        }

        .message.user .message-content {
            background: #2563EB;
            color: white;
            border-bottom-right-radius: 4px;
        }

        .message-time {
            font-size: 10px;
            color: #9CA3AF;
            margin-top: 4px;
            margin-left: 12px;
        }

        .message.user .message-time {
            text-align: right;
            margin-right: 12px;
        }

        .quick-replies {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 8px;
        }

        /* CHANGE 4: Updated quick-reply-btn with icon support */
        .quick-reply-btn {
            background: #F1F5F9;
            border: 1px solid #EAECF0;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11px;
            cursor: pointer;
            transition: all 0.2s ease;
            color: #1A1F36;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .quick-reply-btn:hover {
                background: #E2E8F0;
                border-color: #2563EB;
            }

            .quick-reply-btn i {
                font-size: 10px;
                color: #2563EB;
            }

        .chatbot-input-area {
            padding: 12px 16px;
            border-top: 1px solid #EAECF0;
            background: white;
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .chatbot-input {
            flex: 1;
            padding: 10px 14px;
            border: 1.5px solid #EAECF0;
            border-radius: 40px;
            font-family: inherit;
            font-size: 13px;
            outline: none;
            transition: all 0.2s ease;
        }

            .chatbot-input:focus {
                border-color: #2563EB;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
            }

        .chatbot-send {
            width: 38px;
            height: 38px;
            background: #2563EB;
            color: white;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .chatbot-send:hover {
                background: #1D4ED8;
                transform: scale(1.02);
            }

            .chatbot-send i {
                font-size: 14px;
            }

        .typing-indicator {
            display: flex;
            gap: 4px;
            padding: 10px 14px;
            background: white;
            border: 1px solid #EAECF0;
            border-radius: 18px;
            width: fit-content;
        }

            .typing-indicator span {
                width: 8px;
                height: 8px;
                background: #94A3B8;
                border-radius: 50%;
                animation: typing 1.4s infinite;
            }

                .typing-indicator span:nth-child(2) {
                    animation-delay: 0.2s;
                }

                .typing-indicator span:nth-child(3) {
                    animation-delay: 0.4s;
                }

        @@keyframes typing {
            0%, 60%, 100% {
                transform: translateY(0);
                opacity: 0.4;
            }

            30% {
                transform: translateY(-6px);
                opacity: 1;
            }
        }

        @@media (max-width: 480px) {
            .chatbot-container {
                width: 320px;
                height: 450px;
                right: -10px;
            }
        }
        /* Toast Animation */
        @@keyframes slideInRight {
            from {
                transform: translateX(100%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @@keyframes fadeOutRight {
            from {
                transform: translateX(0);
                opacity: 1;
            }

            to {
                transform: translateX(100%);
                opacity: 0;
            }
        }
        /* ==================== SOS MODAL PROFESSIONAL UI ==================== */
        .sos-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

            .sos-modal.show {
                display: flex;
            }

        .sos-modal-content {
            background: #FFFFFF;
            border-radius: 20px;
            width: 100%;
            max-width: 420px;
            overflow: hidden;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
            animation: modalPopIn 0.3s ease;
        }

        .sos-modal-header {
            background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%);
            padding: 24px 28px;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .sos-header-icon {
            width: 42px;
            height: 42px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .sos-header-icon i {
                font-size: 20px;
                color: #FFFFFF;
            }

        .sos-header-label {
            font-size: 16px;
            font-weight: 700;
            color: #FFFFFF;
            letter-spacing: 0.8px;
        }

        .sos-modal-body {
            padding: 24px 28px 8px 28px;
        }

        .sos-modal-title {
            font-size: 18px;
            font-weight: 700;
            color: #1A1F36;
            margin-bottom: 8px;
        }

        .sos-modal-subtitle {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.6;
            margin-bottom: 20px;
        }

            .sos-modal-subtitle strong {
                color: #DC2626;
            }

        .sos-feature-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 18px;
        }

        .sos-feature-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            background: #F8FAFC;
            border: 1px solid #EAECF0;
            border-radius: 10px;
            font-size: 13px;
            color: #374151;
            font-weight: 500;
        }

        .sos-feature-icon {
            width: 30px;
            height: 30px;
            background: #EFF6FF;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .sos-feature-icon i {
                font-size: 13px;
                color: #2563EB;
            }

        .sos-warning-note {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            background: #FEF2F2;
            border: 1px solid #FECACA;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 500;
            color: #DC2626;
            margin-bottom: 20px;
        }

            .sos-warning-note i {
                font-size: 13px;
                color: #DC2626;
                flex-shrink: 0;
            }

        .sos-modal-actions {
            padding: 0 28px 24px 28px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .sos-confirm {
            width: 100%;
            background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%);
            color: white;
            border: none;
            padding: 13px 24px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
            letter-spacing: 0.3px;
        }

            .sos-confirm:hover {
                background: linear-gradient(135deg, #B91C1C 0%, #991B1B 100%);
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(220, 38, 38, 0.35);
            }

        .sos-cancel {
            width: 100%;
            background: #F1F5F9;
            color: #64748B;
            border: 1px solid #E2E8F0;
            padding: 11px 24px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 500;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

            .sos-cancel:hover {
                background: #E2E8F0;
                color: #374151;
            }
    </style>
</head>
<body>
    <div class="dashboard">
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <i class="fas fa-city"></i>
                    <h2>SMART CIVIC <span>ALERT</span></h2>
                </div>
                <div class="hamburger" id="toggleSidebar">
                    <i class="fas fa-bars"></i>
                </div>
            </div>

            <div class="nav-menu">
                <div class="nav-item active" data-page="dashboard">
                    <i class="fas fa-chart-pie"></i> <span>Dashboard</span>
                </div>
                <div class="nav-item" data-page="myreports">
                    <i class="fas fa-file-alt"></i> <span>My Reports</span>
                </div>
                <div class="nav-item" data-page="statistics">
                    <i class="fas fa-chart-line"></i> <span>Statistics</span>
                </div>
                <div class="nav-item" data-page="notifications">
                    <i class="fas fa-bell"></i> <span>Notifications</span>
                </div>
                <div class="nav-item" data-page="reports">
                    <i class="fas fa-download"></i> <span>Reports (PDF)</span>
                </div>
                <div class="nav-item sos" id="sosButton">
                    <i class="fas fa-exclamation-triangle"></i> <span>SOS Emergency</span>
                </div>
                <div class="nav-item" data-page="safetytips">
                    <i class="fas fa-shield-alt"></i> <span>Safety Tips</span>
                </div>
            </div>

            <div class="nav-footer">
                <div class="footer-item" data-page="profile">
                    <i class="fas fa-user-circle"></i> <span>My Profile</span>
                </div>
                <a href="/Account/Logout" class="footer-item logout">
                    <i class="fas fa-sign-out-alt"></i> <span>Logout</span>
                </a>
            </div>
        </div>

        <div class="main-content">
            <!-- DASHBOARD VIEW -->
            <div id="dashboard-view">
                <div class="welcome-header">
                    <h1><i class="fas fa-hand-wave"></i> Welcome back, @ViewBag.UserName!</h1>
                    <p>Track your incidents, report issues, and stay updated.</p>
                </div>

                <div class="stats-grid">
                    <div class="stat-card total">
                        <div class="stat-header">
                            <span class="stat-label">Total Reports</span>
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="stat-value">@ViewBag.TotalIncidents</div>
                        <div class="stat-trend trend-up"><i class="fas fa-arrow-up"></i> from last month</div>
                    </div>
                    <div class="stat-card resolved">
                        <div class="stat-header">
                            <span class="stat-label">Resolved</span>
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="stat-value">@ViewBag.ResolvedIncidents</div>
                        <div class="stat-trend trend-up"><i class="fas fa-arrow-up"></i> from last month</div>
                    </div>
                    <div class="stat-card pending">
                        <div class="stat-header">
                            <span class="stat-label">Pending</span>
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="stat-value">@ViewBag.PendingIncidents</div>
                        <div class="stat-trend trend-down"><i class="fas fa-arrow-down"></i> from last month</div>
                    </div>
                    <div class="stat-card critical">
                        <div class="stat-header">
                            <span class="stat-label">Critical</span>
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="stat-value">@ViewBag.CriticalIncidents</div>
                        <div class="stat-trend trend-down"><i class="fas fa-arrow-down"></i> from last month</div>
                    </div>
                </div>

                <div class="row-2cols">
                    <div class="chart-card">
                        <div class="card-title">
                            <h3><i class="fas fa-chart-bar"></i> Incident Trends (Last 7 Days)</h3>
                            <div class="action-link" data-page="myreports">View Details →</div>
                        </div>
                        <canvas id="incidentChart"></canvas>
                    </div>
                    <div class="quick-action-card">
                        <h3><i class="fas fa-clipboard-list"></i> Report an incident?</h3>
                        <p>Your report will be routed to the right department instantly.</p>
                        <div class="btn-report" data-page="newincident">
                            <i class="fas fa-plus-circle"></i> New Incident
                        </div>
                    </div>
                </div>

                @if (ViewBag.CriticalIncidents > 0)
                {
                    <div class="critical-alert">
                        <div>
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>@ViewBag.CriticalIncidents critical incidents</strong> require immediate attention!
                        </div>
                        <div class="action-link" data-page="myreports">View Details →</div>
                    </div>
                }

                <div class="recent-card">
                    <div class="card-title">
                        <h3><i class="fas fa-history"></i> Recent Incidents</h3>
                        <div class="action-link" data-page="myreports">View All →</div>
                    </div>
                    <div class="table-responsive">
                        <table class="incident-table">
                            <thead>
                                <tr><th>ID</th><th>Title</th><th>Location</th><th>Severity</th><th>Status</th><th>Date</th><th>Action</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var incident in ViewBag.MyIncidents)
                                {
                                    <tr>
                                        <td>#@(incident.Id?.Length >= 6 ? incident.Id.Substring(0, 6) : incident.Id)</td>
                                        <td>@(incident.Title?.Length > 25 ? incident.Title.Substring(0, 22) + "..." : incident.Title)</td>
                                        <td>@(incident.Location?.Length > 20 ? incident.Location.Substring(0, 17) + "..." : incident.Location)</td>
                                        <td class="severity-@(incident.Severity?.ToLower())">@incident.Severity</td>
                                        <td><span class="status-badge status-@(incident.Status?.ToLower())">@incident.Status</span></td>
                                        <td>@incident.ReportedAt.ToString("MMM dd")</td>
                                        <td><div class="action-link" data-page="details" data-id="@incident.Id"><i class="fas fa-eye"></i> Track</div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- DYNAMIC CONTENT AREA -->
            <div id="dynamic-content" style="display: none;"></div>
        </div>
    </div>

    <!-- ==================== CHATBOT WIDGET ==================== -->
    <div class="chatbot-widget">
        <div class="chatbot-container" id="chatbotContainer">
            <div class="chatbot-header">
                <div class="chatbot-header-info">
                    <div class="chatbot-avatar">
                        <i class="fas fa-robot"></i>
                    </div>
                    <div class="chatbot-header-text">
                        <h4>City Assistant</h4>
                        <p>Online • Ready to help</p>
                    </div>
                </div>
                <div class="chatbot-close" onclick="toggleChatbot()">
                    <i class="fas fa-times"></i>
                </div>
            </div>
            <div class="chatbot-messages" id="chatMessages">
                <div class="message bot">
                    <div class="message-content">
                        <i class="fas fa-hand-wave" style="margin-right: 6px;"></i> Hello! I'm your City Assistant.<br>
                        How can I help you today?
                        <!-- CHANGE 1: Quick reply buttons now use Font Awesome icons instead of emojis -->
                        <div class="quick-replies" id="quickReplies">
                            <button class="quick-reply-btn" onclick="sendQuickReply('How to report an incident?')"><i class="fas fa-file-alt"></i> Report Incident</button>
                            <button class="quick-reply-btn" onclick="sendQuickReply('What is SOS Emergency?')"><i class="fas fa-exclamation-triangle"></i> SOS Emergency</button>
                            <button class="quick-reply-btn" onclick="sendQuickReply('Emergency numbers')"><i class="fas fa-phone-alt"></i> Emergency Numbers</button>
                            <button class="quick-reply-btn" onclick="sendQuickReply('Safety tips')"><i class="fas fa-shield-alt"></i> Safety Tips</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="chatbot-input-area">
                <input type="text" id="chatInput" class="chatbot-input" placeholder="Ask me anything..." onkeypress="handleChatKeyPress(event)">
                <button class="chatbot-send" onclick="sendChatMessage()">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
        <div class="chatbot-toggle" onclick="toggleChatbot()">
            <i class="fas fa-comment-dots"></i>
        </div>
    </div>

    <!-- SOS Modal - Professional UI -->
    <div id="sosModal" class="sos-modal">
        <div class="sos-modal-content">

            <!-- Header band -->
            <div class="sos-modal-header">
                <div class="sos-header-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <span class="sos-header-label">EMERGENCY ALERT</span>
            </div>

            <!-- Body -->
            <div class="sos-modal-body">
                <h3 class="sos-modal-title">Send SOS Alert?</h3>
                <p class="sos-modal-subtitle">
                    This will immediately notify all emergency departments and create a
                    <strong>Critical</strong> priority incident on your behalf.
                </p>

                <!-- Feature list -->
                <div class="sos-feature-list">
                    <div class="sos-feature-item">
                        <div class="sos-feature-icon">
                            <i class="fas fa-bell"></i>
                        </div>
                        <span>Notifies emergency services instantly</span>
                    </div>
                    <div class="sos-feature-item">
                        <div class="sos-feature-icon">
                            <i class="fas fa-flag"></i>
                        </div>
                        <span>Creates a Critical priority incident</span>
                    </div>
                    <div class="sos-feature-item">
                        <div class="sos-feature-icon">
                            <i class="fas fa-broadcast-tower"></i>
                        </div>
                        <span>Alerts all departments in real-time</span>
                    </div>
                    <div class="sos-feature-item">
                        <div class="sos-feature-icon">
                            <i class="fas fa-bolt"></i>
                        </div>
                        <span>Flags your report for immediate action</span>
                    </div>
                </div>

                <!-- Warning note -->
                <div class="sos-warning-note">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>Only use this in genuine emergencies</span>
                </div>
            </div>

            <!-- Actions -->
            <div class="sos-modal-actions">
                <button class="sos-confirm" id="confirmSos">
                    <i class="fas fa-paper-plane"></i>
                    Send SOS Alert
                </button>
                <button class="sos-cancel" id="cancelSos">
                    Cancel
                </button>
            </div>

        </div>
    </div>

    <script>
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggleSidebar');
        toggleBtn.addEventListener('click', () => { sidebar.classList.toggle('collapsed'); });

        const ctx = document.getElementById('incidentChart').getContext('2d');
        const weeklyData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.WeeklyData));
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['6d', '5d', '4d', '3d', '2d', 'Yes', 'Today'],
                datasets: [{ label: 'Incidents Reported', data: weeklyData, backgroundColor: '#2563EB', borderRadius: 6, barPercentage: 0.6 }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: { legend: { position: 'top', labels: { boxWidth: 10, font: { size: 10 } } } },
                scales: { y: { beginAtZero: true, grid: { color: '#EAECF0' }, ticks: { stepSize: 1 } }, x: { grid: { display: false } } }
            }
        });

                       // Function to load content dynamically - FIXED for Statistics
        function loadContent(viewName, incidentId = null) {
            const dashboardView = document.getElementById('dashboard-view');
            const dynamicContent = document.getElementById('dynamic-content');

            // Update active state in sidebar
            document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));
            const correspondingNav = document.querySelector(`.nav-item[data-page="${viewName}"]`);
            if (correspondingNav) correspondingNav.classList.add('active');

            if (viewName === 'dashboard') {
                dashboardView.style.display = 'block';
                dynamicContent.style.display = 'none';
                dynamicContent.innerHTML = '';
                return;
            }

            dashboardView.style.display = 'none';
            dynamicContent.style.display = 'block';

            // Show loading
            dynamicContent.innerHTML = `
                <div class="dynamic-content">
                    <div class="loading-spinner">
                        <i class="fas fa-spinner fa-spin"></i><br />
                        Loading...
                    </div>
                </div>
            `;

            let url = '';
            if (viewName === 'details' && incidentId) {
                url = `/Citizen/Details/${incidentId}`;
            } else if (viewName === 'myreports') {
                url = `/Citizen/MyReports`;
            } else if (viewName === 'newincident') {
                url = `/Incident/Create`;
            } else if (viewName === 'statistics') {
                url = `/Citizen/Statistics`;
            } else if (viewName === 'notifications') {
                url = `/Citizen/Notifications`;
            } else if (viewName === 'reports') {
                url = `/Citizen/Reports`;
            } else if (viewName === 'safetytips') {
                url = `/Citizen/SafetyTips`;
            } else if (viewName === 'profile') {
                url = `/Citizen/Profile`;
            } else {
                url = `/Citizen/${viewName}`;
            }

            console.log('Loading URL:', url);

            fetch(url)
                .then(response => {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.text();
                })
                .then(html => {
                    dynamicContent.innerHTML = `<div class="dynamic-content">${html}</div>`;

                    // IMPORTANT: Execute all scripts in the loaded content
                    const scripts = dynamicContent.querySelectorAll('script');
                    scripts.forEach(oldScript => {
                        const newScript = document.createElement('script');
                        if (oldScript.src) {
                            newScript.src = oldScript.src;
                        } else {
                            newScript.textContent = oldScript.textContent;
                        }
                        document.body.appendChild(newScript);
                        oldScript.remove();
                    });

                    // Special handling for Statistics page charts
                    if (viewName === 'statistics') {
                        setTimeout(function() {
                            // Force charts to initialize if they haven't
                            if (typeof Chart !== 'undefined') {
                                console.log('Chart.js is loaded, charts should appear');
                            } else {
                                console.log('Waiting for Chart.js...');
                            }
                        }, 200);
                    }
                })
                .catch(error => {
                    console.error('Error loading content:', error);
                    dynamicContent.innerHTML = `
                        <div class="dynamic-content">
                            <div class="loading-spinner" style="color: #DC2626;">
                                <i class="fas fa-exclamation-circle"></i><br />
                                Error loading content. Please try again.
                            </div>
                        </div>
                    `;
                });
        }

        // Global function for child pages to call
        window.loadViewFromChild = function(viewName, incidentId) {
            loadContent(viewName, incidentId);
        };

        // Handle clicks on elements with data-page attribute
        document.querySelectorAll('[data-page]').forEach(element => {
            element.addEventListener('click', function(e) {
                e.preventDefault();
                const page = this.getAttribute('data-page');
                const id = this.getAttribute('data-id');
                loadContent(page, id);
            });
        });

        function toggleChatbot() { document.getElementById('chatbotContainer').classList.toggle('show'); }
        function handleChatKeyPress(e) { if (e.key === 'Enter') sendChatMessage(); }
        function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const msg = input.value.trim();
            if (!msg) return;
            const container = document.getElementById('chatMessages');
            container.innerHTML += `<div class="message user"><div class="message-content">${escapeHtml(msg)}</div></div>`;
            input.value = '';
            container.scrollTop = container.scrollHeight;
            setTimeout(() => {
                container.innerHTML += `<div class="message bot"><div class="message-content">Thank you! Our team will respond soon.</div></div>`;
                container.scrollTop = container.scrollHeight;
            }, 500);
        }
        function escapeHtml(t) { const d = document.createElement('div'); d.textContent = t; return d.innerHTML; }

        const sosModal = document.getElementById('sosModal');
        document.getElementById('sosButton').addEventListener('click', e => { e.preventDefault(); sosModal.classList.add('show'); });
        document.getElementById('cancelSos').addEventListener('click', () => sosModal.classList.remove('show'));
        document.getElementById('confirmSos').addEventListener('click', () => window.location.href = '/Citizen/CreateEmergency');
        window.addEventListener('click', e => { if (e.target === sosModal) sosModal.classList.remove('show'); });

                // ==================== CHATBOT FUNCTIONALITY ====================

        // Toggle chatbot visibility
        function toggleChatbot() {
            const container = document.getElementById('chatbotContainer');
            container.classList.toggle('show');
            if (container.classList.contains('show')) {
                const input = document.getElementById('chatInput');
                setTimeout(() => input.focus(), 300);
            }
        }

        // Handle Enter key press
        function handleChatKeyPress(event) {
            if (event.key === 'Enter') {
                sendChatMessage();
            }
        }

        // Send quick reply
        function sendQuickReply(message) {
            const input = document.getElementById('chatInput');
            input.value = message;
            sendChatMessage();
        }

        // Send chat message
        function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const message = input.value.trim();

            if (!message) return;

            // Add user message to chat
            addMessage(message, 'user');
            input.value = '';

            // Show typing indicator
            showTypingIndicator();

            // Generate bot response after delay (simulates thinking)
            setTimeout(() => {
                hideTypingIndicator();
                const response = getBotResponse(message);
                addMessage(response, 'bot');

                // Add quick replies for certain messages
                if (message.toLowerCase().includes('help') || message.toLowerCase().includes('what can you do')) {
                    addQuickRepliesAfterResponse();
                }

                // Scroll to bottom
                scrollToBottom();
            }, 500);
        }

        // Add message to chat
        function addMessage(text, sender) {
            const messagesContainer = document.getElementById('chatMessages');
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${sender}`;

            const now = new Date();
            const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            messageDiv.innerHTML = `
                <div class="message-content">${escapeChatHtml(text)}</div>
                <div class="message-time">${timeStr}</div>
            `;

            messagesContainer.appendChild(messageDiv);
            scrollToBottom();
        }

        // Show typing indicator
        function showTypingIndicator() {
            const messagesContainer = document.getElementById('chatMessages');
            const typingDiv = document.createElement('div');
            typingDiv.className = 'message bot';
            typingDiv.id = 'typingIndicator';
            typingDiv.innerHTML = `
                <div class="typing-indicator">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            `;
            messagesContainer.appendChild(typingDiv);
            scrollToBottom();
        }

        // Hide typing indicator
        function hideTypingIndicator() {
            const typingIndicator = document.getElementById('typingIndicator');
            if (typingIndicator) {
                typingIndicator.remove();
            }
        }

        // Scroll to bottom of chat
        function scrollToBottom() {
            const messagesContainer = document.getElementById('chatMessages');
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        // Escape HTML to prevent XSS
        function escapeChatHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // CHANGE 1 (continued): addQuickRepliesAfterResponse uses Font Awesome icons
        function addQuickRepliesAfterResponse() {
            const messagesContainer = document.getElementById('chatMessages');
            const quickRepliesDiv = document.createElement('div');
            quickRepliesDiv.className = 'message bot';
            quickRepliesDiv.innerHTML = `
                <div class="message-content">
                    <div class="quick-replies">
                        <button class="quick-reply-btn" onclick="sendQuickReply('How to report an incident?')"><i class="fas fa-file-alt"></i> Report Incident</button>
                        <button class="quick-reply-btn" onclick="sendQuickReply('What is SOS Emergency?')"><i class="fas fa-exclamation-triangle"></i> SOS Emergency</button>
                        <button class="quick-reply-btn" onclick="sendQuickReply('Emergency numbers')"><i class="fas fa-phone-alt"></i> Emergency Numbers</button>
                        <button class="quick-reply-btn" onclick="sendQuickReply('Safety tips')"><i class="fas fa-shield-alt"></i> Safety Tips</button>
                        <button class="quick-reply-btn" onclick="sendQuickReply('My Reports')"><i class="fas fa-file-alt"></i> My Reports</button>
                        <button class="quick-reply-btn" onclick="sendQuickReply('Download Reports')"><i class="fas fa-download"></i> Download Reports</button>
                    </div>
                </div>
            `;
            messagesContainer.appendChild(quickRepliesDiv);
            scrollToBottom();
        }

        // CHANGE 2: getBotResponse — all emojis removed, professional clean text responses
        function getBotResponse(message) {
            const msg = message.toLowerCase().trim();

            // Greetings
            if (msg.match(/^(hello|hi|hey|greetings|good morning|good afternoon|good evening)$/)) {
                return "Hello! I am your City Assistant. How can I help you today?";
            }

            // How are you
            if (msg.includes('how are you')) {
                return "I am doing great, thank you for asking! Ready to assist you with any questions about incident reporting or emergency procedures.";
            }

            // Thank you
            if (msg.includes('thank') || msg.includes('thanks')) {
                return "You are welcome! Stay safe and feel free to ask if you need any more help.";
            }

            // Report incident
            if (msg.includes('report') && (msg.includes('incident') || msg.includes('how'))) {
                return "How to Report an Incident:\n\n" +
                       "1. Go to your Dashboard\n" +
                       "2. Click on 'Report New Incident' button\n" +
                       "3. Fill in the Title, Description, and Location\n" +
                       "4. Select Severity (Critical / High / Medium / Low)\n" +
                       "5. Click 'Submit Incident'\n\n" +
                       "Your report will be instantly sent to the appropriate department.";
            }

            // SOS / Emergency
            if (msg.includes('sos') || (msg.includes('emergency') && !msg.includes('numbers'))) {
                return "SOS Emergency Feature:\n\n" +
                       "• One-click emergency alert for life-threatening situations\n" +
                       "• Creates a CRITICAL priority incident automatically\n" +
                       "• Notifies all emergency departments immediately\n" +
                       "• Use only for genuine emergencies\n\n" +
                       "To use: Click 'SOS Emergency' in the sidebar, confirm the dialog, and your alert will be sent.";
            }

            // Emergency numbers
            if (msg.includes('emergency numbers') || msg.includes('helpline') || msg.includes('contact')) {
                return "Emergency Helplines:\n\n" +
                       "• Rescue: 1122\n" +
                       "• Police: 15\n" +
                       "• Fire Brigade: 16\n" +
                       "• Ambulance: 115\n\n" +
                       "Please save these numbers for use in emergencies.";
            }

            // Safety tips
            if (msg.includes('safety') || msg.includes('tip')) {
                return "Safety Tips:\n\n" +
                       "• Always share your exact location when reporting an incident\n" +
                       "• Take photos or videos of the incident as evidence\n" +
                       "• Keep your CNIC ready for identity verification\n" +
                       "• Learn basic first aid procedures\n" +
                       "• Stay calm and provide accurate, detailed information\n\n" +
                       "For more tips, click 'Safety Tips' in the sidebar.";
            }

            // My Reports
            if (msg.includes('my reports') || (msg.includes('view') && msg.includes('report'))) {
                return "My Reports Feature:\n\n" +
                       "• Click 'My Reports' in the sidebar to view all your submitted incidents\n" +
                       "• Track the status of each report: Open, In Progress, or Resolved\n" +
                       "• Click 'View Details' to see complete information for any incident\n" +
                       "• Download reports as PDF or CSV from the Reports page";
            }

            // Download reports
            if (msg.includes('download') && (msg.includes('report') || msg.includes('pdf') || msg.includes('csv'))) {
                return "Download Reports:\n\n" +
                       "1. Click 'Reports (PDF)' in the sidebar\n" +
                       "2. Select incidents using the checkboxes\n" +
                       "3. Click 'Download Selected as PDF' or 'Download Selected as CSV'\n" +
                       "4. Your file will be downloaded automatically";
            }

            // Statistics
            if (msg.includes('statistics') || msg.includes('chart') || msg.includes('graph')) {
                return "Statistics Page:\n\n" +
                       "• View incident trends over the last 7 days\n" +
                       "• See severity distribution: Critical, High, Medium, and Low\n" +
                       "• Track status distribution: Open, In Progress, and Resolved\n\n" +
                       "Click 'Statistics' in the sidebar to view your analytics.";
            }

            // Notifications
            if (msg.includes('notification')) {
                return "Notifications:\n\n" +
                       "• Receive real-time updates whenever an incident status changes\n" +
                       "• Click 'Notifications' in the sidebar to view all updates\n" +
                       "• Each notification displays the incident title and the status change\n\n" +
                       "You will be notified when your incident moves to 'In Progress' or 'Resolved'.";
            }

            // Profile
            if (msg.includes('profile') || msg.includes('update profile')) {
                return "Profile Management:\n\n" +
                       "• Click 'My Profile' in the sidebar\n" +
                       "• Update your name and phone number\n" +
                       "• Your changes will be saved immediately";
            }

            // What can you do / Help
            if (msg.includes('help') || msg.includes('what can you do') || msg.includes('capabilities')) {
                return "I can help you with:\n\n" +
                       "• How to report an incident\n" +
                       "• SOS Emergency feature explanation\n" +
                       "• Emergency helpline numbers\n" +
                       "• Safety tips and guidelines\n" +
                       "• Viewing and tracking your reports\n" +
                       "• Downloading reports as PDF or CSV\n" +
                       "• Understanding statistics and charts\n" +
                       "• Notification system overview\n\n" +
                       "What would you like to know?";
            }

            // About the system
            if (msg.includes('what is') && (msg.includes('smart civic') || msg.includes('this system'))) {
                return "Smart Civic Alert System:\n\n" +
                       "An AI-powered city operations dashboard for smart city management. " +
                       "Citizens can report incidents, send SOS alerts, track report status, " +
                       "and download reports — all in one place.";
            }

            // Default response for unknown queries
            return "I am not sure about that. Here is what I can help with:\n\n" +
                   "• Report an incident\n" +
                   "• SOS Emergency\n" +
                   "• Emergency numbers\n" +
                   "• Safety tips\n" +
                   "• My Reports\n" +
                   "• Download reports\n" +
                   "• Statistics\n" +
                   "• Notifications\n\n" +
                   "Type 'help' to see all available options.";
        }

                // ==================== TOAST NOTIFICATION FOR SOS ====================
        function showToast(message, type = 'success') {
            // Remove existing toast if any
            const existingToast = document.querySelector('.sos-toast-notification');
            if (existingToast) existingToast.remove();

            // Create toast element
            const toast = document.createElement('div');
            toast.className = `sos-toast-notification ${type}`;

            let icon = 'fa-check-circle';
            let bgColor = '#10B981';

            if (type === 'error') {
                icon = 'fa-exclamation-triangle';
                bgColor = '#EF4444';
            } else if (type === 'warning') {
                icon = 'fa-exclamation-circle';
                bgColor = '#F59E0B';
            } else {
                icon = 'fa-check-circle';
                bgColor = '#10B981';
            }

            toast.style.cssText = `
                position: fixed;
                top: 25px;
                right: 25px;
                background: ${bgColor};
                color: white;
                padding: 14px 24px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 14px;
                font-weight: 500;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
                z-index: 9999;
                animation: slideInRight 0.3s ease forwards;
                font-family: 'Inter', sans-serif;
            `;

            toast.innerHTML = `<i class="fas ${icon}" style="font-size: 18px;"></i> ${message}`;
            document.body.appendChild(toast);

            // Remove toast after 3 seconds
            setTimeout(() => {
                toast.style.animation = 'fadeOutRight 0.3s ease forwards';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Check for SOS success message on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Check if SOS was just sent
            @if (TempData["SOSSuccess"] != null && TempData["SOSSuccess"].ToString() == "true")
            {
                        <text>
                        showToast('@TempData["SOSMessage"]', 'success');
                        </text>
            }
        });
    </script>
    @await Html.PartialAsync("_SignalRClient")
</body>
</html>
