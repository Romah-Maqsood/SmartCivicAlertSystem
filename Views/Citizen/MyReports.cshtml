@model IEnumerable<SmartCityPulse.Models.Incident>

@{
    Layout = null;
    ViewData["Title"] = "My Reports";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Reports - Smart Civic Alert</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: transparent;
            color: #1A1F36;
        }

        .reports-wrapper {
            width: 100%;
        }

        .header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .page-header {
            flex: 1;
        }

            .page-header h1 {
                font-size: 22px;
                font-weight: 700;
                color: #1A1F36;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .page-header h1 i {
                    color: #2563EB;
                    font-size: 24px;
                }

            .page-header p {
                font-size: 13px;
                color: #6B7280;
                margin-top: 6px;
            }

        .btn-new-incident {
            background: #2563EB;
            color: white;
            padding: 10px 20px;
            border-radius: 40px;
            font-size: 13px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            white-space: nowrap;
        }

            .btn-new-incident:hover {
                background: #1D4ED8;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
            }

        .table-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        }

        .table-responsive {
            overflow-x: auto;
        }

        .incident-table {
            width: 100%;
            border-collapse: collapse;
        }

            .incident-table th {
                text-align: left;
                padding: 14px 12px;
                color: #6B7280;
                font-size: 11px;
                font-weight: 600;
                border-bottom: 1px solid #EAECF0;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .incident-table td {
                padding: 14px 12px;
                font-size: 13px;
                color: #1A1F36;
                border-bottom: 1px solid #F0F2F5;
            }

            .incident-table tr:hover {
                background: #F9FAFB;
            }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 600;
            text-transform: capitalize;
        }

        .status-open {
            background: #DBEAFE;
            color: #1E40AF;
        }

        .status-in-progress {
            background: #FEF3C7;
            color: #92400E;
        }

        .status-resolved {
            background: #DCFCE7;
            color: #166534;
        }

        .severity-critical {
            background: #FEF2F2;
            color: #DC2626;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 4px 12px 12px 4px;
            border-left: 3px solid #DC2626;
            display: inline-block;
            font-size: 12px;
        }

        .severity-high {
            background: #FFF7ED;
            color: #EA580C;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 4px 12px 12px 4px;
            border-left: 3px solid #EA580C;
            display: inline-block;
            font-size: 12px;
        }

        .severity-medium {
            background: #FFFBEB;
            color: #D97706;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 4px 12px 12px 4px;
            border-left: 3px solid #D97706;
            display: inline-block;
            font-size: 12px;
        }

        .severity-low {
            background: #ECFDF5;
            color: #059669;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 4px 12px 12px 4px;
            border-left: 3px solid #059669;
            display: inline-block;
            font-size: 12px;
        }

        .action-link {
            color: #2563EB;
            text-decoration: none;
            font-size: 12px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: all 0.2s ease;
            cursor: pointer;
            background: none;
            border: none;
        }

            .action-link:hover {
                color: #1D4ED8;
                text-decoration: underline;
            }

        .no-data {
            text-align: center;
            padding: 60px 20px;
            color: #6B7280;
        }

            .no-data i {
                font-size: 48px;
                color: #94A3B8;
                margin-bottom: 16px;
                display: inline-block;
            }

        @@media (max-width: 768px) {
            .header-row {
                flex-direction: column;
                align-items: flex-start;
            }

            .btn-new-incident {
                white-space: normal;
            }

            .table-card {
                padding: 12px;
            }

            .incident-table th,
            .incident-table td {
                padding: 10px 8px;
                font-size: 11px;
            }
        }
    </style>
</head>
<body>
    <div class="reports-wrapper">
        <div class="header-row">
            <div class="page-header">
                <h1>
                    <i class="fas fa-clipboard-list"></i>
                    My Incident Reports
                </h1>
                <p>View and track all incidents you have reported</p>
            </div>
            <button class="btn-new-incident" onclick="window.parent.loadViewFromChild('newincident', null)">
                <i class="fas fa-plus-circle"></i> Report New Incident
            </button>
        </div>

        <div class="table-card">
            <div class="table-responsive">
                @if (Model != null && Model.Any())
                {
                    <table class="incident-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Location</th>
                                <th>Severity</th>
                                <th>Status</th>
                                <th>Reported On</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var incident in Model)
                            {
                                <tr>
                                    <td>
                                        #@(incident.Id?.Length >= 6 ? incident.Id.Substring(0, 6) : incident.Id)
                                    </td>
                                    <td>
                                        @(incident.Title?.Length > 35 ? incident.Title.Substring(0, 32) + "..." : incident.Title)
                                    </td>
                                    <td>
                                        @(incident.Location?.Length > 25 ? incident.Location.Substring(0, 22) + "..." : incident.Location)
                                    </td>
                                    <td>
                                        <span class="severity-@(incident.Severity?.ToLower())">
                                            <i class="fas
                                                        @(incident.Severity?.ToLower() == "critical" ? "fa-exclamation-triangle" :
                                                                                                 incident.Severity?.ToLower() == "high" ? "fa-arrow-up" :
                                                                                                 incident.Severity?.ToLower() == "medium" ? "fa-minus" : "fa-arrow-down")">
                                                                                                                                                                      </i>
                                                                                                                                                                      @incident.Severity
                                                                                                                                                                  </span>
                                                                                                                                                              </td>
                                                                                                                                                              <td>
                                                                                                                                                                  <span class="status-badge status-@(incident.Status?.ToLower().Replace(" ", ""))">
                                                                                                                                                                      <i class="fas
                                                        @(incident.Status?.ToLower() == "open" ? "fa-circle" :
                                                                                                 incident.Status?.ToLower() == "in progress" ? "fa-spinner fa-pulse" :
                                                                                                 incident.Status?.ToLower() == "resolved" ? "fa-check-circle" : "fa-clock")">
                                    </i>
                                    @incident.Status
                                </span>
                            </td>
                            <td>
                                @incident.ReportedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td>
                                <button class="action-link" onclick="window.parent.loadViewFromChild('details', '@incident.Id')">
                                    <i class="fas fa-eye"></i> View Details
                                </button>
                            </td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="no-data">
                        <i class="fas fa-folder-open"></i>
                        <h3>No reports found</h3>
                        <p>You haven't reported any incidents yet.</p>
                        <button class="btn-new-incident" onclick="window.parent.loadViewFromChild('newincident', null)" style="display: inline-flex;">
                            <i class="fas fa-plus-circle"></i> Report Your First Incident
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>