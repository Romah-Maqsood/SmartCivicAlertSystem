@model SmartCityPulse.Models.Incident

@{
    Layout = null;
    ViewData["Title"] = "Incident Details";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 2rem;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .card {
            background-color: white;
            border-radius: 24px;
            box-shadow: 0 20px 35px -10px rgba(0,0,0,0.2);
            overflow: hidden;
        }

        .card-header {
            background: linear-gradient(135deg, #3B82F6, #8B5CF6);
            padding: 1.5rem;
            color: white;
        }

            .card-header h1 {
                font-size: 1.5rem;
                margin-bottom: 0.5rem;
            }

            .card-header p {
                opacity: 0.9;
                font-size: 0.875rem;
            }

        .card-body {
            padding: 2rem;
        }

        .detail-row {
            display: flex;
            margin-bottom: 1.25rem;
            border-bottom: 1px solid #E2E8F0;
            padding-bottom: 0.75rem;
        }

        .detail-label {
            width: 140px;
            font-weight: 600;
            color: #64748B;
        }

        .detail-value {
            flex: 1;
            color: #1E293B;
        }

        .status-badge {
            display: inline-block;
            padding: 0.25rem 1rem;
            border-radius: 50px;
            font-weight: 500;
        }

        .status-resolved {
            background-color: #DCFCE7;
            color: #166534;
        }

        .status-progress {
            background-color: #FEF3C7;
            color: #92400E;
        }

        .status-open {
            background-color: #DBEAFE;
            color: #1E40AF;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background-color: #3B82F6;
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 500;
            margin-top: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <div class="card-header">
                <h1><i class="fas fa-info-circle"></i> Incident Details</h1>
                <p>Complete information about your reported incident</p>
            </div>
            <div class="card-body">
                <div class="detail-row">
                    <div class="detail-label">Incident ID</div>
                    <div class="detail-value">#@Model.Id</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Title</div>
                    <div class="detail-value">@Model.Title</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Description</div>
                    <div class="detail-value">@Model.Description</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Location</div>
                    <div class="detail-value">@Model.Location</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Severity</div>
                    <div class="detail-value severity-@Model.Severity?.ToLower()">@Model.Severity</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Status</div>
                    <div class="detail-value"><span class="status-badge status-@Model.Status?.ToLower()">@Model.Status</span></div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Reported On</div>
                    <div class="detail-value">@Model.ReportedAt.ToString("MMMM dd, yyyy - hh:mm tt")</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Last Updated</div>
                    <div class="detail-value">@Model.UpdatedAt.ToString("MMMM dd, yyyy - hh:mm tt")</div>
                </div>
            </div>
        </div>
        <a href="/Citizen/Index" class="btn-back"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
    </div>
</body>
</html>