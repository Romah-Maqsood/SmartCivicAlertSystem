@{
    Layout = null;
    ViewData["Title"] = "Safety Tips";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #E8EDF5;
            color: #1A1F36;
        }

        /* NO NAVBAR - NO BACK BUTTON */
        .tips-container {
            padding: 1.5rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .tips-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
        }

        .tip-card {
            background: #FFFFFF;
            border-radius: 20px;
            padding: 1.5rem;
            border: 1px solid #EAECF0;
            transition: all 0.3s ease;
            display: flex;
            gap: 1rem;
        }

            .tip-card:hover {
                transform: translateY(-2px);
                border-color: #2563EB;
            }

        .tip-icon {
            width: 55px;
            height: 55px;
            background: linear-gradient(135deg, #EFF6FF 0%, #FFFFFF 100%);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .tip-icon i {
                font-size: 1.75rem;
                color: #2563EB;
            }

        .tip-content {
            flex: 1;
        }

            .tip-content h3 {
                font-size: 1.125rem;
                font-weight: 600;
                margin-bottom: 0.5rem;
            }

            .tip-content p {
                font-size: 0.875rem;
                color: #6B7280;
                line-height: 1.5;
            }

        .emergency-section {
            margin-top: 2rem;
            background: linear-gradient(135deg, #2563EB 0%, #8B5CF6 100%);
            border-radius: 20px;
            padding: 1.5rem;
            color: white;
            text-align: center;
        }

        .emergency-contacts {
            display: flex;
            justify-content: center;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .emergency-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(255,255,255,0.15);
            padding: 0.5rem 1rem;
            border-radius: 40px;
        }

            .emergency-item span {
                font-weight: 600;
            }

        @@media (max-width: 768px) {
            .tips-grid {
                grid-template-columns: 1fr;
            }

            .tips-container {
                padding: 1rem;
            }

            .emergency-contacts {
                flex-direction: column;
                align-items: center;
                gap: 0.75rem;
            }
        }
    </style>
</head>
<body>
    <div class="tips-container">
        <div class="tips-grid">
            <div class="tip-card">
                <div class="tip-icon"><i class="fas fa-phone-alt"></i></div>
                <div class="tip-content"><h3>Emergency Helplines</h3><p>Rescue 1122 | Police 15 | Fire 16 | Ambulance 115</p></div>
            </div>
            <div class="tip-card">
                <div class="tip-icon"><i class="fas fa-location-dot"></i></div>
                <div class="tip-content"><h3>Share Your Location</h3><p>Always share exact location when reporting for faster response.</p></div>
            </div>
            <div class="tip-card">
                <div class="tip-icon"><i class="fas fa-camera"></i></div>
                <div class="tip-content"><h3>Take Photos & Videos</h3><p>Clear visual evidence helps authorities assess quickly.</p></div>
            </div>
            <div class="tip-card">
                <div class="tip-icon"><i class="fas fa-clock"></i></div>
                <div class="tip-content"><h3>Report Immediately</h3><p>Don't wait. The sooner you report, the faster help arrives.</p></div>
            </div>
            <div class="tip-card">
                <div class="tip-icon"><i class="fas fa-id-card"></i></div>
                <div class="tip-content"><h3>Keep ID Ready</h3><p>Have CNIC ready when reporting for verification.</p></div>
            </div>
            <div class="tip-card">
                <div class="tip-icon"><i class="fas fa-heartbeat"></i></div>
                <div class="tip-content"><h3>Stay Calm</h3><p>Staying calm helps provide accurate information to responders.</p></div>
            </div>
            <div class="tip-card">
                <div class="tip-icon"><i class="fas fa-map"></i></div>
                <div class="tip-content"><h3>Know Your Area</h3><p>Be familiar with landmarks and nearby emergency services.</p></div>
            </div>
            <div class="tip-card">
                <div class="tip-icon"><i class="fas fa-medkit"></i></div>
                <div class="tip-content"><h3>Basic First Aid</h3><p>Learning first aid can save lives while waiting for help.</p></div>
            </div>
        </div>
        <div class="emergency-section">
            <h3><i class="fas fa-exclamation-triangle"></i> Emergency Contacts</h3>
            <div class="emergency-contacts">
                <div class="emergency-item"><i class="fas fa-truck-medical"></i><span>Rescue 1122</span></div>
                <div class="emergency-item"><i class="fas fa-shield-haltered"></i><span>Police 15</span></div>
                <div class="emergency-item"><i class="fas fa-fire-extinguisher"></i><span>Fire 16</span></div>
                <div class="emergency-item"><i class="fas fa-ambulance"></i><span>Ambulance 115</span></div>
            </div>
        </div>
    </div>
</body>
</html>