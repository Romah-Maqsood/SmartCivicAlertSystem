@{
    Layout = null;
    ViewData["Title"] = "Safety Tips";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #E8EDF5;
            color: #1A1F36;
        }

        .navbar {
            background: #FFFFFF;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #EAECF0;
        }

        .navbar-brand {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1A1F36;
            text-decoration: none;
        }

            .navbar-brand span {
                color: #2563EB;
            }

        .container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 0 2rem;
        }

        .top-bar {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 1rem 1.5rem;
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid #EAECF0;
        }

        .page-title h1 {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .btn-back {
            background: #2563EB;
            color: white;
            padding: 0.5rem 1.25rem;
            border-radius: 40px;
            text-decoration: none;
            font-size: 0.875rem;
        }

        .tips-card {
            background: #FFFFFF;
            border-radius: 20px;
            padding: 2rem;
            border: 1px solid #EAECF0;
        }

        .tip-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 0;
            border-bottom: 1px solid #EAECF0;
        }

            .tip-item:last-child {
                border-bottom: none;
            }

        .tip-icon {
            width: 50px;
            height: 50px;
            background: #EFF6FF;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .tip-icon i {
                font-size: 1.5rem;
                color: #2563EB;
            }

        .tip-content h3 {
            font-size: 1rem;
            margin-bottom: 0.25rem;
        }

        .tip-content p {
            font-size: 0.875rem;
            color: #6B7280;
        }

        @@media (max-width: 768px) {
            .container {
                padding: 0 1rem;
            }

            .top-bar {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <a href="/Citizen/Index" class="navbar-brand">SMART CIVIC <span>ALERT</span></a>
        <a href="/Account/Logout" style="color: #6B7280;"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </nav>

    <div class="container">
        <div class="top-bar">
            <div class="page-title"><h1><i class="fas fa-shield-alt" style="color: #2563EB;"></i> Safety Tips</h1></div>
            <a href="/Citizen/Index" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>
        </div>

        <div class="tips-card">
            <div class="tip-item">
                <div class="tip-icon"><i class="fas fa-phone-alt"></i></div>
                <div class="tip-content">
                    <h3>Emergency Helplines</h3>
                    <p>Rescue 1122 | Police 15 | Fire 16 | Ambulance 115</p>
                </div>
            </div>
            <div class="tip-item">
                <div class="tip-icon"><i class="fas fa-location-dot"></i></div>
                <div class="tip-content">
                    <h3>Share Your Location</h3>
                    <p>Always share your exact location when reporting an incident for faster response.</p>
                </div>
            </div>
            <div class="tip-item">
                <div class="tip-icon"><i class="fas fa-camera"></i></div>
                <div class="tip-content">
                    <h3>Take Photos</h3>
                    <p>Take clear photos of the incident scene for better assessment by authorities.</p>
                </div>
            </div>
            <div class="tip-item">
                <div class="tip-icon"><i class="fas fa-clock"></i></div>
                <div class="tip-content">
                    <h3>Report Immediately</h3>
                    <p>Report incidents as soon as possible to ensure quick response and resolution.</p>
                </div>
            </div>
            <div class="tip-item">
                <div class="tip-icon"><i class="fas fa-id-card"></i></div>
                <div class="tip-content">
                    <h3>Keep ID Ready</h3>
                    <p>Keep your CNIC or identification ready when reporting for verification purposes.</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>