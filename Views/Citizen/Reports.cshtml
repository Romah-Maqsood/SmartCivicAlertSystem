@model IEnumerable<SmartCityPulse.Models.Incident>

@{
    Layout = null;
    ViewData["Title"] = "Download Reports";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Download Reports - Smart Civic Alert</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: transparent;
            color: #1A1F36;
        }

        .reports-wrapper {
            width: 100%;
        }

        .header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .page-header {
            flex: 1;
        }

            .page-header h1 {
                font-size: 22px;
                font-weight: 700;
                color: #1A1F36;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .page-header h1 i {
                    color: #2563EB;
                    font-size: 24px;
                }

            .page-header p {
                font-size: 13px;
                color: #6B7280;
                margin-top: 6px;
            }

        .selection-bar {
            background: #EFF6FF;
            border-radius: 12px;
            padding: 12px 20px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            border: 1px solid #DBEAFE;
        }

        .selection-count {
            font-size: 13px;
            font-weight: 500;
            color: #1E40AF;
        }

            .selection-count i {
                margin-right: 6px;
            }

        .selection-actions {
            display: flex;
            gap: 12px;
        }

        .btn-download {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 20px;
            border-radius: 40px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
        }

        .btn-pdf {
            background: #DC2626;
            color: white;
        }

            .btn-pdf:hover {
                background: #B91C1C;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
            }

            .btn-pdf:disabled {
                background: #FCA5A5;
                cursor: not-allowed;
                transform: none;
            }

        .btn-csv {
            background: #10B981;
            color: white;
        }

            .btn-csv:hover {
                background: #059669;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
            }

            .btn-csv:disabled {
                background: #6EE7B7;
                cursor: not-allowed;
                transform: none;
            }

        .select-all-container {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            font-size: 12px;
            color: #6B7280;
        }

            .select-all-container input {
                width: 16px;
                height: 16px;
                cursor: pointer;
                accent-color: #2563EB;
            }

        .table-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
            border: 1px solid #EAECF0;
        }

        .table-responsive {
            overflow-x: auto;
        }

        .incident-table {
            width: 100%;
            border-collapse: collapse;
        }

            .incident-table th {
                text-align: left;
                padding: 14px 12px;
                color: #6B7280;
                font-size: 11px;
                font-weight: 600;
                border-bottom: 1px solid #EAECF0;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .incident-table td {
                padding: 14px 12px;
                font-size: 13px;
                color: #1A1F36;
                border-bottom: 1px solid #F0F2F5;
            }

            .incident-table tr:hover {
                background: #F9FAFB;
            }

        .checkbox-col {
            width: 40px;
            text-align: center;
        }

            .checkbox-col input {
                width: 18px;
                height: 18px;
                cursor: pointer;
                accent-color: #2563EB;
            }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 600;
            text-transform: capitalize;
        }

        .status-open {
            background: #DBEAFE;
            color: #1E40AF;
        }

        .status-in-progress {
            background: #FEF3C7;
            color: #92400E;
        }

        .status-resolved {
            background: #DCFCE7;
            color: #166534;
        }

        .severity-critical {
            background: #FEF2F2;
            color: #DC2626;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 4px 12px 12px 4px;
            border-left: 3px solid #DC2626;
            display: inline-block;
            font-size: 12px;
        }

        .severity-high {
            background: #FFF7ED;
            color: #EA580C;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 4px 12px 12px 4px;
            border-left: 3px solid #EA580C;
            display: inline-block;
            font-size: 12px;
        }

        .severity-medium {
            background: #FFFBEB;
            color: #D97706;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 4px 12px 12px 4px;
            border-left: 3px solid #D97706;
            display: inline-block;
            font-size: 12px;
        }

        .severity-low {
            background: #ECFDF5;
            color: #059669;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 4px 12px 12px 4px;
            border-left: 3px solid #059669;
            display: inline-block;
            font-size: 12px;
        }

        .no-data {
            text-align: center;
            padding: 60px 20px;
            color: #6B7280;
        }

            .no-data i {
                font-size: 48px;
                color: #94A3B8;
                margin-bottom: 16px;
                display: inline-block;
            }

            .no-data h3 {
                font-size: 16px;
                font-weight: 600;
                margin-bottom: 8px;
                color: #1A1F36;
            }

            .no-data p {
                font-size: 13px;
            }

        @@media (max-width: 768px) {
            .header-row {
                flex-direction: column;
                align-items: flex-start;
            }

            .table-card {
                padding: 12px;
            }

            .incident-table th,
            .incident-table td {
                padding: 10px 8px;
                font-size: 11px;
            }

            .selection-bar {
                flex-direction: column;
                align-items: flex-start;
            }

            .selection-actions {
                width: 100%;
            }

            .btn-download {
                flex: 1;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div class="reports-wrapper">
        <div class="header-row">
            <div class="page-header">
                <h1>
                    <i class="fas fa-download"></i>
                    Download Reports
                </h1>
                <p>Select incidents using checkboxes and download as PDF or CSV</p>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="selection-bar">
                <div class="selection-count">
                    <i class="fas fa-check-square"></i>
                    <span id="selectedCount">0</span> incident(s) selected
                </div>
                <div class="select-all-container">
                    <input type="checkbox" id="selectAllCheckbox">
                    <label for="selectAllCheckbox">Select All</label>
                </div>
                <div class="selection-actions">
                    <button class="btn-download btn-pdf" id="downloadSelectedPdfBtn">
                        <i class="fas fa-file-pdf"></i> Download Selected as PDF
                    </button>
                    <button class="btn-download btn-csv" id="downloadSelectedCsvBtn">
                        <i class="fas fa-file-excel"></i> Download Selected as CSV
                    </button>
                </div>
            </div>

            <div class="table-card">
                <div class="table-responsive">
                    <table class="incident-table" id="incidentsTable">
                        <thead>
                            <tr>
                                <th class="checkbox-col"><input type="checkbox" id="headerCheckbox"></th>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Location</th>
                                <th>Severity</th>
                                <th>Status</th>
                                <th>Reported On</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var incident in Model)
                            {
                                var shortId = incident.Id?.Length >= 6 ? incident.Id.Substring(0, 6) : incident.Id;
                                var statusClass = "";
                                if (incident.Status == "Open") statusClass = "status-open";
                                else if (incident.Status == "In Progress") statusClass = "status-in-progress";
                                else statusClass = "status-resolved";

                                var severityClass = "";
                                if (incident.Severity == "Critical") severityClass = "severity-critical";
                                else if (incident.Severity == "High") severityClass = "severity-high";
                                else if (incident.Severity == "Medium") severityClass = "severity-medium";
                                else severityClass = "severity-low";

                                <tr data-id="@incident.Id">
                                    <td class="checkbox-col">
                                        <input type="checkbox" class="rowCheckbox" value="@incident.Id">
                                    </td>
                                    <td>#@shortId</td>
                                    <td>@incident.Title</td>
                                    <td>@incident.Location</td>
                                    <td><span class="@severityClass">@incident.Severity</span></td>
                                    <td><span class="status-badge @statusClass">@incident.Status</span></td>
                                    <td>@incident.ReportedAt.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="table-card">
                <div class="no-data">
                    <i class="fas fa-folder-open"></i>
                    <h3>No Reports Found</h3>
                    <p>You haven't reported any incidents yet. Start by reporting an incident.</p>
                </div>
            </div>
        }
    </div>

    <script>
        // Store incidents data
        var incidentsData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));

        // Get all row checkboxes
        var rowCheckboxes = document.querySelectorAll('.rowCheckbox');
        var headerCheckbox = document.getElementById('headerCheckbox');
        var selectAllCheckbox = document.getElementById('selectAllCheckbox');
        var selectedCountSpan = document.getElementById('selectedCount');
        var downloadPdfBtn = document.getElementById('downloadSelectedPdfBtn');
        var downloadCsvBtn = document.getElementById('downloadSelectedCsvBtn');

        // Function to update selection count and button states
        function updateSelectionStatus() {
            var checkedBoxes = document.querySelectorAll('.rowCheckbox:checked');
            var count = checkedBoxes.length;

            // Update count display
            if (selectedCountSpan) {
                selectedCountSpan.textContent = count;
            }

            // Enable/disable download buttons
            if (downloadPdfBtn) {
                downloadPdfBtn.disabled = (count === 0);
            }
            if (downloadCsvBtn) {
                downloadCsvBtn.disabled = (count === 0);
            }

            // Update header checkbox (select all in table)
            if (headerCheckbox && rowCheckboxes.length > 0) {
                headerCheckbox.checked = (count === rowCheckboxes.length);
                headerCheckbox.indeterminate = (count > 0 && count < rowCheckboxes.length);
            }

            // Update select all checkbox in selection bar
            if (selectAllCheckbox && rowCheckboxes.length > 0) {
                selectAllCheckbox.checked = (count === rowCheckboxes.length);
                selectAllCheckbox.indeterminate = (count > 0 && count < rowCheckboxes.length);
            }
        }

        // Function to get selected incidents
        function getSelectedIncidents() {
            var selectedIds = [];
            document.querySelectorAll('.rowCheckbox:checked').forEach(function(cb) {
                selectedIds.push(cb.value);
            });

            // Filter incidents by selected IDs
            return incidentsData.filter(function(inc) {
                return selectedIds.includes(inc.Id);
            });
        }

        // Function to select/deselect all rows
        function selectAllRows(isChecked) {
            rowCheckboxes.forEach(function(cb) {
                cb.checked = isChecked;
            });
            updateSelectionStatus();
        }

        // Add event listeners to row checkboxes
        rowCheckboxes.forEach(function(checkbox) {
            checkbox.addEventListener('change', updateSelectionStatus);
        });

        // Header checkbox (in table header)
        if (headerCheckbox) {
            headerCheckbox.addEventListener('change', function() {
                selectAllRows(this.checked);
            });
        }

        // Select All checkbox (in selection bar)
        if (selectAllCheckbox) {
            selectAllCheckbox.addEventListener('change', function() {
                selectAllRows(this.checked);
                if (headerCheckbox) {
                    headerCheckbox.checked = this.checked;
                    headerCheckbox.indeterminate = false;
                }
            });
        }

        // Initialize selection status
        updateSelectionStatus();

        // Escape HTML function
        function escapeHtml(text) {
            if (!text) return '';
            var div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Download as PDF
        function downloadAsPDF(selectedIncidents) {
            if (selectedIncidents.length === 0) {
                alert('Please select at least one incident to download.');
                return;
            }

            var currentDate = new Date().toLocaleString();
            var timestamp = new Date().toISOString().split('T')[0];

            var rows = '';
            selectedIncidents.forEach(function(inc) {
                var shortId = inc.Id ? inc.Id.substring(0, 8) : 'N/A';
                rows += '<tr>' +
                    '<td>' + shortId + '</td>' +
                    '<td>' + escapeHtml(inc.Title) + '</td>' +
                    '<td>' + escapeHtml(inc.Location) + '</td>' +
                    '<td>' + inc.Severity + '</td>' +
                    '<td>' + inc.Status + '</td>' +
                    '<td>' + new Date(inc.ReportedAt).toLocaleDateString() + '</td>' +
                '</tr>';
            });

            var htmlContent = '<!DOCTYPE html>' +
                '<html>' +
                '<head>' +
                    '<meta charset="UTF-8">' +
                    '<title>Incident Report</title>' +
                    '<style>' +
                        'body { font-family: "Segoe UI", Arial, sans-serif; margin: 40px; line-height: 1.6; }' +
                        'h1 { color: #2563EB; border-bottom: 2px solid #2563EB; padding-bottom: 10px; }' +
                        '.header { text-align: center; margin-bottom: 30px; }' +
                        '.report-info { background: #F8FAFC; padding: 15px; border-radius: 8px; margin-bottom: 20px; }' +
                        '.report-info p { margin: 5px 0; }' +
                        'table { width: 100%; border-collapse: collapse; margin-top: 20px; }' +
                        'th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }' +
                        'th { background-color: #2563EB; color: white; }' +
                        'tr:nth-child(even) { background-color: #f9f9f9; }' +
                        '.footer { text-align: center; margin-top: 30px; font-size: 12px; color: #666; border-top: 1px solid #ddd; padding-top: 15px; }' +
                    '</style>' +
                '</head>' +
                '<body>' +
                    '<div class="header">' +
                        '<h1>Smart Civic Alert - Incident Report</h1>' +
                        '<p>Citizen Incident Report Export</p>' +
                    '</div>' +
                    '<div class="report-info">' +
                        '<p><strong>Report Generated:</strong> ' + currentDate + '</p>' +
                        '<p><strong>Total Incidents:</strong> ' + selectedIncidents.length + '</p>' +
                    '</div>' +
                    '<table>' +
                        '<thead>' +
                            '<tr><th>ID</th><th>Title</th><th>Location</th><th>Severity</th><th>Status</th><th>Reported Date</th></tr>' +
                        '</thead>' +
                        '<tbody>' + rows + '</tbody>' +
                    '</table>' +
                    '<div class="footer">' +
                        '<p>Smart Civic Alert - Citizen Incident Report System</p>' +
                        '<p>This is an automatically generated report.</p>' +
                    '</div>' +
                '</body>' +
                '</html>';

            var blob = new Blob([htmlContent], { type: 'application/pdf' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'Incident_Report_' + timestamp + '.pdf';
            link.click();
            URL.revokeObjectURL(link.href);
        }

        // Download as CSV
        function downloadAsCSV(selectedIncidents) {
            if (selectedIncidents.length === 0) {
                alert('Please select at least one incident to download.');
                return;
            }

            var timestamp = new Date().toISOString().split('T')[0];
            var csvContent = "ID,Title,Location,Severity,Status,Reported Date,Description\n";

            selectedIncidents.forEach(function(inc) {
                var shortId = inc.Id ? inc.Id.substring(0, 8) : 'N/A';
                var row = [
                    '"' + shortId + '"',
                    '"' + (inc.Title || '').replace(/"/g, '""') + '"',
                    '"' + (inc.Location || '').replace(/"/g, '""') + '"',
                    '"' + inc.Severity + '"',
                    '"' + inc.Status + '"',
                    '"' + new Date(inc.ReportedAt).toLocaleDateString() + '"',
                    '"' + (inc.Description || '').replace(/"/g, '""') + '"'
                ].join(',');
                csvContent += row + "\n";
            });

            var blob = new Blob(["\uFEFF" + csvContent], { type: 'text/csv;charset=utf-8;' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'Incident_Report_' + timestamp + '.csv';
            link.click();
            URL.revokeObjectURL(link.href);
        }

        // Download button event listeners
        if (downloadPdfBtn) {
            downloadPdfBtn.addEventListener('click', function() {
                var selected = getSelectedIncidents();
                downloadAsPDF(selected);
            });
        }

        if (downloadCsvBtn) {
            downloadCsvBtn.addEventListener('click', function() {
                var selected = getSelectedIncidents();
                downloadAsCSV(selected);
            });
        }
    </script>
</body>
</html>