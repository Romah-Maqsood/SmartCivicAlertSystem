@{
    Layout = null;
    ViewData["Title"] = "Statistics";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #E8EDF5;
            color: #1A1F36;
        }

        /* Main Container */
        .statistics-container {
            padding: 1.5rem;
            height: 100vh;
            overflow-y: auto;
        }

            /* Custom Scrollbar */
            .statistics-container::-webkit-scrollbar {
                width: 6px;
            }

            .statistics-container::-webkit-scrollbar-track {
                background: #E2E8F0;
                border-radius: 10px;
            }

            .statistics-container::-webkit-scrollbar-thumb {
                background: #94A3B8;
                border-radius: 10px;
            }

                .statistics-container::-webkit-scrollbar-thumb:hover {
                    background: #64748B;
                }

        .welcome-header {
            margin-bottom: 1.5rem;
        }

            .welcome-header h1 {
                font-size: 1.5rem;
                font-weight: 700;
                color: #1A1F36;
            }

                .welcome-header h1 i {
                    color: #2563EB;
                    margin-right: 0.5rem;
                }

            .welcome-header p {
                font-size: 0.875rem;
                color: #6B7280;
                margin-top: 0.25rem;
            }

        /* Graphs Grid */
        .graphs-grid {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .full-width-card {
            background: #FFFFFF;
            border-radius: 20px;
            padding: 1.5rem;
            border: 1px solid #EAECF0;
            transition: all 0.3s ease;
        }

            .full-width-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
            }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

            .card-header h3 {
                font-size: 1rem;
                font-weight: 600;
                color: #1A1F36;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

                .card-header h3 i {
                    color: #2563EB;
                }

        .full-width-card canvas {
            max-height: 300px;
            width: 100%;
        }

        .two-columns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .small-card {
            background: #FFFFFF;
            border-radius: 20px;
            padding: 1.5rem;
            border: 1px solid #EAECF0;
            transition: all 0.3s ease;
        }

            .small-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
            }

            .small-card canvas {
                max-height: 250px;
                width: 100%;
            }

        @@media (max-width: 1024px) {
            .two-columns

        {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        }

        @@media (max-width: 768px) {
            .statistics-container

        {
            padding: 1rem;
        }

        }
    </style>
</head>
<body>
    <div class="statistics-container">
        <div class="welcome-header">
            <h1><i class="fas fa-chart-line"></i> Incident Statistics</h1>
            <p>Visual insights of your reported incidents</p>
        </div>

        <div class="graphs-grid">
            <!-- Big Chart -->
            <div class="full-width-card">
                <div class="card-header">
                    <h3><i class="fas fa-chart-line"></i> Incident Trends (Last 7 Days)</h3>
                </div>
                <canvas id="trendChart"></canvas>
            </div>

            <!-- Two Small Charts -->
            <div class="two-columns">
                <div class="small-card">
                    <div class="card-header">
                        <h3><i class="fas fa-chart-pie"></i> Severity Distribution</h3>
                    </div>
                    <canvas id="severityChart"></canvas>
                </div>
                <div class="small-card">
                    <div class="card-header">
                        <h3><i class="fas fa-chart-donut"></i> Status Distribution</h3>
                    </div>
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script>
        const weeklyData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.WeeklyData ?? new int[] { 0, 0, 0, 0, 0, 0, 0 }));
        const labels = ['6 days ago', '5 days ago', '4 days ago', '3 days ago', '2 days ago', 'Yesterday', 'Today'];

        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Incidents Reported',
                    data: weeklyData,
                    borderColor: '#2563EB',
                    backgroundColor: 'rgba(37, 99, 235, 0.05)',
                    borderWidth: 2.5,
                    fill: true,
                    tension: 0.3,
                    pointBackgroundColor: '#2563EB',
                    pointBorderColor: '#FFFFFF',
                    pointRadius: 4
                }]
            },
            options: { responsive: true, maintainAspectRatio: true }
        });

        new Chart(document.getElementById('severityChart'), {
            type: 'pie',
            data: {
                labels: ['Critical', 'High', 'Medium', 'Low'],
                datasets: [{
                    data: [@ViewBag.CriticalIncidents, @ViewBag.HighIncidents, @ViewBag.MediumIncidents, @ViewBag.LowIncidents],
                    backgroundColor: ['#DC2626', '#F97316', '#EAB308', '#10B981'],
                    borderWidth: 0
                }]
            },
            options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom' } } }
        });

        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: ['Open', 'In Progress', 'Resolved'],
                datasets: [{
                    data: [@ViewBag.OpenIncidents, @ViewBag.InProgressIncidents, @ViewBag.ResolvedIncidents],
                    backgroundColor: ['#3B82F6', '#F59E0B', '#10B981'],
                    borderWidth: 0
                }]
            },
            options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom' } } }
        });
    </script>
</body>
</html>