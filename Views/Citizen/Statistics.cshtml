@{
    Layout = null;
    ViewData["Title"] = "Statistics";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #E8EDF5;
            color: #1A1F36;
        }

        /* Main Container - Same as Dashboard Main Content */
        .statistics-container {
            padding: 1.5rem;
        }

        /* Welcome Header - Same as Dashboard */
        .welcome-header {
            margin-bottom: 1.5rem;
        }

            .welcome-header h1 {
                font-size: 1.5rem;
                font-weight: 700;
                color: #1A1F36;
            }

                .welcome-header h1 i {
                    color: #2563EB;
                    margin-right: 0.5rem;
                }

            .welcome-header p {
                font-size: 0.875rem;
                color: #6B7280;
                margin-top: 0.25rem;
            }

        /* Graphs Grid */
        .graphs-grid {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        /* Full Width Chart Card */
        .full-width-card {
            background: #FFFFFF;
            border-radius: 20px;
            padding: 1.5rem;
            border: 1px solid #EAECF0;
            transition: all 0.3s ease;
        }

            .full-width-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
            }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

            .card-header h3 {
                font-size: 1rem;
                font-weight: 600;
                color: #1A1F36;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

                .card-header h3 i {
                    color: #2563EB;
                }

        .full-width-card canvas {
            max-height: 300px;
            width: 100%;
        }

        /* Two Columns Layout */
        .two-columns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        /* Small Chart Card */
        .small-card {
            background: #FFFFFF;
            border-radius: 20px;
            padding: 1.5rem;
            border: 1px solid #EAECF0;
            transition: all 0.3s ease;
        }

            .small-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
            }

            .small-card canvas {
                max-height: 250px;
                width: 100%;
            }

        /* No Stats Cards - Removed */

        /* Responsive */
        @@media (max-width: 1024px) {
            .two-columns

        {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        }

        @@media (max-width: 768px) {
            .statistics-container

        {
            padding: 1rem;
        }

        }
    </style>
</head>
<body>
    <div class="statistics-container">
        <!-- Welcome Header (Same as Dashboard) -->
        <div class="welcome-header">
            <h1><i class="fas fa-chart-line"></i> Incident Statistics</h1>
            <p>Visual insights of your reported incidents</p>
        </div>

        <!-- Graphs Only - No Stats Cards -->
        <div class="graphs-grid">
            <!-- Big Graph: Trend Chart - Full Width -->
            <div class="full-width-card">
                <div class="card-header">
                    <h3><i class="fas fa-chart-line"></i> Incident Trends (Last 7 Days)</h3>
                </div>
                <canvas id="trendChart"></canvas>
            </div>

            <!-- Two Small Graphs -->
            <div class="two-columns">
                <!-- Severity Distribution - Pie Chart -->
                <div class="small-card">
                    <div class="card-header">
                        <h3><i class="fas fa-chart-pie"></i> Severity Distribution</h3>
                    </div>
                    <canvas id="severityChart"></canvas>
                </div>

                <!-- Status Distribution - Doughnut Chart -->
                <div class="small-card">
                    <div class="card-header">
                        <h3><i class="fas fa-chart-donut"></i> Status Distribution</h3>
                    </div>
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Get data from ViewBag
        const weeklyData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.WeeklyData ?? new int[] { 0, 0, 0, 0, 0, 0, 0 }));
        const labels = ['6 days ago', '5 days ago', '4 days ago', '3 days ago', '2 days ago', 'Yesterday', 'Today'];

        // 1. Line Chart - Incident Trends
        const trendCtx = document.getElementById('trendChart').getContext('2d');
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Incidents Reported',
                    data: weeklyData,
                    borderColor: '#2563EB',
                    backgroundColor: 'rgba(37, 99, 235, 0.05)',
                    borderWidth: 2.5,
                    fill: true,
                    tension: 0.3,
                    pointBackgroundColor: '#2563EB',
                    pointBorderColor: '#FFFFFF',
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { font: { size: 11, weight: '500' }, boxWidth: 10 }
                    },
                    tooltip: {
                        backgroundColor: '#1E293B',
                        titleColor: '#FFFFFF',
                        bodyColor: '#94A3B8',
                        callbacks: {
                            label: (ctx) => `${ctx.dataset.label}: ${ctx.raw} incidents`
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#E2E8F0', drawBorder: false },
                        ticks: { stepSize: 1, font: { size: 11 } }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 11 } }
                    }
                }
            }
        });

        // 2. Pie Chart - Severity Distribution
        const severityCtx = document.getElementById('severityChart').getContext('2d');
        new Chart(severityCtx, {
            type: 'pie',
            data: {
                labels: ['Critical', 'High', 'Medium', 'Low'],
                datasets: [{
                    data: [@ViewBag.CriticalIncidents, @ViewBag.HighIncidents, @ViewBag.MediumIncidents, @ViewBag.LowIncidents],
                    backgroundColor: ['#DC2626', '#F97316', '#EAB308', '#10B981'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { font: { size: 11 }, boxWidth: 10, padding: 8 }
                    },
                    tooltip: {
                        backgroundColor: '#1E293B',
                        titleColor: '#FFFFFF',
                        bodyColor: '#94A3B8',
                        callbacks: {
                            label: (ctx) => {
                                const total = @ViewBag.TotalIncidents;
                                const percentage = total > 0 ? ((ctx.raw / total) * 100).toFixed(1) : 0;
                                return `${ctx.label}: ${ctx.raw} incidents (${percentage}%)`;
                            }
                        }
                    }
                }
            }
        });

        // 3. Doughnut Chart - Status Distribution
        const statusCtx = document.getElementById('statusChart').getContext('2d');
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: ['Open', 'In Progress', 'Resolved'],
                datasets: [{
                    data: [@ViewBag.OpenIncidents, @ViewBag.InProgressIncidents, @ViewBag.ResolvedIncidents],
                    backgroundColor: ['#3B82F6', '#F59E0B', '#10B981'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { font: { size: 11 }, boxWidth: 10, padding: 8 }
                    },
                    tooltip: {
                        backgroundColor: '#1E293B',
                        titleColor: '#FFFFFF',
                        bodyColor: '#94A3B8',
                        callbacks: {
                            label: (ctx) => `${ctx.label}: ${ctx.raw} incidents`
                        }
                    }
                }
            }
        });
    </script>
</body>
</html>