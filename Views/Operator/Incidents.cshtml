@model List<SmartCityPulse.Models.Incident>
@{
    ViewData["Title"] = "Incidents";
    Layout = null;
    string dept = ViewBag.Department ?? "";
    string operatorName = ViewBag.OperatorName ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Incidents - @dept Department</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #E8EDF5;
            color: #1A1F36;
        }
        .dashboard { display: flex; min-height: 100vh; }
        .sidebar {
            width: 260px;
            background: #FFFFFF;
            border-right: 1px solid #EAECF0;
            position: fixed;
            height: 100vh;
            display: flex;
            flex-direction: column;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 100;
        }
        .sidebar.collapsed { width: 72px; }
        .sidebar.collapsed .logo h2, .sidebar.collapsed .nav-item span, .sidebar.collapsed .footer-item span { display: none; }
        .sidebar.collapsed .nav-item, .sidebar.collapsed .footer-item { justify-content: center; padding: 12px 0; }
        .sidebar.collapsed .nav-item i, .sidebar.collapsed .footer-item i { margin: 0; font-size: 20px; }
        .sidebar.collapsed .sidebar-header { justify-content: center; padding: 20px 0; }
        .sidebar.collapsed .logo { justify-content: center; }
        .sidebar-header { padding: 20px 16px; border-bottom: 1px solid #EAECF0; display: flex; justify-content: space-between; align-items: center; }
        .logo { display: flex; align-items: center; gap: 8px; }
        .logo i { font-size: 24px; color: #2563EB; }
        .logo h2 { font-size: 15px; font-weight: 700; color: #1A1F36; letter-spacing: -0.3px; }
        .logo span { color: #2563EB; }
        .hamburger { cursor: pointer; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 8px; transition: all 0.2s ease; color: #6B7280; }
        .hamburger:hover { background: #F1F5F9; color: #2563EB; }
        .hamburger i { font-size: 18px; }
        .nav-menu { flex: 1; padding: 20px 12px; }
        .nav-item { display: flex; align-items: center; gap: 12px; padding: 10px 16px; margin: 2px 0; color: #5A6A7F; text-decoration: none; font-size: 13px; font-weight: 500; transition: all 0.2s ease; border-radius: 10px; }
        .nav-item i { width: 20px; font-size: 16px; }
        .nav-item:hover { background: #F1F5F9; color: #2563EB; }
        .nav-item.active { background: #EFF6FF; color: #2563EB; }
        .nav-footer { padding: 16px 12px; border-top: 1px solid #EAECF0; }
        .footer-item { display: flex; align-items: center; gap: 12px; padding: 10px 16px; color: #5A6A7F; text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 10px; transition: all 0.2s ease; }
        .footer-item:hover { background: #F1F5F9; color: #2563EB; }
        .footer-item.logout { color: #DC2626; }
        .footer-item.logout:hover { background: #FEF2F2; }
        .dept-info { padding: 8px 16px; margin: 0 12px 12px 12px; background: #EFF6FF; border-radius: 10px; display: flex; align-items: center; gap: 8px; font-size: 12px; color: #2563EB; }
        .main-content { margin-left: 260px; flex: 1; padding: 24px 32px; background: #E8EDF5; transition: margin-left 0.3s ease; min-height: 100vh; }
        .sidebar.collapsed ~ .main-content { margin-left: 72px; }
        .page-header { margin-bottom: 28px; }
        .page-header h1 { font-size: 22px; font-weight: 700; color: #1A1F36; }
        .page-header h1 i { color: #2563EB; margin-right: 8px; }
        .page-header p { font-size: 13px; color: #6B7280; margin-top: 6px; }
        .filter-bar { display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap; align-items: center; background: #FFFFFF; padding: 16px 20px; border-radius: 16px; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04); }
        .filter-bar form { display: flex; gap: 12px; flex-wrap: wrap; }
        select { background: #F9FAFB; border: 1px solid #EAECF0; color: #1A1F36; padding: 8px 16px; border-radius: 40px; font-size: 13px; font-family: 'Inter', sans-serif; cursor: pointer; outline: none; }
        select:focus { border-color: #2563EB; }
        .btn-filter { background: #2563EB; color: white; border: none; padding: 8px 20px; border-radius: 40px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s ease; }
        .btn-filter:hover { background: #1D4ED8; transform: translateY(-1px); }
        .btn-primary { background: #2563EB; color: white; border: none; padding: 8px 20px; border-radius: 40px; font-size: 13px; font-weight: 500; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease; }
        .btn-primary:hover { background: #1D4ED8; transform: translateY(-1px); }
        .table-container { background: #FFFFFF; border-radius: 16px; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04); overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        thead { background: #F9FAFB; border-bottom: 1px solid #EAECF0; }
        thead th { padding: 16px 20px; text-align: left; font-size: 11px; font-weight: 600; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px; }
        tbody tr { border-bottom: 1px solid #EAECF0; transition: background 0.2s ease; }
        tbody tr:hover { background: #F9FAFB; }
        tbody td { padding: 14px 20px; font-size: 13px; color: #1A1F36; }
        .badge { display: inline-block; padding: 4px 10px; border-radius: 50px; font-size: 11px; font-weight: 500; }
        .badge-critical { background: #FEF2F2; color: #DC2626; }
        .badge-high { background: #FEF3C7; color: #F97316; }
        .badge-medium { background: #FEF9C3; color: #EAB308; }
        .badge-low { background: #DCFCE7; color: #10B981; }
        .status-open { background: #DBEAFE; color: #1E40AF; padding: 4px 10px; border-radius: 50px; font-size: 11px; font-weight: 500; }
        .status-inprogress { background: #FEF3C7; color: #92400E; padding: 4px 10px; border-radius: 50px; font-size: 11px; font-weight: 500; }
        .status-resolved { background: #DCFCE7; color: #166534; padding: 4px 10px; border-radius: 50px; font-size: 11px; font-weight: 500; }
        .btn-detail { background: #F1F5F9; color: #2563EB; padding: 6px 12px; border-radius: 40px; font-size: 11px; text-decoration: none; transition: all 0.2s ease; }
        .btn-detail:hover { background: #2563EB; color: white; }
        .empty-state { text-align: center; padding: 60px; color: #6B7280; }
        .empty-state i { font-size: 48px; margin-bottom: 16px; display: block; }
        .count-badge { background: #2563EB; color: white; padding: 2px 10px; border-radius: 20px; font-size: 12px; margin-left: 8px; }
        .fir-number { font-family: monospace; font-weight: 600; color: #2563EB; background: #EFF6FF; padding: 2px 6px; border-radius: 6px; font-size: 11px; }
        .fire-type-badge { background: #FEE2E2; color: #DC2626; padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 500; }
        .rescue-type-badge { background: #D1FAE5; color: #10B981; padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 500; }
        .police-type-badge { background: #DBEAFE; color: #2563EB; padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 500; }
        @@media (max-width: 768px) {
            .sidebar { width: 100%; position: relative; height: auto; }
            .main-content { margin-left: 0; padding: 20px; }
            .filter-bar { flex-direction: column; align-items: stretch; }
            .filter-bar form { flex-direction: column; }
            .btn-primary { margin-left: 0 !important; text-align: center; justify-content: center; }
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <i class="fas fa-city"></i>
                    <h2>SMART CIVIC <span>ALERT</span></h2>
                </div>
                <div class="hamburger" id="toggleSidebar">
                    <i class="fas fa-bars"></i>
                </div>
            </div>
            <div class="nav-menu">
                <a href="/Operator/Dashboard" class="nav-item"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a>
                <a href="/Operator/Incidents" class="nav-item active"><i class="fas fa-list-alt"></i> <span>Incidents</span></a>
                <a href="/Operator/CreateIncident" class="nav-item"><i class="fas fa-plus-circle"></i> <span>Create Incident</span></a>
            </div>
            <div class="dept-info">
                <i class="fas fa-building"></i>
                <span>@dept Department</span>
            </div>
            <div class="nav-footer">
                <a href="/Account/Logout" class="footer-item logout"><i class="fas fa-sign-out-alt"></i> <span>Logout</span></a>
            </div>
        </div>

        <div class="main-content">
            <div class="page-header">
                <h1><i class="fas fa-list-alt"></i> Incidents <span class="count-badge">@Model.Count</span></h1>
                <p>@dept — All incidents assigned to your department</p>
            </div>

            <div class="filter-bar">
                <form method="get" action="/Operator/Incidents">
                    <select name="status">
                        <option value="">All Status</option>
                        <option value="Open" selected="@(ViewBag.SelectedStatus == "Open")">Open</option>
                        <option value="In Progress" selected="@(ViewBag.SelectedStatus == "In Progress")">In Progress</option>
                        <option value="Resolved" selected="@(ViewBag.SelectedStatus == "Resolved")">Resolved</option>
                    </select>
                    <select name="severity">
                        <option value="">All Severity</option>
                        <option value="Critical" selected="@(ViewBag.SelectedSeverity == "Critical")">Critical</option>
                        <option value="High" selected="@(ViewBag.SelectedSeverity == "High")">High</option>
                        <option value="Medium" selected="@(ViewBag.SelectedSeverity == "Medium")">Medium</option>
                        <option value="Low" selected="@(ViewBag.SelectedSeverity == "Low")">Low</option>
                    </select>
                    
                    @if (dept == "Police")
                    {
                        <select name="caseType">
                            <option value="">All Case Types</option>
                            <option value="Theft" selected="@(ViewBag.SelectedCaseType == "Theft")">Theft</option>
                            <option value="Robbery" selected="@(ViewBag.SelectedCaseType == "Robbery")">Robbery</option>
                            <option value="Accident" selected="@(ViewBag.SelectedCaseType == "Accident")">Accident</option>
                            <option value="Assault" selected="@(ViewBag.SelectedCaseType == "Assault")">Assault</option>
                            <option value="Missing Person" selected="@(ViewBag.SelectedCaseType == "Missing Person")">Missing Person</option>
                        </select>
                    }
                    
                    @if (dept == "Fire")
                    {
                        <select name="fireType">
                            <option value="">All Fire Types</option>
                            <option value="Building Fire" selected="@(ViewBag.SelectedFireType == "Building Fire")">Building Fire</option>
                            <option value="Vehicle Fire" selected="@(ViewBag.SelectedFireType == "Vehicle Fire")">Vehicle Fire</option>
                            <option value="Forest Fire" selected="@(ViewBag.SelectedFireType == "Forest Fire")">Forest Fire</option>
                            <option value="Electrical Fire" selected="@(ViewBag.SelectedFireType == "Electrical Fire")">Electrical Fire</option>
                            <option value="Gas Leak" selected="@(ViewBag.SelectedFireType == "Gas Leak")">Gas Leak</option>
                            <option value="Industrial Fire" selected="@(ViewBag.SelectedFireType == "Industrial Fire")">Industrial Fire</option>
                        </select>
                    }
                    
                    @if (dept == "Rescue")
                    {
                        <select name="emergencyType">
                            <option value="">All Emergency Types</option>
                            <option value="Cardiac Arrest" selected="@(ViewBag.SelectedEmergencyType == "Cardiac Arrest")">Cardiac Arrest</option>
                            <option value="Accident Injury" selected="@(ViewBag.SelectedEmergencyType == "Accident Injury")">Accident Injury</option>
                            <option value="Burns" selected="@(ViewBag.SelectedEmergencyType == "Burns")">Burns</option>
                            <option value="Drowning" selected="@(ViewBag.SelectedEmergencyType == "Drowning")">Drowning</option>
                            <option value="Fall Injury" selected="@(ViewBag.SelectedEmergencyType == "Fall Injury")">Fall Injury</option>
                            <option value="Childbirth" selected="@(ViewBag.SelectedEmergencyType == "Childbirth")">Childbirth</option>
                        </select>
                    }
                    
                    <button type="submit" class="btn-filter"><i class="fas fa-filter"></i> Apply Filter</button>
                </form>
                <a href="/Operator/CreateIncident" class="btn-primary" style="margin-left:auto;"><i class="fas fa-plus"></i> New Incident</a>
            </div>

            <div class="table-container">
                <table class="incident-table">
                    <thead>
                        <tr>
                            @if (dept == "Police")
                            {
                                <th>FIR #</th>
                                <th>Case Type</th>
                            }
                            @if (dept == "Fire")
                            {
                                <th>Fire Type</th>
                                <th>Fire Status</th>
                            }
                            @if (dept == "Rescue")
                            {
                                <th>Emergency Type</th>
                                <th>Patient Condition</th>
                            }
                            <th>Title</th>
                            <th>Location</th>
                            <th>Severity</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="10">
                                    <div class="empty-state">
                                        <i class="fas fa-inbox"></i>
                                        No incidents found
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var i in Model)
                            {
                                <tr>
                                    @if (dept == "Police")
                                    {
                                        <td><span class="fir-number">@i.FIRNumber</span></td>
                                        <td><span class="police-type-badge"><i class="fas fa-folder"></i> @i.CaseType</span></td>
                                    }
                                    @if (dept == "Fire")
                                    {
                                        <td><span class="fire-type-badge"><i class="fas fa-fire"></i> @i.FireType</span></td>
                                        <td>@i.FireStatus</td>
                                    }
                                    @if (dept == "Rescue")
                                    {
                                        <td><span class="rescue-type-badge"><i class="fas fa-truck-medical"></i> @i.EmergencyType</span></td>
                                        <td>
                                            @if (i.PatientCondition == "Critical")
                                            {
                                                <span style="color:#DC2626;">🔴 Critical</span>
                                            }
                                            else if (i.PatientCondition == "Serious")
                                            {
                                                <span style="color:#F97316;">🟠 Serious</span>
                                            }
                                            else
                                            {
                                                <span style="color:#10B981;">🟢 Stable</span>
                                            }
                                        </td>
                                    }
                                    <td><strong>@i.Title</strong></td>
                                    <td><i class="fas fa-map-marker-alt" style="color:#2563EB; margin-right:6px;"></i>@i.Location</td>
                                    <td><span class="badge badge-@i.Severity.ToLower()">@i.Severity</span></td>
                                    <td>
                                        @{
                                            var sc = i.Status == "Open" ? "status-open" : i.Status == "In Progress" ? "status-inprogress" : "status-resolved";
                                        }
                                        <span class="@sc">@i.Status</span>
                                    </td>
                                    <td>@i.ReportedAt.ToString("dd MMM yyyy")</td>
                                    <td><a href="/Operator/IncidentDetail/@i.Id" class="btn-detail"><i class="fas fa-eye"></i> View</a></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script>
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggleSidebar');
        toggleBtn.addEventListener('click', function() { sidebar.classList.toggle('collapsed'); });
    </script>
</body>
</html>