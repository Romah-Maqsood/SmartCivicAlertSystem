@model SmartCityPulse.Models.Incident
@{
    ViewData["Title"] = "Create Incident";
    Layout = null;
    string operatorName = ViewBag.OperatorName ?? "";
    string operatorEmail = ViewBag.OperatorEmail ?? "";
    string dept = ViewBag.Department ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Incident - @dept Department</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #E8EDF5; color: #1A1F36; }
        .dashboard { display: flex; min-height: 100vh; }
        .sidebar { width: 260px; background: #FFFFFF; border-right: 1px solid #EAECF0; position: fixed; height: 100vh; display: flex; flex-direction: column; transition: all 0.3s; z-index: 100; }
        .sidebar.collapsed { width: 72px; }
        .sidebar.collapsed .logo h2, .sidebar.collapsed .nav-item span, .sidebar.collapsed .footer-item span { display: none; }
        .sidebar.collapsed .nav-item, .sidebar.collapsed .footer-item { justify-content: center; padding: 12px 0; }
        .sidebar.collapsed .nav-item i, .sidebar.collapsed .footer-item i { margin: 0; font-size: 20px; }
        .sidebar.collapsed .sidebar-header { justify-content: center; padding: 20px 0; }
        .sidebar.collapsed .logo { justify-content: center; }
        .sidebar-header { padding: 20px 16px; border-bottom: 1px solid #EAECF0; display: flex; justify-content: space-between; align-items: center; }
        .logo { display: flex; align-items: center; gap: 8px; }
        .logo i { font-size: 24px; color: #2563EB; }
        .logo h2 { font-size: 15px; font-weight: 700; color: #1A1F36; }
        .logo span { color: #2563EB; }
        .hamburger { cursor: pointer; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 8px; color: #6B7280; }
        .hamburger:hover { background: #F1F5F9; color: #2563EB; }
        .nav-menu { flex: 1; padding: 20px 12px; }
        .nav-item { display: flex; align-items: center; gap: 12px; padding: 10px 16px; margin: 2px 0; color: #5A6A7F; text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 10px; position: relative; }
        .nav-item i { width: 20px; font-size: 16px; }
        .nav-item:hover { background: #F1F5F9; color: #2563EB; }
        .nav-item.active { background: #EFF6FF; color: #2563EB; }
        .notification-badge-sidebar { position: absolute; right: 16px; top: 8px; background: #EF4444; color: white; border-radius: 50%; padding: 2px 6px; font-size: 10px; font-weight: 600; min-width: 18px; text-align: center; }
        .nav-footer { padding: 16px 12px; border-top: 1px solid #EAECF0; }
        .footer-item { display: flex; align-items: center; gap: 12px; padding: 10px 16px; color: #5A6A7F; text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 10px; }
        .footer-item.logout { color: #DC2626; }
        .dept-info { padding: 8px 16px; margin: 0 12px 12px 12px; background: #EFF6FF; border-radius: 10px; display: flex; align-items: center; gap: 8px; font-size: 12px; color: #2563EB; }
        .main-content { margin-left: 260px; flex: 1; padding: 24px 32px; background: #E8EDF5; transition: margin-left 0.3s; min-height: 100vh; }
        .sidebar.collapsed ~ .main-content { margin-left: 72px; }
        .page-header { margin-bottom: 24px; }
        .page-header h1 { font-size: 22px; font-weight: 700; color: #1A1F36; }
        .page-header p { font-size: 13px; color: #6B7280; margin-top: 6px; }
        .back-link { display: inline-flex; align-items: center; gap: 8px; color: #6B7280; text-decoration: none; font-size: 13px; margin-bottom: 24px; }
        .back-link:hover { color: #2563EB; }
        .card { background: #FFFFFF; border-radius: 16px; padding: 32px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
        .card-title { font-size: 18px; font-weight: 700; margin-bottom: 28px; display: flex; align-items: center; gap: 10px; color: #1A1F36; }
        .card-title i { color: #2563EB; }
        .dept-info-card { background: #EFF6FF; border: 1px solid #DBEAFE; border-radius: 12px; padding: 14px 18px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; color: #1D4ED8; font-size: 14px; font-weight: 500; }
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .form-group { margin-bottom: 0; }
        .form-group.full { grid-column: 1 / -1; }
        .form-group label { display: block; font-size: 12px; font-weight: 500; color: #6B7280; margin-bottom: 8px; }
        .form-group label span { color: #DC2626; }
        input, select, textarea { width: 100%; background: #F9FAFB; border: 1px solid #EAECF0; color: #1A1F36; padding: 12px 16px; border-radius: 12px; font-size: 14px; font-family: 'Inter', sans-serif; }
        input:focus, select:focus, textarea:focus { outline: none; border-color: #2563EB; }
        textarea { resize: vertical; min-height: 100px; }
        .form-actions { display: flex; gap: 16px; margin-top: 28px; }
        .btn-submit { background: #2563EB; color: white; border: none; padding: 12px 32px; border-radius: 40px; font-size: 14px; font-weight: 600; cursor: pointer; }
        .btn-cancel { background: #F1F5F9; color: #6B7280; border: none; padding: 12px 28px; border-radius: 40px; font-size: 14px; font-weight: 500; text-decoration: none; }
        .dept-section { margin-top: 24px; padding-top: 24px; border-top: 2px solid #EAECF0; }
        .section-badge { padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 600; display: inline-block; margin-bottom: 16px; }
        .fire-badge { background: #FEE2E2; color: #DC2626; }
        .police-badge { background: #DBEAFE; color: #2563EB; }
        .rescue-badge { background: #D1FAE5; color: #10B981; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center; }
        .modal-content { background: white; border-radius: 24px; width: 420px; max-width: 90%; padding: 0; animation: slideIn 0.3s ease; overflow: hidden; }
        .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid #EAECF0; background: #F8FAFC; }
        .modal-header h2 { font-size: 18px; font-weight: 700; color: #1A1F36; }
        .modal-header h2 i { color: #2563EB; margin-right: 8px; }
        .close-modal { background: none; border: none; font-size: 24px; cursor: pointer; color: #94A3B8; }
        .close-modal:hover { color: #DC2626; }
        .profile-body { padding: 24px; }
        .profile-avatar { text-align: center; margin-bottom: 24px; }
        .profile-avatar .avatar-circle { width: 80px; height: 80px; background: linear-gradient(135deg, #2563EB, #1D4ED8); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto; }
        .profile-avatar .avatar-circle i { font-size: 40px; color: white; }
        .profile-avatar h3 { margin-top: 12px; font-size: 18px; font-weight: 700; }
        .profile-avatar p { font-size: 12px; color: #6B7280; margin-top: 4px; }
        .info-section { background: #F8FAFC; border-radius: 16px; padding: 4px 0; }
        .info-row { display: flex; align-items: center; padding: 14px 16px; border-bottom: 1px solid #EAECF0; }
        .info-row:last-child { border-bottom: none; }
        .info-icon { width: 36px; color: #2563EB; font-size: 16px; }
        .info-text { flex: 1; }
        .info-label { font-size: 11px; color: #6B7280; margin-bottom: 2px; text-transform: uppercase; }
        .info-value { font-size: 14px; font-weight: 600; color: #1A1F36; }
        .status-online { display: inline-flex; align-items: center; gap: 6px; background: #DCFCE7; padding: 4px 12px; border-radius: 30px; font-size: 11px; font-weight: 600; color: #166534; }
        @@keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        @@media (max-width: 768px) {
            .sidebar { width: 100%; position: relative; height: auto; }
            .main-content { margin-left: 0; padding: 20px; }
            .form-grid { grid-template-columns: 1fr; }
            .form-actions { flex-direction: column; }
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="logo"><i class="fas fa-city"></i><h2>SMART CIVIC <span>ALERT</span></h2></div>
                <div class="hamburger" id="toggleSidebar"><i class="fas fa-bars"></i></div>
            </div>
            <div class="nav-menu">
                <a href="/Operator/Dashboard" class="nav-item"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a>
                <a href="/Operator/Incidents" class="nav-item"><i class="fas fa-list-alt"></i> <span>Incidents</span></a>
                <a href="/Operator/CreateIncident" class="nav-item active"><i class="fas fa-plus-circle"></i> <span>Create Incident</span></a>
                <a href="/Operator/Notifications" class="nav-item">
                    <i class="fas fa-bell"></i> <span>My Notifications</span>
                    <span id="sidebarNotificationBadge" class="notification-badge-sidebar" style="display: none;">0</span>
                </a>
                <a href="#" class="nav-item" id="profileNavLink"><i class="fas fa-user-circle"></i> <span>My Profile</span></a>
            </div>
            <div class="dept-info"><i class="fas fa-building"></i><span>@dept Department</span></div>
            <div class="nav-footer"><a href="/Account/Logout" class="footer-item logout"><i class="fas fa-sign-out-alt"></i> <span>Logout</span></a></div>
        </div>

        <div class="main-content">
            <div class="page-header">
                <h1><i class="fas fa-plus-circle"></i> Create New Incident</h1>
                <p>@dept — Report a new civic incident</p>
            </div>
            <a href="/Operator/Incidents" class="back-link"><i class="fas fa-arrow-left"></i> Back to Incidents</a>

            <div class="card">
                <div class="card-title"><i class="fas fa-clipboard-list"></i> Incident Details</div>
                <form method="post" action="/Operator/CreateIncident">
                    <div class="dept-info-card"><i class="fas fa-building"></i> This incident will be assigned to: <strong>@dept Department</strong></div>
                    
                    <div class="form-grid">
                        <div class="form-group full"><label>Title <span>*</span></label><input type="text" name="Title" required /></div>
                        <div class="form-group full"><label>Description <span>*</span></label><textarea name="Description" required></textarea></div>
                        <div class="form-group full"><label>Location <span>*</span></label><input type="text" name="Location" required /></div>
                        <div class="form-group"><label>Severity <span>*</span></label><select name="Severity" required><option value="Low">Low</option><option value="Medium" selected>Medium</option><option value="High">High</option><option value="Critical">Critical</option></select></div>
                        <div class="form-group"><label>Latitude</label><input type="text" name="Latitude" /></div>
                        <div class="form-group"><label>Longitude</label><input type="text" name="Longitude" /></div>
                    </div>

                    <!-- Police Section -->
                    @if (dept == "Police")
                    {
                        <div class="dept-section">
                            <div class="section-badge police-badge"><i class="fas fa-gavel"></i> Police Case Details</div>
                            <div class="form-grid">
                                <div class="form-group"><label>Case Type</label><select name="CaseType"><option value="Theft">Theft</option><option value="Robbery">Robbery</option><option value="Accident">Accident</option><option value="Assault">Assault</option><option value="Missing Person">Missing Person</option></select></div>
                                <div class="form-group"><label>Complainant Name</label><input type="text" name="ComplainantName" /></div>
                                <div class="form-group"><label>Complainant Phone</label><input type="text" name="ComplainantPhone" /></div>
                                <div class="form-group"><label>Suspect Name</label><input type="text" name="SuspectName" /></div>
                                <div class="form-group"><label>Suspect Description</label><textarea name="SuspectDescription" rows="2"></textarea></div>
                                <div class="form-group"><label>Vehicle Number</label><input type="text" name="VehicleNumber" /></div>
                                <div class="form-group"><label>Assigned Officer</label><input type="text" name="AssignedOfficer" /></div>
                            </div>
                        </div>
                    }

                    <!-- Fire Section -->
                    @if (dept == "Fire")
                    {
                        <div class="dept-section">
                            <div class="section-badge fire-badge"><i class="fas fa-fire"></i> Fire Details</div>
                            <div class="form-grid">
                                <div class="form-group"><label>Fire Type</label><select name="FireType"><option value="Building Fire">Building Fire</option><option value="Vehicle Fire">Vehicle Fire</option><option value="Forest Fire">Forest Fire</option><option value="Electrical Fire">Electrical Fire</option><option value="Gas Leak">Gas Leak</option></select></div>
                                <div class="form-group"><label>Fire Source</label><select name="FireSource"><option value="Kitchen">Kitchen</option><option value="Electrical">Electrical</option><option value="Gas">Gas</option><option value="Chemical">Chemical</option></select></div>
                                <div class="form-group"><label>Fire Trucks</label><input type="number" name="FireTrucksDispatched" min="1" max="10" value="2" /></div>
                                <div class="form-group"><label>Firefighters</label><input type="number" name="FirefightersCount" min="2" max="50" value="8" /></div>
                                <div class="form-group"><label>Fire Status</label><select name="FireStatus"><option value="Dispatched">Dispatched</option><option value="En Route">En Route</option><option value="On Scene">On Scene</option><option value="Fighting Fire">Fighting Fire</option><option value="Fire Controlled">Fire Controlled</option><option value="Fire Extinguished">Fire Extinguished</option><option value="Resolved">Resolved</option></select></div>
                                <div class="form-group"><label>Evacuation</label><select name="IsEvacuationNeeded"><option value="false">No</option><option value="true">Yes - Evacuate</option></select></div>
                            </div>
                        </div>
                    }

                    <!-- Rescue Section -->
                    @if (dept == "Rescue")
                    {
                        <div class="dept-section">
                            <div class="section-badge rescue-badge"><i class="fas fa-truck-medical"></i> Rescue Details</div>
                            <div class="form-grid">
                                <div class="form-group"><label>Emergency Type</label><select name="EmergencyType"><option value="Cardiac Arrest">Cardiac Arrest</option><option value="Accident Injury">Accident Injury</option><option value="Burns">Burns</option><option value="Drowning">Drowning</option><option value="Fall Injury">Fall Injury</option><option value="Childbirth">Childbirth</option></select></div>
                                <div class="form-group"><label>Patient Condition</label><select name="PatientCondition"><option value="Critical">Critical</option><option value="Serious">Serious</option><option value="Stable">Stable</option></select></div>
                                <div class="form-group"><label>Ambulances</label><input type="number" name="AmbulancesDispatched" min="1" max="5" value="1" /></div>
                                <div class="form-group"><label>Paramedics</label><input type="number" name="ParamedicsCount" min="1" max="10" value="2" /></div>
                                <div class="form-group"><label>Hospital</label><input type="text" name="DestinationHospital" placeholder="Hospital name" /></div>
                                <div class="form-group"><label>Rescue Status</label><select name="RescueStatus"><option value="Ambulance Dispatched">Ambulance Dispatched</option><option value="En Route">En Route</option><option value="On Scene">On Scene</option><option value="Transporting">Transporting to Hospital</option><option value="Arrived at Hospital">Arrived at Hospital</option><option value="Resolved">Resolved</option></select></div>
                                <div class="form-group"><label>ETA (minutes)</label><input type="number" name="EstimatedArrivalMinutes" min="1" max="60" value="10" /></div>
                                <div class="form-group"><label>Oxygen Needed</label><select name="IsOxygenNeeded"><option value="false">No</option><option value="true">Yes</option></select></div>
                            </div>
                        </div>
                    }

                    <div class="form-actions">
                        <button type="submit" class="btn-submit"><i class="fas fa-save"></i> Create Incident</button>
                        <a href="/Operator/Incidents" class="btn-cancel"><i class="fas fa-times"></i> Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Profile Modal -->
    <div id="profileModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2><i class="fas fa-user-circle"></i> My Profile</h2>
                <button class="close-modal" onclick="closeProfileModal()">&times;</button>
            </div>
            <div class="profile-body">
                <div class="profile-avatar">
                    <div class="avatar-circle"><i class="fas fa-user-tie"></i></div>
                    <h3>@operatorName</h3>
                    <p><i class="fas fa-shield-alt"></i> @dept Department</p>
                </div>
                <div class="info-section">
                    <div class="info-row"><div class="info-icon"><i class="fas fa-user"></i></div><div class="info-text"><div class="info-label">Full Name</div><div class="info-value">@operatorName</div></div></div>
                    <div class="info-row"><div class="info-icon"><i class="fas fa-envelope"></i></div><div class="info-text"><div class="info-label">Email</div><div class="info-value">@operatorEmail</div></div></div>
                    <div class="info-row"><div class="info-icon"><i class="fas fa-building"></i></div><div class="info-text"><div class="info-label">Department</div><div class="info-value">@dept Department</div></div></div>
                    <div class="info-row"><div class="info-icon"><i class="fas fa-user-tag"></i></div><div class="info-text"><div class="info-label">Role</div><div class="info-value">Operator</div></div></div>
                    <div class="info-row"><div class="info-icon"><i class="fas fa-circle"></i></div><div class="info-text"><div class="info-label">Status</div><div class="info-value"><span class="status-online"><i class="fas fa-circle"></i> Online</span></div></div></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggleSidebar');
        toggleBtn.addEventListener('click', function() { sidebar.classList.toggle('collapsed'); });
        
        function openProfileModal() { document.getElementById('profileModal').style.display = 'flex'; }
        function closeProfileModal() { document.getElementById('profileModal').style.display = 'none'; }
        
        document.getElementById('profileNavLink')?.addEventListener('click', function(e) { e.preventDefault(); openProfileModal(); });
        
        async function updateNotificationCount() {
            try {
                const response = await fetch('/Operator/GetNotificationCount');
                const data = await response.json();
                const sidebarBadge = document.getElementById('sidebarNotificationBadge');
                if (sidebarBadge) {
                    if (data.count > 0) { sidebarBadge.style.display = 'inline'; sidebarBadge.innerText = data.count > 99 ? '99+' : data.count; }
                    else { sidebarBadge.style.display = 'none'; }
                }
            } catch(err) { console.error('Count error:', err); }
        }
        
        updateNotificationCount();
    </script>
</body>
</html>