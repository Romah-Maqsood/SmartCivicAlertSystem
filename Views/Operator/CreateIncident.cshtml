@model SmartCityPulse.Models.Incident
@{
    ViewData["Title"] = "Create Incident";
    Layout = null;
    string operatorName = ViewBag.OperatorName ?? "";
    string dept = ViewBag.Department ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Incident - @dept Department</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #E8EDF5;
            color: #1A1F36;
        }

        .dashboard {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 260px;
            background: #FFFFFF;
            border-right: 1px solid #EAECF0;
            position: fixed;
            height: 100vh;
            display: flex;
            flex-direction: column;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 100;
        }

        .sidebar.collapsed {
            width: 72px;
        }

        .sidebar.collapsed .logo h2,
        .sidebar.collapsed .nav-item span,
        .sidebar.collapsed .footer-item span {
            display: none;
        }

        .sidebar.collapsed .nav-item,
        .sidebar.collapsed .footer-item {
            justify-content: center;
            padding: 12px 0;
        }

        .sidebar.collapsed .nav-item i,
        .sidebar.collapsed .footer-item i {
            margin: 0;
            font-size: 20px;
        }

        .sidebar.collapsed .sidebar-header {
            justify-content: center;
            padding: 20px 0;
        }

        .sidebar.collapsed .logo {
            justify-content: center;
        }

        .sidebar-header {
            padding: 20px 16px;
            border-bottom: 1px solid #EAECF0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo i {
            font-size: 24px;
            color: #2563EB;
        }

        .logo h2 {
            font-size: 15px;
            font-weight: 700;
            color: #1A1F36;
            letter-spacing: -0.3px;
        }

        .logo span {
            color: #2563EB;
        }

        .hamburger {
            cursor: pointer;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.2s ease;
            color: #6B7280;
        }

        .hamburger:hover {
            background: #F1F5F9;
            color: #2563EB;
        }

        .hamburger i {
            font-size: 18px;
        }

        .nav-menu {
            flex: 1;
            padding: 20px 12px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            margin: 2px 0;
            color: #5A6A7F;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.2s ease;
            border-radius: 10px;
        }

        .nav-item i {
            width: 20px;
            font-size: 16px;
        }

        .nav-item:hover {
            background: #F1F5F9;
            color: #2563EB;
        }

        .nav-item.active {
            background: #EFF6FF;
            color: #2563EB;
        }

        .nav-footer {
            padding: 16px 12px;
            border-top: 1px solid #EAECF0;
        }

        .footer-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            color: #5A6A7F;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            border-radius: 10px;
            transition: all 0.2s ease;
        }

        .footer-item:hover {
            background: #F1F5F9;
            color: #2563EB;
        }

        .footer-item.logout {
            color: #DC2626;
        }

        .footer-item.logout:hover {
            background: #FEF2F2;
        }

        .dept-info {
            padding: 8px 16px;
            margin: 0 12px 12px 12px;
            background: #EFF6FF;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: #2563EB;
        }

        .main-content {
            margin-left: 260px;
            flex: 1;
            padding: 24px 32px;
            background: #E8EDF5;
            transition: margin-left 0.3s ease;
            min-height: 100vh;
        }

        .sidebar.collapsed ~ .main-content {
            margin-left: 72px;
        }

        /* Page Header */
        .page-header {
            margin-bottom: 24px;
        }

        .page-header h1 {
            font-size: 22px;
            font-weight: 700;
            color: #1A1F36;
        }

        .page-header h1 i {
            color: #2563EB;
            margin-right: 8px;
        }

        .page-header p {
            font-size: 13px;
            color: #6B7280;
            margin-top: 6px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #6B7280;
            text-decoration: none;
            font-size: 13px;
            margin-bottom: 24px;
            transition: color 0.2s ease;
        }

        .back-link:hover {
            color: #2563EB;
        }

        /* Card */
        .card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 32px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        }

        .card-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #1A1F36;
        }

        .card-title i {
            color: #2563EB;
        }

        /* Department Info */
        .dept-info-card {
            background: #EFF6FF;
            border: 1px solid #DBEAFE;
            border-radius: 12px;
            padding: 14px 18px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: #1D4ED8;
            font-size: 14px;
            font-weight: 500;
        }

        .dept-info-card i {
            font-size: 18px;
        }

        /* Form */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .form-group {
            margin-bottom: 0;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 500;
            color: #6B7280;
            margin-bottom: 8px;
        }

        .form-group label span {
            color: #DC2626;
        }

        input, select, textarea {
            width: 100%;
            background: #F9FAFB;
            border: 1px solid #EAECF0;
            color: #1A1F36;
            padding: 12px 16px;
            border-radius: 12px;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            transition: all 0.2s ease;
        }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #2563EB;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        input::placeholder, textarea::placeholder {
            color: #A0AEC0;
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        /* Form Actions */
        .form-actions {
            display: flex;
            gap: 16px;
            margin-top: 28px;
        }

        .btn-submit {
            background: #2563EB;
            color: white;
            border: none;
            padding: 12px 32px;
            border-radius: 40px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-submit:hover {
            background: #1D4ED8;
            transform: translateY(-1px);
        }

        .btn-cancel {
            background: #F1F5F9;
            color: #6B7280;
            border: none;
            padding: 12px 28px;
            border-radius: 40px;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-cancel:hover {
            background: #E2E8F0;
            color: #1A1F36;
        }

        @@media (max-width: 768px) {
            .sidebar {
                width: 100%;
                position: relative;
                height: auto;
            }
            .main-content {
                margin-left: 0;
                padding: 20px;
            }
            .form-grid {
                grid-template-columns: 1fr;
            }
            .form-actions {
                flex-direction: column;
            }
            .btn-submit, .btn-cancel {
                text-align: center;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <i class="fas fa-city"></i>
                    <h2>SMART CIVIC <span>ALERT</span></h2>
                </div>
                <div class="hamburger" id="toggleSidebar">
                    <i class="fas fa-bars"></i>
                </div>
            </div>

            <div class="nav-menu">
                <a href="/Operator/Dashboard" class="nav-item">
                    <i class="fas fa-chart-pie"></i> <span>Dashboard</span>
                </a>
                <a href="/Operator/Incidents" class="nav-item">
                    <i class="fas fa-list-alt"></i> <span>Incidents</span>
                </a>
                <a href="/Operator/CreateIncident" class="nav-item active">
                    <i class="fas fa-plus-circle"></i> <span>Create Incident</span>
                </a>
            </div>

            <div class="dept-info">
                <i class="fas fa-building"></i>
                <span>@dept Department</span>
            </div>

            <div class="nav-footer">
                <a href="/Account/Logout" class="footer-item logout">
                    <i class="fas fa-sign-out-alt"></i> <span>Logout</span>
                </a>
            </div>
        </div>

        <div class="main-content">
            <div class="page-header">
                <h1><i class="fas fa-plus-circle"></i> Create New Incident</h1>
                <p>@dept — Report a new civic incident</p>
            </div>

            <a href="/Operator/Incidents" class="back-link">
                <i class="fas fa-arrow-left"></i> Back to Incidents
            </a>

            <div class="card">
                <div class="card-title">
                    <i class="fas fa-clipboard-list"></i> Incident Details
                </div>

                <form method="post" action="/Operator/CreateIncident">
                    <div class="dept-info-card">
                        <i class="fas fa-building"></i>
                        This incident will be assigned to: <strong>@dept Department</strong>
                    </div>

                    <div class="form-grid">
                        <div class="form-group full">
                            <label>Title <span>*</span></label>
                            <input type="text" name="Title" placeholder="e.g. Market Fire in Gulshan" required />
                        </div>

                        <div class="form-group full">
                            <label>Description <span>*</span></label>
                            <textarea name="Description" placeholder="Describe the incident in detail..." required></textarea>
                        </div>

                        <div class="form-group full">
                            <label>Location <span>*</span></label>
                            <input type="text" name="Location" placeholder="e.g. Gulshan Chowrangi, Near KFC, Karachi" required />
                        </div>

                        <div class="form-group">
                            <label>Severity <span>*</span></label>
                            <select name="Severity" required>
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Latitude (Optional)</label>
                            <input type="text" name="Latitude" placeholder="e.g. 24.8607" />
                        </div>

                        <div class="form-group">
                            <label>Longitude (Optional)</label>
                            <input type="text" name="Longitude" placeholder="e.g. 67.0011" />
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-submit">
                            <i class="fas fa-save"></i> Create Incident
                        </button>
                        <a href="/Operator/Incidents" class="btn-cancel">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggleSidebar');
        toggleBtn.addEventListener('click', function() {
            sidebar.classList.toggle('collapsed');
        });
    </script>
</body>
</html>