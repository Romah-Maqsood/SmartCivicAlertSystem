@model SmartCityPulse.Models.OperatorDashboardViewModel
@{
    ViewData["Title"] = "Operator Dashboard";
    Layout = null;
    string operatorName = ViewBag.OperatorName ?? "";
    string dept = ViewBag.Department ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Operator Dashboard - @dept Department</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #E8EDF5;
            color: #1A1F36;
        }

        .dashboard {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            background: #FFFFFF;
            border-right: 1px solid #EAECF0;
            position: fixed;
            height: 100vh;
            display: flex;
            flex-direction: column;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 100;
        }

        .sidebar.collapsed {
            width: 72px;
        }

        .sidebar.collapsed .logo h2,
        .sidebar.collapsed .nav-item span,
        .sidebar.collapsed .footer-item span {
            display: none;
        }

        .sidebar.collapsed .nav-item,
        .sidebar.collapsed .footer-item {
            justify-content: center;
            padding: 12px 0;
        }

        .sidebar.collapsed .nav-item i,
        .sidebar.collapsed .footer-item i {
            margin: 0;
            font-size: 20px;
        }

        .sidebar.collapsed .sidebar-header {
            justify-content: center;
            padding: 20px 0;
        }

        .sidebar.collapsed .logo {
            justify-content: center;
        }

        .sidebar-header {
            padding: 20px 16px;
            border-bottom: 1px solid #EAECF0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo i {
            font-size: 24px;
            color: #2563EB;
        }

        .logo h2 {
            font-size: 15px;
            font-weight: 700;
            color: #1A1F36;
            letter-spacing: -0.3px;
        }

        .logo span {
            color: #2563EB;
        }

        .hamburger {
            cursor: pointer;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.2s ease;
            color: #6B7280;
        }

        .hamburger:hover {
            background: #F1F5F9;
            color: #2563EB;
        }

        .hamburger i {
            font-size: 18px;
        }

        .nav-menu {
            flex: 1;
            padding: 20px 12px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            margin: 2px 0;
            color: #5A6A7F;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.2s ease;
            border-radius: 10px;
        }

        .nav-item i {
            width: 20px;
            font-size: 16px;
        }

        .nav-item:hover {
            background: #F1F5F9;
            color: #2563EB;
        }

        .nav-item.active {
            background: #EFF6FF;
            color: #2563EB;
        }

        .nav-footer {
            padding: 16px 12px;
            border-top: 1px solid #EAECF0;
        }

        .footer-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            color: #5A6A7F;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            border-radius: 10px;
            transition: all 0.2s ease;
        }

        .footer-item:hover {
            background: #F1F5F9;
            color: #2563EB;
        }

        .footer-item.logout {
            color: #DC2626;
        }

        .footer-item.logout:hover {
            background: #FEF2F2;
        }

        .dept-info {
            padding: 8px 16px;
            margin: 0 12px 12px 12px;
            background: #EFF6FF;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: #2563EB;
        }

        .main-content {
            margin-left: 260px;
            flex: 1;
            padding: 24px 32px;
            background: #E8EDF5;
            transition: margin-left 0.3s ease;
            min-height: 100vh;
        }

        .sidebar.collapsed ~ .main-content {
            margin-left: 72px;
        }

        .welcome-header {
            margin-bottom: 28px;
        }

        .welcome-header h1 {
            font-size: 22px;
            font-weight: 700;
            color: #1A1F36;
        }

        .welcome-header h1 i {
            color: #2563EB;
            margin-right: 8px;
            font-size: 20px;
        }

        .welcome-header p {
            font-size: 13px;
            color: #6B7280;
            margin-top: 6px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 18px 20px;
            transition: all 0.3s ease;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
        }

        .stat-card:nth-child(1)::before { background: #3B82F6; }
        .stat-card:nth-child(2)::before { background: #F59E0B; }
        .stat-card:nth-child(3)::before { background: #10B981; }
        .stat-card:nth-child(4)::before { background: #EF4444; }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
        }

        .stat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .stat-header .stat-label {
            font-size: 12px;
            font-weight: 500;
            color: #6B7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-header i {
            font-size: 24px;
            opacity: 0.7;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 800;
            color: #1A1F36;
            margin-bottom: 6px;
        }

        .row-2cols {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 28px;
        }

        .chart-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        }

        .card-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        .card-title h3 {
            font-size: 14px;
            font-weight: 600;
            color: #1A1F36;
        }

        .card-title h3 i {
            color: #2563EB;
            margin-right: 6px;
        }

        canvas {
            max-height: 200px;
            width: 100%;
        }

        .quick-action-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
            border-top: 3px solid #2563EB;
        }

        .quick-action-card h3 {
            font-size: 14px;
            font-weight: 600;
            color: #1A1F36;
            margin-bottom: 8px;
        }

        .quick-action-card p {
            font-size: 12px;
            color: #6B7280;
            margin-bottom: 16px;
        }

        .btn-primary {
            background: #2563EB;
            color: white;
            padding: 8px 16px;
            border-radius: 40px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            width: fit-content;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-primary:hover {
            background: #1D4ED8;
            transform: translateY(-1px);
        }

        .critical-alert {
            background: #FEF2F2;
            border-left: 3px solid #DC2626;
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .critical-alert i {
            color: #DC2626;
            margin-right: 8px;
        }

        .recent-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        }

        .table-responsive {
            overflow-x: auto;
        }

        .incident-table {
            width: 100%;
            border-collapse: collapse;
        }

        .incident-table th {
            text-align: left;
            padding: 10px 0;
            color: #6B7280;
            font-size: 11px;
            font-weight: 500;
            border-bottom: 1px solid #EAECF0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .incident-table td {
            padding: 10px 0;
            font-size: 12px;
            color: #1A1F36;
            border-bottom: 1px solid #EAECF0;
        }

        .status-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 50px;
            font-size: 10px;
            font-weight: 500;
        }

        .status-resolved {
            background: #DCFCE7;
            color: #166534;
        }

        .status-progress {
            background: #FEF3C7;
            color: #92400E;
        }

        .status-open {
            background: #DBEAFE;
            color: #1E40AF;
        }

        .severity-critical {
            color: #DC2626;
            font-weight: 600;
        }

        .severity-high {
            color: #F97316;
            font-weight: 600;
        }

        .severity-medium {
            color: #EAB308;
            font-weight: 600;
        }

        .severity-low {
            color: #10B981;
            font-weight: 600;
        }

        .action-link {
            color: #2563EB;
            text-decoration: none;
            font-size: 11px;
        }

        @@media (max-width: 1024px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .row-2cols {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .sidebar {
                width: 100%;
                position: relative;
                height: auto;
            }
            .sidebar.collapsed {
                width: 100%;
            }
            .main-content {
                margin-left: 0;
                padding: 20px;
            }
            .sidebar.collapsed ~ .main-content {
                margin-left: 0;
            }
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <i class="fas fa-city"></i>
                    <h2>SMART CIVIC <span>ALERT</span></h2>
                </div>
                <div class="hamburger" id="toggleSidebar">
                    <i class="fas fa-bars"></i>
                </div>
            </div>

            <div class="nav-menu">
                <a href="/Operator/Dashboard" class="nav-item active">
                    <i class="fas fa-chart-pie"></i> <span>Dashboard</span>
                </a>
                <a href="/Operator/Incidents" class="nav-item">
                    <i class="fas fa-list-alt"></i> <span>Incidents</span>
                </a>
                <a href="/Operator/CreateIncident" class="nav-item">
                    <i class="fas fa-plus-circle"></i> <span>Create Incident</span>
                </a>
            </div>

            <div class="dept-info">
                <i class="fas fa-building"></i>
                <span>@dept Department</span>
            </div>

            <div class="nav-footer">
                <a href="/Account/Logout" class="footer-item logout">
                    <i class="fas fa-sign-out-alt"></i> <span>Logout</span>
                </a>
            </div>
        </div>

        <div class="main-content">
            <div class="welcome-header">
                <h1><i class="fas fa-hand-wave"></i> Welcome back, @operatorName!</h1>
                <p>@dept Department Dashboard — Monitor and manage incidents in real-time</p>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-label">New Today</span>
                        <i class="fas fa-calendar-day"></i>
                    </div>
                    <div class="stat-value">@ViewBag.NewToday</div>
                </div>
                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-label">In Progress</span>
                        <i class="fas fa-spinner"></i>
                    </div>
                    <div class="stat-value">@ViewBag.InProgress</div>
                </div>
                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-label">Resolved</span>
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-value">@ViewBag.Resolved</div>
                </div>
                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-label">Total</span>
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div class="stat-value">@ViewBag.Total</div>
                </div>
            </div>

            <div class="row-2cols">
                <div class="chart-card">
                    <div class="card-title">
                        <h3><i class="fas fa-chart-line"></i> Last 7 Days Trend</h3>
                    </div>
                    <canvas id="trendChart"></canvas>
                </div>
                <div class="quick-action-card">
                    <h3><i class="fas fa-plus-circle"></i> Quick Action</h3>
                    <p>Create a new incident report for your department</p>
                    <a href="/Operator/CreateIncident" class="btn-primary">
                        <i class="fas fa-plus"></i> New Incident
                    </a>
                </div>
            </div>

            <div class="row-2cols">
                <div class="chart-card">
                    <div class="card-title">
                        <h3><i class="fas fa-chart-pie"></i> Severity Distribution</h3>
                    </div>
                    <canvas id="severityChart"></canvas>
                </div>
                <div class="chart-card">
                    <div class="card-title">
                        <h3><i class="fas fa-chart-donut"></i> Status Distribution</h3>
                    </div>
                    <canvas id="statusChart"></canvas>
                </div>
            </div>

            @if (ViewBag.CriticalCount > 0)
            {
                <div class="critical-alert">
                    <div>
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>@ViewBag.CriticalCount critical incidents</strong> require immediate attention!
                    </div>
                    <a href="/Operator/Incidents?severity=Critical" style="color:#DC2626; text-decoration:none; font-size:12px;">View Details →</a>
                </div>
            }

            <div class="recent-card">
                <div class="card-title">
                    <h3><i class="fas fa-history"></i> Recent Incidents</h3>
                    <a href="/Operator/Incidents" style="font-size:11px; color:#2563EB; text-decoration:none;">View All →</a>
                </div>
                <div class="table-responsive">
                    <table class="incident-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Location</th>
                                <th>Severity</th>
                                <th>Status</th>
                                <th>Reported</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentIncidents.Any())
                            {
                                <tr>
                                    <td colspan="7" style="text-align:center; padding:40px; color:#6B7280;">
                                        <i class="fas fa-inbox" style="font-size:32px; margin-bottom:8px; display:block;"></i>
                                        No incidents reported yet
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var incident in Model.RecentIncidents.Take(5))
                                {
                                    <tr>
                                        <td>#@(incident.Id?.Length >= 6 ? incident.Id.Substring(0, 6) : incident.Id)</td>
                                        <td>@(incident.Title?.Length > 30 ? incident.Title.Substring(0, 27) + "..." : incident.Title)</td>
                                        <td>@(incident.Location?.Length > 20 ? incident.Location.Substring(0, 17) + "..." : incident.Location)</td>
                                        <td class="severity-@(incident.Severity?.ToLower())">@incident.Severity</td>
                                        <td>
                                            <span class="status-badge status-@(incident.Status?.ToLower().Replace(" ", ""))">
                                                @incident.Status
                                            </span>
                                        </td>
                                        <td>@incident.ReportedAt.ToString("MMM dd, hh:mm tt")</td>
                                        <td>
                                            <a href="/Operator/IncidentDetail/@incident.Id" class="action-link">
                                                <i class="fas fa-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggleSidebar');
        toggleBtn.addEventListener('click', function() {
            sidebar.classList.toggle('collapsed');
        });

        const trendCtx = document.getElementById('trendChart').getContext('2d');
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: ['6 days ago', '5 days ago', '4 days ago', '3 days ago', '2 days ago', 'Yesterday', 'Today'],
                datasets: [{
                    label: 'Incidents',
                    data: @Html.Raw(ViewBag.Last7Days ?? "[0,0,0,0,0,0,0]"),
                    borderColor: '#2563EB',
                    backgroundColor: 'rgba(37, 99, 235, 0.05)',
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#2563EB',
                    pointBorderColor: '#fff',
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { position: 'top', labels: { boxWidth: 10, font: { size: 10 } } }
                },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#EAECF0' }, ticks: { stepSize: 1, font: { size: 10 } } },
                    x: { grid: { display: false }, ticks: { font: { size: 10 } } }
                }
            }
        });

        const severityCtx = document.getElementById('severityChart').getContext('2d');
        new Chart(severityCtx, {
            type: 'doughnut',
            data: {
                labels: ['Critical', 'High', 'Medium', 'Low'],
                datasets: [{
                    data: [@ViewBag.CriticalCount, @ViewBag.HighCount, @ViewBag.MediumCount, @ViewBag.LowCount],
                    backgroundColor: ['#DC2626', '#F97316', '#EAB308', '#10B981'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } }
                }
            }
        });

        const statusCtx = document.getElementById('statusChart').getContext('2d');
        new Chart(statusCtx, {
            type: 'pie',
            data: {
                labels: ['Open', 'In Progress', 'Resolved'],
                datasets: [{
                    data: [@ViewBag.OpenCount, @ViewBag.InProgressCount, @ViewBag.ResolvedCount],
                    backgroundColor: ['#2563EB', '#F59E0B', '#10B981'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } }
                }
            }
        });
    </script>
</body>
</html>