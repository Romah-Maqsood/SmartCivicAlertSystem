<!-- INCIDENTS SECTION -->
<div id="incidentsSection" class="hide">
    <div class="section-header">
        <h2 class="section-title"><i class="fas fa-list-alt"></i> All Incidents</h2>
    </div>
    <div class="filter-bar">
        <select id="statusFilter">
            <option value="">All Status</option>
            <option value="Open">Open</option>
            <option value="In Progress">In Progress</option>
            <option value="Resolved">Resolved</option>
        </select>
        <select id="severityFilter">
            <option value="">All Severity</option>
            <option value="Critical">Critical</option>
            <option value="High">High</option>
            <option value="Medium">Medium</option>
            <option value="Low">Low</option>
        </select>
        <button class="btn-primary btn-sm" onclick="loadAllIncidents()"><i class="fas fa-filter"></i> Filter</button>
        <button class="btn-ghost btn-sm" onclick="clearFilters()"><i class="fas fa-times"></i> Clear</button>
    </div>

    <!-- Incident List View -->
    <div id="incidentListView">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Title</th><th>Location</th><th>Department</th>
                        <th>Severity</th><th>Status</th><th>Reported At</th><th>Action</th>
                    </tr>
                </thead>
                <tbody id="allIncidentsTable">
                    <tr><td colspan="7"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Loading...</p></div></td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Incident Detail View (hidden by default) -->
    <div id="incidentDetailView" class="hide">
        <button class="btn-primary btn-sm" onclick="backToIncidentList()" style="margin-bottom:16px;">
            <i class="fas fa-arrow-left"></i> Back to Incidents
        </button>
        <div id="incidentDetailContent" class="chart-card" style="padding:28px;">
            <!-- Detail will be loaded via AJAX -->
        </div>
    </div>
</div>

<!-- OPERATORS SECTION -->
<div id="operatorsSection" class="hide">
    <div class="section-header">
        <h2 class="section-title"><i class="fas fa-users-cog"></i> Operators Management</h2>
        <button class="btn-primary" onclick="openAddOperatorModal()"><i class="fas fa-plus"></i> Add Operator</button>
    </div>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr><th>Name</th><th>Email</th><th>Phone</th><th>Department</th><th>Actions</th></tr>
            </thead>
            <tbody id="operatorsTable">
                <tr><td colspan="5"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Loading...</p></div></td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- CITIZENS SECTION -->
<div id="citizensSection" class="hide">
    <div class="section-header">
        <h2 class="section-title"><i class="fas fa-user"></i> Citizens Management</h2>
    </div>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Actions</th></tr>
            </thead>
            <tbody id="citizensTable">
                <tr><td colspan="5"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Loading...</p></div></td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- JavaScript functions for incident detail (embedded) -->
<script>
    // Show incident detail in-place
    async function viewIncidentDetail(incidentId) {
        const detailContainer = document.getElementById('incidentDetailContent');
        if (!detailContainer) return;

        detailContainer.innerHTML = '<p style="color:var(--text-secondary);">Loading...</p>';
        document.getElementById('incidentListView').classList.add('hide');
        document.getElementById('incidentDetailView').classList.remove('hide');

        try {
            const res = await fetch(`/Admin/GetIncidentDetailJson?id=${incidentId}`, { credentials: 'same-origin' });
            if (!res.ok) throw new Error('Incident not found');
            const inc = await res.json();

            const severityClass = `severity-${inc.severity.toLowerCase()}`;
            const statusClass = `status-${inc.status.toLowerCase().replace(' ', '')}`;
            const statusIcon = inc.status === 'Resolved' ? 'fa-check-circle' : 'fa-hourglass-half';

            let citizenHtml = '';
            if (inc.citizen) {
                citizenHtml = `
                    <div class="citizen-card">
                        <div class="citizen-name">${escapeHtml(inc.citizen.name)}</div>
                        <div class="citizen-meta"><i class="fas fa-envelope"></i> ${escapeHtml(inc.citizen.email)}</div>
                        <div class="citizen-meta"><i class="fas fa-phone"></i> ${escapeHtml(inc.citizen.phone || 'N/A')}</div>
                        <div class="citizen-meta"><i class="fas fa-user-tag"></i> Role: ${escapeHtml(inc.citizen.role)}</div>
                    </div>`;
            } else {
                citizenHtml = '<div class="unknown-citizen"><i class="fas fa-user-slash"></i> Unknown Citizen (Reported without login)</div>';
            }

            detailContainer.innerHTML = `
                <div class="detail-header">
                    <div>
                        <div class="detail-title">${escapeHtml(inc.title)}</div>
                        <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;">
                            <span class="badge ${severityClass}"><i class="fas fa-exclamation-circle" style="font-size:10px;"></i> ${escapeHtml(inc.severity)}</span>
                            <span class="badge ${statusClass}"><i class="fas ${statusIcon}" style="font-size:10px;"></i> ${escapeHtml(inc.status)}</span>
                        </div>
                    </div>
                </div>
                <div class="detail-grid">
                    <div class="info-block">
                        <div class="info-label"><i class="fas fa-map-marker-alt"></i> Location</div>
                        <div class="info-value">${escapeHtml(inc.location || 'Not specified')}</div>
                    </div>
                    <div class="info-block">
                        <div class="info-label"><i class="fas fa-building"></i> Department</div>
                        <div class="info-value">${escapeHtml(inc.department || 'Unassigned')}</div>
                    </div>
                    <div class="info-block">
                        <div class="info-label"><i class="fas fa-calendar-alt"></i> Reported At</div>
                        <div class="info-value">${new Date(inc.reportedAt).toLocaleString()}</div>
                    </div>
                    <div class="info-block">
                        <div class="info-label"><i class="fas fa-clock"></i> Last Updated</div>
                        <div class="info-value">${new Date(inc.updatedAt).toLocaleString()}</div>
                    </div>
                    <div class="info-block description-block">
                        <div class="info-label"><i class="fas fa-align-left"></i> Description</div>
                        <div class="description-text">${escapeHtml(inc.description || 'No description provided.')}</div>
                    </div>
                </div>
                <div class="citizen-section">
                    <div class="section-title"><i class="fas fa-user"></i> Reported By</div>
                    ${citizenHtml}
                </div>`;

            // Log activity (if the function exists globally)
            if (typeof logActivity === 'function') {
                logActivity('view', 'Viewed Incident: ' + inc.title, 'Incident Detail');
            }
        } catch (err) {
            detailContainer.innerHTML = '<p style="color:var(--red);">Error loading incident details.</p>';
            console.error(err);
        }
    }

    // Return to incident list
    function backToIncidentList() {
        document.getElementById('incidentDetailView').classList.add('hide');
        document.getElementById('incidentListView').classList.remove('hide');
        loadAllIncidents();  // refresh the list
    }
</script>