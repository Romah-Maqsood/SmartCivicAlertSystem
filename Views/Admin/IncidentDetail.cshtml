@model SmartCityPulse.Models.Incident
@{
    Layout = null;
    ViewData["Title"] = "Incident Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Smart Civic</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --bg-page: #E8EDF5;
            --bg-card: #FFFFFF;
            --border: #EAECF0;
            --text-primary: #1A1F36;
            --text-secondary: #6B7280;
            --blue: #2563EB;
            --blue-dark: #1D4ED8;
            --blue-light: #EFF6FF;
            --red: #DC2626;
            --green: #10B981;
            --yellow: #F59E0B;
            --radius-card: 16px;
            --radius-btn: 40px;
            --shadow-card: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
            --shadow-hover: 0 8px 24px rgba(37,99,235,0.12);
            --transition: all 0.2s ease;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-page);
            color: var(--text-primary);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            padding: 2rem;
        }
        .container {
            width: 100%;
            max-width: 900px;
        }

        /* Back button – outlined style */
        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 18px;
            border-radius: var(--radius-btn);
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: var(--transition);
            margin-bottom: 24px;
            background: white;
            color: var(--blue);
            border: 1.5px solid var(--blue);
            box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        }
        .btn-back:hover {
            background: var(--blue);
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(37,99,235,0.25);
        }
        .btn-back i { font-size: 12px; }

        .detail-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-card);
            padding: 32px;
            box-shadow: var(--shadow-card);
        }
        .detail-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 28px;
        }
        .detail-title {
            font-size: 22px;
            font-weight: 800;
            color: var(--text-primary);
            line-height: 1.3;
            margin-bottom: 8px;
        }
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 14px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }
        .severity-critical { background: #FEE2E2; color: #991B1B; }
        .severity-high     { background: #FFEDD5; color: #9A3412; }
        .severity-medium   { background: #FEF3C7; color: #92400E; }
        .severity-low      { background: #DCFCE7; color: #166534; }
        .status-open       { background: #DBEAFE; color: #1E40AF; }
        .status-inprogress { background: #FEF3C7; color: #92400E; }
        .status-resolved   { background: #DCFCE7; color: #166534; }
        .detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 28px;
        }
        .info-block {
            background: #F9FAFB;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 16px;
            transition: var(--transition);
        }
        .info-block:hover {
            border-color: #D1D5DB;
            background: white;
        }
        .info-label {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.6px;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .info-label i { color: var(--blue); font-size: 12px; }
        .info-value { font-size: 14px; font-weight: 600; color: var(--text-primary); }
        .description-block { grid-column: span 2; }
        .description-text {
            font-size: 14px;
            color: var(--text-primary);
            line-height: 1.6;
            white-space: pre-wrap;
        }
        .citizen-section {
            border-top: 1px solid var(--border);
            padding-top: 24px;
            margin-top: 8px;
        }
        .section-title {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .section-title i { color: var(--blue); }

        /* Citizen info – displayed exactly like incident detail blocks */
        .citizen-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .loading-text { color: var(--text-secondary); font-size: 14px; }
        .error-text { color: var(--red); font-size: 14px; }
        .unknown-citizen {
            color: var(--text-secondary);
            font-style: italic;
            font-size: 14px;
            padding: 12px 0;
        }

        @@media (max-width: 768px) {
            body { padding: 1rem; }
            .detail-grid, .citizen-grid { grid-template-columns: 1fr; }
            .description-block { grid-column: span 1; }
        }
    </style>
</head>
<body>
<div class="container">
    <!-- Beautiful outlined Back button -->
    <button class="btn-back" onclick="goBack()">
        <i class="fas fa-arrow-left"></i> Back
    </button>

    <div class="detail-card">
        <div class="detail-header">
            <div>
                <div class="detail-title">@Model.Title</div>
                <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;">
                    <span class="badge severity-@Model.Severity.ToLower()">
                        <i class="fas fa-exclamation-circle" style="font-size:10px;"></i> @Model.Severity
                    </span>
                    <span class="badge status-@Model.Status.ToLower().Replace(" ","")">
                        <i class="fas @(Model.Status == "Resolved" ? "fa-check-circle" : "fa-hourglass-half")" style="font-size:10px;"></i> @Model.Status
                    </span>
                </div>
            </div>
        </div>

        <div class="detail-grid">
            <div class="info-block">
                <div class="info-label"><i class="fas fa-map-marker-alt"></i> Location</div>
                <div class="info-value">@(Model.Location ?? "Not specified")</div>
            </div>
            <div class="info-block">
                <div class="info-label"><i class="fas fa-building"></i> Department</div>
                <div class="info-value">@(Model.Department ?? "Unassigned")</div>
            </div>
            <div class="info-block">
                <div class="info-label"><i class="fas fa-calendar-alt"></i> Reported At</div>
                <div class="info-value">@Model.ReportedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
            </div>
            <div class="info-block">
                <div class="info-label"><i class="fas fa-clock"></i> Last Updated</div>
                <div class="info-value">@Model.UpdatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
            </div>
            <div class="info-block description-block">
                <div class="info-label"><i class="fas fa-align-left"></i> Description</div>
                <div class="description-text">@(Model.Description ?? "No description provided.")</div>
            </div>
        </div>

        <!-- Reporter Section – same info‑block style -->
        <div class="citizen-section">
            <div class="section-title"><i class="fas fa-user"></i> Reported By</div>
            <div id="citizenInfoContainer" class="loading-text">
                <i class="fas fa-spinner fa-spin"></i> Loading reporter information...
            </div>
        </div>
    </div>
</div>

<script>
    function goBack() {
        if (document.referrer) {
            window.history.back();
        } else {
            window.location.href = '/Admin/Index';
        }
    }

    document.addEventListener('DOMContentLoaded', async function() {
        const container = document.getElementById('citizenInfoContainer');
        try {
            const response = await fetch(`/Admin/GetIncidentDetailJson?id=@Model.Id`, {
                credentials: 'same-origin'
            });
            if (!response.ok) throw new Error('Failed to fetch');
            const data = await response.json();

            if (data.citizen) {
                // Display citizen in a 2‑column grid just like incident detail
                container.innerHTML = `
                    <div class="citizen-grid">
                        <div class="info-block">
                            <div class="info-label"><i class="fas fa-user"></i> Name</div>
                            <div class="info-value">${escapeHtml(data.citizen.name)}</div>
                        </div>
                        <div class="info-block">
                            <div class="info-label"><i class="fas fa-envelope"></i> Email</div>
                            <div class="info-value">${escapeHtml(data.citizen.email)}</div>
                        </div>
                        <div class="info-block">
                            <div class="info-label"><i class="fas fa-phone"></i> Phone</div>
                            <div class="info-value">${escapeHtml(data.citizen.phone || 'N/A')}</div>
                        </div>
                        <div class="info-block">
                            <div class="info-label"><i class="fas fa-user-tag"></i> Role</div>
                            <div class="info-value">${escapeHtml(data.citizen.role)}</div>
                        </div>
                    </div>`;
            } else {
                container.innerHTML = '<div class="unknown-citizen"><i class="fas fa-user-slash"></i> Unknown Citizen (Reported without login)</div>';
            }
        } catch (err) {
            container.innerHTML = '<div class="error-text"><i class="fas fa-exclamation-circle"></i> Could not load reporter information.</div>';
            console.error(err);
        }
    });

    function escapeHtml(text) {
        return text ? String(text).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m])) : '';
    }
</script>
</body>
</html>