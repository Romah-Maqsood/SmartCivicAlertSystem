@model SmartCityPulse.Models.Incident
@{
    Layout = null;
    ViewData["Title"] = "Incident Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Smart Civic</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --bg-page: #E8EDF5;
            --bg-card: #FFFFFF;
            --border: #EAECF0;
            --text-primary: #1A1F36;
            --text-secondary: #6B7280;
            --blue: #2563EB;
            --blue-light: #EFF6FF;
            --red: #DC2626;
            --green: #10B981;
            --yellow: #F59E0B;
            --radius-card: 16px;
            --radius-btn: 40px;
            --shadow-card: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
            --transition: all 0.2s ease;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-page);
            color: var(--text-primary);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            padding: 2rem;
        }
        .container {
            width: 100%;
            max-width: 900px;
        }
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--blue);
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 24px;
            transition: var(--transition);
        }
        .back-link:hover { text-decoration: underline; }
        .detail-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-card);
            padding: 32px;
            box-shadow: var(--shadow-card);
        }
        .detail-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 28px;
        }
        .detail-title {
            font-size: 22px;
            font-weight: 800;
            color: var(--text-primary);
            line-height: 1.3;
            margin-bottom: 8px;
        }
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 14px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }
        .severity-critical { background: #FEE2E2; color: #991B1B; }
        .severity-high     { background: #FFEDD5; color: #9A3412; }
        .severity-medium   { background: #FEF3C7; color: #92400E; }
        .severity-low      { background: #DCFCE7; color: #166534; }
        .status-open       { background: #DBEAFE; color: #1E40AF; }
        .status-inprogress { background: #FEF3C7; color: #92400E; }
        .status-resolved   { background: #DCFCE7; color: #166534; }
        .detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 28px;
        }
        .info-block {
            background: #F9FAFB;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 16px;
        }
        .info-label {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.6px;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .info-label i { color: var(--blue); font-size: 12px; }
        .info-value { font-size: 14px; font-weight: 600; color: var(--text-primary); }
        .description-block { grid-column: span 2; }
        .description-text {
            font-size: 14px;
            color: var(--text-primary);
            line-height: 1.6;
            white-space: pre-wrap;
        }
        .citizen-section {
            border-top: 1px solid var(--border);
            padding-top: 24px;
            margin-top: 8px;
        }
        .section-title {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .section-title i { color: var(--blue); }
        .citizen-card {
            background: #F9FAFB;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px;
        }
        .citizen-name { font-size: 15px; font-weight: 700; }
        .citizen-meta { font-size: 13px; color: var(--text-secondary); margin-top: 4px; }
        .unknown-citizen { color: var(--text-secondary); font-style: italic; font-size: 14px; }
        .btn-primary {
            background: var(--blue);
            color: white;
            padding: 9px 18px;
            border-radius: var(--radius-btn);
            font-size: 13px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 7px;
            text-decoration: none;
        }
        .btn-primary:hover { background: #1D4ED8; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(37,99,235,0.25); }
        @@media (max-width: 768px) {
            body { padding: 1rem; }
            .detail-grid { grid-template-columns: 1fr; }
            .description-block { grid-column: span 1; }
        }
    </style>
</head>
<body>
<div class="container">
    <a href="/Admin/Index" class="back-link"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
    <div class="detail-card">
        <div class="detail-header">
            <div>
                <div class="detail-title">@Model.Title</div>
                <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;">
                    <span class="badge severity-@Model.Severity.ToLower()">
                        <i class="fas fa-exclamation-circle" style="font-size:10px;"></i> @Model.Severity
                    </span>
                    <span class="badge status-@Model.Status.ToLower().Replace(" ","")">
                        <i class="fas @(Model.Status == "Resolved" ? "fa-check-circle" : "fa-hourglass-half")" style="font-size:10px;"></i> @Model.Status
                    </span>
                </div>
            </div>
        </div>
        <div class="detail-grid">
            <div class="info-block">
                <div class="info-label"><i class="fas fa-map-marker-alt"></i> Location</div>
                <div class="info-value">@(Model.Location ?? "Not specified")</div>
            </div>
            <div class="info-block">
                <div class="info-label"><i class="fas fa-building"></i> Department</div>
                <div class="info-value">@(Model.Department ?? "Unassigned")</div>
            </div>
            <div class="info-block">
                <div class="info-label"><i class="fas fa-calendar-alt"></i> Reported At</div>
                <div class="info-value">@Model.ReportedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
            </div>
            <div class="info-block">
                <div class="info-label"><i class="fas fa-clock"></i> Last Updated</div>
                <div class="info-value">@Model.UpdatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
            </div>
            <div class="info-block description-block">
                <div class="info-label"><i class="fas fa-align-left"></i> Description</div>
                <div class="description-text">@(Model.Description ?? "No description provided.")</div>
            </div>
        </div>
        <div class="citizen-section">
            <div class="section-title"><i class="fas fa-user"></i> Reported By</div>
            <!-- Citizen info will be loaded here by JavaScript -->
            <div id="citizenInfoContainer">
                <p style="color: var(--text-secondary);">Loading reporter information...</p>
            </div>
        </div>
    </div>
</div>

<script>
    // Fetch citizen details after page load
    document.addEventListener('DOMContentLoaded', async function() {
        const container = document.getElementById('citizenInfoContainer');
        try {
            const response = await fetch(`/Admin/GetIncidentDetailJson?id=@Model.Id`, {
                credentials: 'same-origin'
            });
            if (!response.ok) throw new Error('Failed to fetch');
            const data = await response.json();

            if (data.citizen) {
                container.innerHTML = `
                    <div class="citizen-card">
                        <div class="citizen-name">${escapeHtml(data.citizen.name)}</div>
                        <div class="citizen-meta"><i class="fas fa-envelope"></i> ${escapeHtml(data.citizen.email)}</div>
                        <div class="citizen-meta"><i class="fas fa-phone"></i> ${escapeHtml(data.citizen.phone || 'N/A')}</div>
                        <div class="citizen-meta"><i class="fas fa-user-tag"></i> Role: ${escapeHtml(data.citizen.role)}</div>
                    </div>`;
            } else {
                container.innerHTML = '<div class="unknown-citizen"><i class="fas fa-user-slash"></i> Unknown Citizen (Reported without login)</div>';
            }
        } catch (err) {
            container.innerHTML = '<p style="color: var(--red);">Could not load reporter info.</p>';
            console.error(err);
        }
    });

    function escapeHtml(text) {
        return text ? String(text).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m])) : '';
    }
</script>
</body>
</html>