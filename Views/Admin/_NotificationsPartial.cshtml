@{
    Layout = null;
}

<style>
    .notif-page-wrap {
        font-family: 'Inter', sans-serif;
        padding: 0;
    }

    .notif-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 20px;
    }
    .notif-page-title {
        font-size: 18px;
        font-weight: 700;
        color: #111827;
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0;
    }

    /* Controls row */
    .notif-controls-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    /* Filter pills – white bg, blue outline */
    .notif-filter-group {
        display: flex;
        gap: 6px;
    }
    .notif-filter-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        border-radius: 20px;
        border: 1.5px solid #2563EB;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s ease;
        background: #FFFFFF;
        color: #2563EB;
        white-space: nowrap;
        outline: none;
    }
    .notif-filter-pill.active {
        background: #2563EB;
        color: #FFFFFF;
        border-color: #2563EB;
    }
    .pill-badge {
        font-size: 11px;
        font-weight: 600;
        padding: 1px 7px;
        border-radius: 20px;
        background: rgba(37,99,235,0.1);
        color: #2563EB;
        min-width: 18px;
        text-align: center;
    }
    .notif-filter-pill.active .pill-badge {
        background: rgba(255,255,255,0.25);
        color: #FFFFFF;
    }

    /* Mark all button */
    .mark-all-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 16px;
        border-radius: 10px;
        border: 1.5px solid #E5E7EB;
        background: #FFFFFF;
        color: #374151;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s ease;
        white-space: nowrap;
    }
    .mark-all-btn:hover {
        border-color: #6EE7B7;
        background: #F0FDF4;
        color: #059669;
    }
    .mark-all-btn:active { transform: scale(0.97); }

    /* Notification list */
    .notification-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    /* Cards */
    .notification-card {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: #FFFFFF;
        border: 1px solid #E5E7EB;
        border-radius: 14px;
        padding: 13px 16px;
        cursor: pointer;
        transition: all 0.15s ease;
        position: relative;
    }
    .notification-card:hover {
        border-color: #BFDBFE;
        box-shadow: 0 2px 12px rgba(37,99,235,0.07);
    }
    .notification-card.unread {
        border-left: 3px solid #93C5FD;
    }
    .notification-card.unread::after {
        content: '';
        position: absolute;
        top: 14px;
        right: 54px;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #3B82F6;
    }

    /* Icon bubble (now using Font Awesome icons) */
    .notif-icon-bubble {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
        line-height: 1;
    }
    .notif-icon-bubble.type-critical { background: #FEF2F2; color: #991B1B; }
    .notif-icon-bubble.type-sos      { background: #FFF7ED; color: #9A3412; }
    .notif-icon-bubble.type-success  { background: #F0FDF4; color: #166534; }
    .notif-icon-bubble.type-removed  { background: #FFF1F2; color: #BE123C; }
    .notif-icon-bubble.type-warning  { background: #FFFBEB; color: #92400E; }

    /* Content */
    .notif-content { flex: 1; min-width: 0; }
    .notif-title {
        font-size: 13.5px;
        font-weight: 600;
        color: #111827;
        margin: 0 0 2px;
        padding-right: 16px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .notification-card.unread .notif-title { color: #1D4ED8; }
    .notif-body {
        font-size: 12px;
        color: #9CA3AF;
        margin: 0 0 6px;
        line-height: 1.5;
    }
    .notif-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }
    .notif-time {
        font-size: 11px;
        color: #9CA3AF;
    }
    .notif-type-tag {
        font-size: 11px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 6px;
        white-space: nowrap;
    }
    .tag-critical { background: #FEE2E2; color: #B91C1C; }
    .tag-sos      { background: #FFEDD5; color: #C2410C; }
    .tag-added    { background: #DCFCE7; color: #15803D; }
    .tag-removed  { background: #FFE4E6; color: #BE123C; }
    .tag-warning  { background: #FEF3C7; color: #B45309; }

    /* Toggle button */
    .notif-toggle-btn {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        border: 1px solid #E5E7EB;
        background: #F9FAFB;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        transition: all 0.14s ease;
        margin-top: 1px;
    }
    .notif-toggle-btn:hover {
        background: #EFF6FF;
        border-color: #93C5FD;
    }

    /* Empty state */
    .notif-empty {
        text-align: center;
        padding: 48px 20px;
        color: #9CA3AF;
    }
    .notif-empty .empty-icon { font-size: 38px; display: block; margin-bottom: 10px; color: #93C5FD; }
    .notif-empty p { font-size: 13px; margin: 0; }

    /* Loading */
    .notif-loading {
        text-align: center;
        padding: 40px 20px;
        color: #9CA3AF;
        font-size: 13px;
    }
    .notif-loading i { color: #93C5FD; font-size: 20px; display: block; margin-bottom: 8px; }
</style>

<div class="notif-page-wrap">

    <!-- Header -->
    <div class="notif-page-header">
        <h2 class="notif-page-title">
            <i class="fas fa-bell" style="color: #2563EB; font-size: 20px;"></i> Notifications
        </h2>
        <button class="mark-all-btn" onclick="markAllNotificationsRead()">
            <i class="fas fa-check-double"></i> Mark all as read
        </button>
    </div>

    <!-- Filter pills -->
    <div class="notif-controls-row">
        <div class="notif-filter-group" id="notifFilterTabs">
            <button class="notif-filter-pill active" data-filter="all" onclick="setNotifFilter('all', this)">
                <i class="fas fa-layer-group"></i> All
                <span class="pill-badge" id="tabCountAll">0</span>
            </button>
            <button class="notif-filter-pill" data-filter="unread" onclick="setNotifFilter('unread', this)">
                <i class="fas fa-envelope"></i> Unread
                <span class="pill-badge" id="tabCountUnread">0</span>
            </button>
            <button class="notif-filter-pill" data-filter="read" onclick="setNotifFilter('read', this)">
                <i class="fas fa-envelope-open"></i> Read
                <span class="pill-badge" id="tabCountRead">0</span>
            </button>
        </div>
    </div>

    <!-- Notification list -->
    <div class="notification-list" id="notificationList">
        <div class="notif-loading">
            <i class="fas fa-spinner fa-spin"></i>
            Loading notifications…
        </div>
    </div>

</div>

<script>
    (function () {
        // Map each admin notification type to a Font Awesome icon and style
        function getNotifDisplay(n) {
            const title = (n.title || '').toLowerCase();
            if (title.includes('new critical incident') || title.includes('critical incident'))
                return { icon: 'fa-fire', bubbleCls: 'type-critical', tagCls: 'tag-critical', tagLabel: 'Critical Incident' };
            if (title.includes('emergency sos') || title.includes('sos alert') || title.includes('sos'))
                return { icon: 'fa-truck-medical', bubbleCls: 'type-sos', tagCls: 'tag-sos', tagLabel: 'Emergency SOS' };
            if (title.includes('operator added') || title.includes('new operator'))
                return { icon: 'fa-user-plus', bubbleCls: 'type-success', tagCls: 'tag-added', tagLabel: 'Operator Added' };
            if (title.includes('operator removed') || title.includes('deleted operator'))
                return { icon: 'fa-user-minus', bubbleCls: 'type-removed', tagCls: 'tag-removed', tagLabel: 'Operator Removed' };
            if (title.includes('not assigned') || title.includes('unassigned') || title.includes('10 min'))
                return { icon: 'fa-hourglass-half', bubbleCls: 'type-warning', tagCls: 'tag-warning', tagLabel: 'Unassigned Alert' };
            return { icon: 'fa-bell', bubbleCls: 'type-warning', tagCls: 'tag-warning', tagLabel: 'Notification' };
        }

        function timeAgo(ts) {
            if (!ts) return '';
            const diff = Math.floor((Date.now() - new Date(ts)) / 1000);
            if (diff < 60)    return 'just now';
            if (diff < 3600)  return Math.floor(diff / 60) + 'm ago';
            if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
            return Math.floor(diff / 86400) + 'd ago';
        }

        window.renderNotifications = function () {
            const list        = document.getElementById('notificationList');
            const all         = (typeof realNotifications !== 'undefined') ? realNotifications : [];
            const filter      = window._notifFilter || 'all';
            const unreadCount = all.filter(n => !n.isRead).length;
            const readCount   = all.filter(n =>  n.isRead).length;

            document.getElementById('tabCountAll').textContent    = all.length;
            document.getElementById('tabCountUnread').textContent = unreadCount;
            document.getElementById('tabCountRead').textContent   = readCount;

            const filtered = all.filter(n => {
                if (filter === 'unread') return !n.isRead;
                if (filter === 'read')   return  n.isRead;
                return true;
            });

            if (!filtered.length) {
                list.innerHTML = `<div class="notif-empty">
                    <i class="fas ${filter === 'unread' ? 'fa-envelope-open' : 'fa-bell-slash'} empty-icon"></i>
                    <p>${filter === 'unread' ? 'No unread notifications!' : 'No notifications found.'}</p>
                </div>`;
                return;
            }

            list.innerHTML = filtered.map(n => {
                const d   = getNotifDisplay(n);
                const cls = n.isRead ? '' : 'unread';
                // Toggle icon – mark as read (check) or mark as unread (envelope)
                const toggleIcon = n.isRead ? 'fa-envelope' : 'fa-check';
                const toggleTitle = n.isRead ? 'Mark as unread' : 'Mark as read';
                return `
                <div class="notification-card ${cls}" data-id="${n.id}">
                    <div class="notif-icon-bubble ${d.bubbleCls}">
                        <i class="fas ${d.icon}"></i>
                    </div>
                    <div class="notif-content">
                        <p class="notif-title">${n.title || 'Notification'}</p>
                        <p class="notif-body">${n.message || ''}</p>
                        <div class="notif-meta">
                            <span class="notif-time"><i class="far fa-clock" style="margin-right: 4px;"></i>${timeAgo(n.createdAt || n.timestamp)}</span>
                            <span class="notif-type-tag ${d.tagCls}">${d.tagLabel}</span>
                        </div>
                    </div>
                    <button class="notif-toggle-btn" title="${toggleTitle}"
                        onclick="event.stopPropagation(); markNotificationRead('${n.id}')">
                        <i class="fas ${toggleIcon}"></i>
                    </button>
                </div>`;
            }).join('');
        };

        window.setNotifFilter = function (filter, btn) {
            window._notifFilter = filter;
            document.querySelectorAll('.notif-filter-pill').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            window.renderNotifications();
        };

        window._notifFilter = 'all';

        // Hook into existing notification loading
        const origLoad = window.loadNotifications;
        if (typeof origLoad === 'function') {
            window.loadNotifications = function () {
                origLoad();
                setTimeout(window.renderNotifications, 300);
            };
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => setTimeout(window.renderNotifications, 200));
        } else {
            setTimeout(window.renderNotifications, 200);
        }
    })();
</script>