@using System.Linq
@{
    Layout = null;
    ViewData["Title"] = "Admin Dashboard";
    string userName = ViewBag.UserName ?? "Admin";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Smart Civic</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg-page:       #E8EDF5;
            --bg-sidebar:    #FFFFFF;
            --bg-card:       #FFFFFF;
            --bg-topbar:     #FFFFFF;
            --border:        #EAECF0;
            --border-hover:  #C7D2FE;

            --text-primary:  #1A1F36;
            --text-secondary:#6B7280;
            --text-nav:      #5A6A7F;

            --blue:          #2563EB;
            --blue-dark:     #1D4ED8;
            --blue-light:    #EFF6FF;
            --blue-mid:      #3B82F6;

            --red:           #DC2626;
            --red-dark:      #B91C1C;
            --red-light:     #FEF2F2;

            --green:         #10B981;
            --green-light:   #DCFCE7;
            --green-dark:    #166534;

            --yellow:        #F59E0B;
            --yellow-light:  #FEF3C7;
            --yellow-dark:   #92400E;

            --orange:        #F97316;

            --sidebar-w:     260px;
            --sidebar-coll:  72px;
            --radius-card:   16px;
            --radius-btn:    40px;
            --radius-nav:    10px;
            --shadow-card:   0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
            --shadow-hover:  0 8px 24px rgba(37,99,235,0.12);
            --transition:    all 0.2s ease;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-page);
            color: var(--text-primary);
            display: flex;
            min-height: 100vh;
        }

        /* ===== SIDEBAR ===== */
        .sidebar {
            width: var(--sidebar-w);
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
            z-index: 100;
            transition: width 0.25s ease;
        }
        .sidebar.collapsed { width: var(--sidebar-coll); }

        /* ⭐ Hide brand section when collapsed */
        .sidebar.collapsed .sidebar-brand {
            display: none;
        }

        .sidebar-brand {
            padding: 22px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 12px;
            overflow: hidden;
            white-space: nowrap;
        }
        .brand-icon {
            width: 40px; height: 40px;
            background: linear-gradient(135deg, var(--blue), #6366F1);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 18px;
            flex-shrink: 0;
        }
        .brand-text h2 { font-size: 14px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.3px; }
        .brand-text span { font-size: 11px; color: var(--text-secondary); font-weight: 500; }

        /* ⭐ Hamburger as a nav item (aligned with other icons) */
        .hamburger-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            margin-bottom: 2px;
            border-radius: var(--radius-nav);
            cursor: pointer;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-nav);
            transition: var(--transition);
            white-space: nowrap;
            overflow: hidden;
        }
        .hamburger-item:hover {
            background: var(--blue-light);
            color: var(--blue);
        }
        .hamburger-item i {
            width: 20px;
            text-align: center;
            font-size: 14px;
            flex-shrink: 0;
        }
        .sidebar.collapsed .hamburger-item span { display: none; }

        .sidebar-nav { padding: 16px 12px; flex: 1; overflow-y: auto; }
        .nav-section-label {
            font-size: 10px; font-weight: 700; color: var(--text-secondary);
            text-transform: uppercase; letter-spacing: 1px;
            padding: 8px 8px 4px;
            opacity: 1; transition: opacity 0.2s;
        }
        .sidebar.collapsed .nav-section-label { opacity: 0; }

        .nav-item {
            display: flex; align-items: center; gap: 12px;
            padding: 10px 12px; margin-bottom: 2px;
            border-radius: var(--radius-nav);
            color: var(--text-nav);
            text-decoration: none; font-size: 13px; font-weight: 500;
            transition: var(--transition); cursor: pointer;
            white-space: nowrap; overflow: hidden;
        }
        .nav-item i { width: 20px; text-align: center; font-size: 14px; flex-shrink: 0; }
        .nav-item:hover { background: var(--blue-light); color: var(--blue); }
        .nav-item.active { background: var(--blue-light); color: var(--blue); font-weight: 600; }
        .nav-item.active i { color: var(--blue); }
        .sidebar.collapsed .nav-item span { display: none; }

        .sidebar-footer {
            padding: 16px 12px;
            border-top: 1px solid var(--border);
        }
        .logout-btn {
            display: flex; align-items: center; gap: 12px;
            padding: 10px 12px; border-radius: var(--radius-nav);
            color: var(--text-nav); text-decoration: none; font-size: 13px; font-weight: 500;
            transition: var(--transition);
            white-space: nowrap; overflow: hidden;
        }
        .logout-btn:hover { background: var(--red-light); color: var(--red); }
        .sidebar.collapsed .logout-btn span { display: none; }

        /* ===== MAIN ===== */
        .main-content { margin-left: var(--sidebar-w); flex: 1; transition: margin-left 0.25s ease; }
        .main-content.expanded { margin-left: var(--sidebar-coll); }

        .topbar {
            background: var(--bg-topbar);
            border-bottom: 1px solid var(--border);
            padding: 0 32px;
            height: 68px;
            display: flex; align-items: center; justify-content: space-between;
            position: sticky; top: 0; z-index: 50;
        }
        .breadcrumb { display: flex; align-items: center; gap: 8px; }
        .breadcrumb-icon {
            width: 36px; height: 36px;
            background: var(--blue-light);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            color: var(--blue); font-size: 15px;
        }
        .breadcrumb h1 { font-size: 16px; font-weight: 700; color: var(--text-primary); }
        .breadcrumb p { font-size: 12px; color: var(--text-secondary); }

        .topbar-right { display: flex; align-items: center; gap: 12px; }
        .user-menu { position: relative; }
        .user-chip {
            display: flex; align-items: center; gap: 10px;
            padding: 6px 14px 6px 6px;
            background: var(--bg-page); border: 1px solid var(--border);
            border-radius: 40px; cursor: pointer; transition: var(--transition);
        }
        .user-avatar {
            width: 30px; height: 30px;
            background: linear-gradient(135deg, var(--blue), #6366F1);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 12px; font-weight: 700;
        }
        .user-chip span { font-size: 13px; font-weight: 600; color: var(--text-primary); }
        .user-chip i.fa-chevron-down { font-size: 10px; color: var(--text-secondary); }

        .content-area { padding: 28px 32px; }

        .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
        .section-title { font-size: 18px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 10px; }
        .section-title i { color: var(--blue); }

        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 28px; }

        .stat-card {
            background: var(--bg-card);
            border-radius: var(--radius-card);
            padding: 20px;
            box-shadow: var(--shadow-card);
            border: 1px solid var(--border);
            position: relative; overflow: hidden;
            transition: var(--transition);
        }
        .stat-card:hover { box-shadow: var(--shadow-hover); transform: translateY(-3px); border-color: var(--border-hover); }
        .stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; }
        .stat-card.blue::before   { background: var(--blue-mid); }
        .stat-card.green::before  { background: var(--green); }
        .stat-card.red::before    { background: var(--red); }
        .stat-card.yellow::before { background: var(--yellow); }

        .stat-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
        .stat-label { font-size: 11px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.6px; }
        .stat-icon {
            width: 38px; height: 38px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center; font-size: 16px;
        }
        .stat-card.blue   .stat-icon { background: #EFF6FF; color: var(--blue-mid); }
        .stat-card.green  .stat-icon { background: var(--green-light); color: var(--green); }
        .stat-card.red    .stat-icon { background: var(--red-light); color: var(--red); }
        .stat-card.yellow .stat-icon { background: var(--yellow-light); color: var(--yellow); }

        .stat-value { font-size: 30px; font-weight: 800; color: var(--text-primary); line-height: 1; margin-bottom: 4px; }
        .stat-desc { font-size: 12px; color: var(--text-secondary); }

        .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 28px; }
        .chart-card {
            background: var(--bg-card); border-radius: var(--radius-card);
            padding: 22px; border: 1px solid var(--border);
            box-shadow: var(--shadow-card);
        }
        .chart-title {
            font-size: 14px; font-weight: 700; color: var(--text-primary);
            margin-bottom: 18px; display: flex; align-items: center; gap: 8px;
        }
        .chart-title i { color: var(--blue); font-size: 14px; }
        .chart-canvas-wrapper { position: relative; height: 240px; }
        canvas { height: 100% !important; width: 100% !important; }
        .chart-error { color: var(--red); font-size: 13px; text-align: center; padding: 40px 0; }
        .hide { display: none !important; }

        .table-wrapper {
            background: var(--bg-card); border-radius: var(--radius-card);
            border: 1px solid var(--border); box-shadow: var(--shadow-card);
            overflow: hidden;
        }
        .table-wrapper table { width: 100%; border-collapse: collapse; }
        .table-wrapper thead { background: #F8FAFC; }
        .table-wrapper thead th {
            padding: 12px 20px; text-align: left;
            font-size: 11px; font-weight: 600; color: var(--text-secondary);
            text-transform: uppercase; letter-spacing: 0.6px;
            border-bottom: 1px solid var(--border);
        }
        .table-wrapper tbody tr { border-bottom: 1px solid var(--border); transition: var(--transition); }
        .table-wrapper tbody tr:last-child { border-bottom: none; }
        .table-wrapper tbody tr:hover { background: #F8FAFC; }
        .table-wrapper tbody td { padding: 13px 20px; font-size: 13px; color: var(--text-primary); }
        .td-muted { color: var(--text-secondary) !important; }

        .badge {
            display: inline-block; padding: 3px 10px; border-radius: 50px;
            font-size: 11px; font-weight: 600;
        }
        .badge-critical { background: #FEE2E2; color: #991B1B; }
        .badge-high     { background: #FFEDD5; color: #9A3412; }
        .badge-medium   { background: #FEF3C7; color: var(--yellow-dark); }
        .badge-low      { background: var(--green-light); color: var(--green-dark); }

        .status-badge {
            display: inline-block; padding: 3px 10px; border-radius: 50px;
            font-size: 11px; font-weight: 600;
        }
        .status-open       { background: #DBEAFE; color: #1E40AF; }
        .status-inprogress { background: var(--yellow-light); color: var(--yellow-dark); }
        .status-resolved   { background: var(--green-light); color: var(--green-dark); }

        .btn-primary {
            background: var(--blue); color: white;
            padding: 9px 18px; border-radius: var(--radius-btn);
            font-size: 13px; font-weight: 600; border: none; cursor: pointer;
            transition: var(--transition); display: inline-flex; align-items: center; gap: 7px;
        }
        .btn-primary:hover { background: var(--blue-dark); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(37,99,235,0.25); }
        .btn-sm { padding: 6px 14px; font-size: 12px; border-radius: 8px; }
        .btn-outline {
            background: transparent; color: var(--blue);
            padding: 7px 16px; border-radius: var(--radius-btn);
            font-size: 13px; font-weight: 600;
            border: 1.5px solid var(--blue); cursor: pointer; transition: var(--transition);
        }
        .btn-outline:hover { background: var(--blue); color: white; }
        .btn-danger { background: var(--red); }
        .btn-danger:hover { background: var(--red-dark); box-shadow: 0 4px 12px rgba(220,38,38,0.25); }
        .btn-ghost {
            background: var(--bg-page); color: var(--text-nav);
            border: 1px solid var(--border); padding: 7px 16px;
            border-radius: var(--radius-btn); font-size: 13px; font-weight: 500;
            cursor: pointer; transition: var(--transition); display: inline-flex; align-items: center; gap: 7px;
        }
        .btn-ghost:hover { border-color: var(--blue); color: var(--blue); background: var(--blue-light); }

        .btn-view {
            background: var(--blue-light); color: var(--blue);
            padding: 5px 12px; border-radius: 8px;
            text-decoration: none; font-size: 12px; font-weight: 600;
            border: 1px solid #BFDBFE; transition: var(--transition); display: inline-block;
        }
        .btn-view:hover { background: var(--blue); color: white; border-color: var(--blue); }

        .btn-edit   { background: var(--blue-light); color: var(--blue); border: 1px solid #BFDBFE; padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; transition: var(--transition); }
        .btn-edit:hover { background: var(--blue); color: white; }
        .btn-delete { background: #FEF2F2; color: var(--red); border: 1px solid #FECACA; padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; transition: var(--transition); }
        .btn-delete:hover { background: var(--red); color: white; }

        .action-buttons { display: flex; gap: 6px; }

        .filter-bar {
            display: flex; gap: 10px; align-items: center;
            margin-bottom: 20px; flex-wrap: wrap;
        }
        .filter-bar select, .filter-bar input {
            padding: 8px 12px; background: var(--bg-card);
            border: 1px solid var(--border); color: var(--text-primary);
            border-radius: 10px; font-size: 13px; font-family: inherit;
            transition: var(--transition); min-width: 140px;
        }
        .filter-bar select:focus, .filter-bar input:focus { outline: none; border-color: var(--blue); }

        .modal {
            display: none; position: fixed; inset: 0;
            background: rgba(17,24,39,0.55); z-index: 1000;
            justify-content: center; align-items: center;
            backdrop-filter: blur(4px);
        }
        .modal.active { display: flex; }
        .modal-content {
            background: var(--bg-card); border-radius: 20px;
            padding: 32px; width: 480px; max-width: 92%;
            border: 1px solid var(--border);
            box-shadow: 0 24px 48px rgba(0,0,0,0.15);
            animation: modalSlide 0.2s ease;
        }
        @@keyframes modalSlide { from { transform: translateY(12px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .modal-content h3 { font-size: 17px; font-weight: 700; margin-bottom: 20px; color: var(--text-primary); }
        .modal-content input, .modal-content select {
            width: 100%; padding: 11px 14px; margin: 7px 0;
            background: var(--bg-page); border: 1px solid var(--border);
            color: var(--text-primary); border-radius: 10px; font-size: 13px; font-family: inherit;
        }
        .modal-content input:focus, .modal-content select:focus { outline: none; border-color: var(--blue); background: white; }
        .modal-content input::placeholder { color: var(--text-secondary); }
        .modal-buttons { display: flex; gap: 10px; margin-top: 22px; }
        .btn-cancel { background: var(--bg-page); color: var(--text-secondary); border: 1px solid var(--border); padding: 10px 20px; border-radius: var(--radius-btn); font-size: 13px; font-weight: 500; cursor: pointer; transition: var(--transition); }
        .btn-cancel:hover { border-color: var(--text-secondary); color: var(--text-primary); }
        .btn-confirm { background: var(--red); color: white; border: none; padding: 10px 20px; border-radius: var(--radius-btn); font-size: 13px; font-weight: 600; cursor: pointer; transition: var(--transition); }
        .btn-confirm:hover { background: var(--red-dark); }

        .empty-state { text-align: center; padding: 60px 20px; color: var(--text-secondary); }
        .empty-state i { font-size: 40px; margin-bottom: 14px; display: block; color: #CBD5E1; }
        .empty-state p { font-size: 14px; }

        .report-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 18px; }
        .form-group label { display: block; font-size: 12px; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.4px; }
        .form-group input, .form-group select {
            width: 100%; padding: 10px 14px;
            background: var(--bg-page); border: 1px solid var(--border);
            color: var(--text-primary); border-radius: 10px; font-size: 13px; font-family: inherit;
            transition: var(--transition);
        }
        .form-group input:focus, .form-group select:focus { outline: none; border-color: var(--blue); background: white; }

        .report-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 24px; }
        .report-card {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: var(--radius-card); padding: 26px 20px;
            text-align: center; transition: var(--transition);
        }
        .report-card:hover { border-color: var(--blue-mid); box-shadow: var(--shadow-hover); transform: translateY(-3px); }
        .report-card .rc-icon {
            width: 52px; height: 52px; border-radius: 14px;
            background: var(--blue-light); color: var(--blue);
            font-size: 22px; display: flex; align-items: center; justify-content: center;
            margin: 0 auto 14px;
        }
        .report-card h3 { font-size: 15px; font-weight: 700; margin-bottom: 6px; color: var(--text-primary); }
        .report-card p { font-size: 12px; color: var(--text-secondary); margin-bottom: 18px; }

        .preview-result { font-size: 13px; font-weight: 600; color: var(--green); }

        .download-dropdown { position: relative; display: inline-block; }
        .download-menu {
            display: none; position: absolute; top: calc(100% + 6px); left: 0;
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 12px; min-width: 160px; z-index: 300;
            box-shadow: 0 8px 24px rgba(0,0,0,0.1); overflow: hidden;
        }
        .download-menu a {
            display: flex; align-items: center; gap: 10px;
            padding: 11px 16px; color: var(--text-nav); text-decoration: none; font-size: 13px;
            transition: var(--transition);
        }
        .download-menu a:hover { background: var(--blue-light); color: var(--blue); }
        .download-menu a i { width: 16px; text-align: center; }

        @@media (max-width: 1100px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
        @@media (max-width: 768px) {
            .sidebar { width: 100%; position: relative; height: auto; }
            .main-content { margin-left: 0 !important; }
            .stats-grid { grid-template-columns: 1fr 1fr; }
            .charts-grid { grid-template-columns: 1fr; }
            .report-cards { grid-template-columns: 1fr; }
            .report-form-grid { grid-template-columns: 1fr; }
            .content-area { padding: 20px 16px; }
            .topbar { padding: 0 16px; }
        }
        @@media (max-width: 480px) { .stats-grid { grid-template-columns: 1fr; } }
    </style>
</head>
<body>

<!-- ===== SIDEBAR ===== -->
<aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
        <div class="brand-icon"><i class="fas fa-city"></i></div>
        <div class="brand-text">
            <h2>SMART CIVIC</h2>
            <span>Alert System · Admin</span>
        </div>
    </div>

    <!-- ⭐ Hamburger icon as a nav item (aligned with other icons) -->
    <div class="hamburger-item" onclick="toggleSidebar()" title="Toggle sidebar">
        <i class="fas fa-bars"></i>
        <span>Toggle Sidebar</span>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-section-label">Main</div>
        <a class="nav-item active" data-page="dashboard" onclick="showSection('dashboard')">
            <i class="fas fa-chart-pie"></i><span>Dashboard</span>
        </a>
        <a class="nav-item" data-page="incidents" onclick="showSection('incidents')">
            <i class="fas fa-list-alt"></i><span>Incidents</span>
        </a>

        <div class="nav-section-label" style="margin-top:12px;">Management</div>
        <a class="nav-item" data-page="operators" onclick="showSection('operators')">
            <i class="fas fa-users-cog"></i><span>Operators</span>
        </a>
        <a class="nav-item" data-page="citizens" onclick="showSection('citizens')">
            <i class="fas fa-user"></i><span>Citizens</span>
        </a>

        <div class="nav-section-label" style="margin-top:12px;">Insights</div>
        <a class="nav-item" data-page="analytics" onclick="showSection('analytics')">
            <i class="fas fa-chart-line"></i><span>Analytics</span>
        </a>
        <a class="nav-item" data-page="reports" onclick="showSection('reports')">
            <i class="fas fa-file-alt"></i><span>Reports</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <a href="/Account/Logout" class="logout-btn">
            <i class="fas fa-sign-out-alt"></i><span>Logout</span>
        </a>
    </div>
</aside>

<!-- ===== MAIN CONTENT ===== -->
<div class="main-content" id="mainContent">

    <!-- TOPBAR -->
    <div class="topbar">
        <div class="breadcrumb">
            <div class="breadcrumb-icon" id="topbarIcon"><i class="fas fa-chart-pie"></i></div>
            <div>
                <h1 id="topbarTitle">Dashboard</h1>
                <p id="topbarSub">Overview of your city's incident response</p>
            </div>
        </div>
        <div class="topbar-right">
            <div class="notif-btn" title="Notifications">
                <i class="fas fa-bell"></i>
                <span class="notif-dot"></span>
            </div>
            <div class="user-menu">
                <div class="user-chip" onclick="toggleDropdown()">
                    <div class="user-avatar">@(userName.Length > 0 ? userName[0].ToString().ToUpper() : "A")</div>
                    <span>@userName</span>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="dropdown-menu" id="adminDropdown">
                    <a href="#"><i class="fas fa-user-circle"></i> My Profile</a>
                    <a href="/Account/Logout" class="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTENT -->
    <div class="content-area">

        <!-- ===== DASHBOARD SECTION ===== -->
        <div id="dashboardSection">
            <div class="stats-grid">
                <div class="stat-card blue">
                    <div class="stat-card-top">
                        <span class="stat-label">Total Today</span>
                        <div class="stat-icon"><i class="fas fa-calendar-day"></i></div>
                    </div>
                    <div class="stat-value">@ViewBag.TotalToday</div>
                    <div class="stat-desc">Incidents reported today</div>
                </div>
                <div class="stat-card green">
                    <div class="stat-card-top">
                        <span class="stat-label">Resolved Today</span>
                        <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
                    </div>
                    <div class="stat-value">@ViewBag.ResolvedToday</div>
                    <div class="stat-desc">Successfully resolved</div>
                </div>
                <div class="stat-card red">
                    <div class="stat-card-top">
                        <span class="stat-label">Critical Open</span>
                        <div class="stat-icon"><i class="fas fa-exclamation-triangle"></i></div>
                    </div>
                    <div class="stat-value">@ViewBag.CriticalIncidents</div>
                    <div class="stat-desc">Critical incidents pending</div>
                </div>
                <div class="stat-card yellow">
                    <div class="stat-card-top">
                        <span class="stat-label">Pending</span>
                        <div class="stat-icon"><i class="fas fa-hourglass-half"></i></div>
                    </div>
                    <div class="stat-value">@ViewBag.PendingIncidents</div>
                    <div class="stat-desc">Open or in progress</div>
                </div>
            </div>

            <div class="charts-grid">
                <div class="chart-card">
                    <div class="chart-title"><i class="fas fa-chart-line"></i> Last 7 Days Trend</div>
                    <div class="chart-canvas-wrapper"><canvas id="trendChart"></canvas></div>
                    <div id="trendChartError" class="chart-error hide"></div>
                </div>
                <div class="chart-card">
                    <div class="chart-title"><i class="fas fa-chart-pie"></i> Severity Distribution</div>
                    <div class="chart-canvas-wrapper"><canvas id="severityChart"></canvas></div>
                    <div id="severityChartError" class="chart-error hide"></div>
                </div>
            </div>

            <div class="section-header">
                <h2 class="section-title"><i class="fas fa-clock"></i> Recent Incidents</h2>
                <button class="btn-outline" onclick="showSection('incidents')">View All <i class="fas fa-arrow-right"></i></button>
            </div>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Title</th><th>Location</th><th>Severity</th>
                            <th>Status</th><th>Reported At</th><th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.RecentIncidents != null && ViewBag.RecentIncidents.Count > 0)
                        {
                            @foreach (var incident in ViewBag.RecentIncidents)
                            {
                                <tr>
                                    <td><strong>@incident.Title</strong></td>
                                    <td class="td-muted">@incident.Location</td>
                                    <td><span class="badge badge-@incident.Severity.ToLower()">@incident.Severity</span></td>
                                    <td><span class="status-badge status-@incident.Status.ToLower().Replace(" ","")">@incident.Status</span></td>
                                    <td class="td-muted">@incident.ReportedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td><a href="/Admin/IncidentDetail/@incident.Id" class="btn-view">View</a></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6"><div class="empty-state"><i class="fas fa-folder-open"></i><p>No recent incidents</p></div></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ===== INCIDENTS SECTION ===== -->
        <div id="incidentsSection" class="hide">
            <div class="section-header">
                <h2 class="section-title"><i class="fas fa-list-alt"></i> All Incidents</h2>
            </div>
            <div class="filter-bar">
                <select id="statusFilter">
                    <option value="">All Status</option>
                    <option value="Open">Open</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Resolved">Resolved</option>
                </select>
                <select id="severityFilter">
                    <option value="">All Severity</option>
                    <option value="Critical">Critical</option>
                    <option value="High">High</option>
                    <option value="Medium">Medium</option>
                    <option value="Low">Low</option>
                </select>
                <button class="btn-primary btn-sm" onclick="loadAllIncidents()"><i class="fas fa-filter"></i> Filter</button>
                <button class="btn-ghost btn-sm" onclick="clearFilters()"><i class="fas fa-times"></i> Clear</button>
            </div>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr><th>Title</th><th>Location</th><th>Department</th><th>Severity</th><th>Status</th><th>Reported At</th><th>Action</th></tr>
                    </thead>
                    <tbody id="allIncidentsTable">
                        <tr><td colspan="7"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Loading...</p></div></td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ===== OPERATORS SECTION ===== -->
        <div id="operatorsSection" class="hide">
            <div class="section-header">
                <h2 class="section-title"><i class="fas fa-users-cog"></i> Operators Management</h2>
                <button class="btn-primary" onclick="openAddOperatorModal()"><i class="fas fa-plus"></i> Add Operator</button>
            </div>
            <div class="table-wrapper">
                <table>
                    <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Department</th><th>Actions</th></tr></thead>
                    <tbody id="operatorsTable">
                        <tr><td colspan="5"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Loading...</p></div></td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ===== CITIZENS SECTION ===== -->
        <div id="citizensSection" class="hide">
            <div class="section-header">
                <h2 class="section-title"><i class="fas fa-user"></i> Citizens Management</h2>
            </div>
            <div class="table-wrapper">
                <table>
                    <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Actions</th></tr></thead>
                    <tbody id="citizensTable">
                        <tr><td colspan="5"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Loading...</p></div></td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ===== ANALYTICS SECTION ===== -->
        <div id="analyticsSection" class="hide">
            <div class="section-header">
                <h2 class="section-title"><i class="fas fa-chart-line"></i> Analytics Dashboard</h2>
            </div>
            <div class="charts-grid">
                <div class="chart-card">
                    <div class="chart-title"><i class="fas fa-building"></i> Department-wise Incidents</div>
                    <div class="chart-canvas-wrapper"><canvas id="deptChart"></canvas></div>
                    <div id="deptChartError" class="chart-error hide"></div>
                </div>
                <div class="chart-card">
                    <div class="chart-title"><i class="fas fa-chart-bar"></i> Severity Overview</div>
                    <div class="chart-canvas-wrapper"><canvas id="analyticsSeverityChart"></canvas></div>
                    <div id="analyticsSeverityError" class="chart-error hide"></div>
                </div>
            </div>
            <div class="chart-card" style="margin-top:20px;">
                <div class="chart-title"><i class="fas fa-chart-area"></i> Weekly Trend — Total vs Resolved</div>
                <div class="chart-canvas-wrapper"><canvas id="trendDetailChart"></canvas></div>
                <div id="trendDetailError" class="chart-error hide"></div>
            </div>
        </div>

        <!-- ===== REPORTS SECTION ===== -->
        <div id="reportsSection" class="hide">
            <div class="section-header">
                <h2 class="section-title"><i class="fas fa-file-alt"></i> Generate Reports</h2>
            </div>
            <p style="color:var(--text-secondary); font-size:13px; margin-bottom:24px;">
                Export filtered incident reports in CSV, JSON, or PDF format.
            </p>

            <!-- Custom Report -->
            <div class="chart-card" style="margin-bottom:28px;">
                <div class="chart-title"><i class="fas fa-sliders-h"></i> Custom Report</div>
                <div class="report-form-grid">
                    <div class="form-group"><label>Start Date</label><input type="date" id="reportStartDate" /></div>
                    <div class="form-group"><label>End Date</label><input type="date" id="reportEndDate" /></div>
                    <div class="form-group">
                        <label>Department</label>
                        <select id="reportDepartment">
                            <option value="">All Departments</option>
                            <option value="Fire Department">Fire</option>
                            <option value="Police Department">Police</option>
                            <option value="Rescue Department">Rescue</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Severity</label>
                        <select id="reportSeverity">
                            <option value="">All Severities</option>
                            <option value="Critical">Critical</option>
                            <option value="High">High</option>
                            <option value="Medium">Medium</option>
                            <option value="Low">Low</option>
                        </select>
                    </div>
                </div>
                <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
                    <button class="btn-ghost" onclick="previewCount()"><i class="fas fa-eye"></i> Preview Count</button>
                    <span id="previewResult" class="preview-result"></span>
                    <div class="download-dropdown">
                        <button class="btn-primary" onclick="toggleDownloadMenu()"><i class="fas fa-download"></i> Download <i class="fas fa-chevron-down" style="font-size:11px;"></i></button>
                        <div class="download-menu" id="downloadMenu">
                            <a href="#" onclick="downloadCustomReport('csv'); return false;"><i class="fas fa-file-csv"></i> CSV</a>
                            <a href="#" onclick="downloadCustomReport('json'); return false;"><i class="fas fa-file-code"></i> JSON</a>
                            <a href="#" onclick="downloadCustomReport('pdf'); return false;"><i class="fas fa-file-pdf"></i> PDF</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Presets -->
            <h3 style="font-size:15px; font-weight:700; color:var(--text-primary); margin-bottom:14px;">Quick Presets</h3>
            <div class="report-cards">
                <div class="report-card">
                    <div class="rc-icon"><i class="fas fa-calendar-day"></i></div>
                    <h3>Today's Report</h3>
                    <p>All incidents reported today</p>
                    <button class="btn-primary" onclick="downloadQuickReport('today')"><i class="fas fa-download"></i> Download CSV</button>
                </div>
                <div class="report-card">
                    <div class="rc-icon"><i class="fas fa-calendar-week"></i></div>
                    <h3>Weekly Report</h3>
                    <p>Last 7 days summary</p>
                    <button class="btn-primary" onclick="downloadQuickReport('weekly')"><i class="fas fa-download"></i> Download CSV</button>
                </div>
                <div class="report-card">
                    <div class="rc-icon"><i class="fas fa-calendar-alt"></i></div>
                    <h3>Monthly Report</h3>
                    <p>Last 30 days overview</p>
                    <button class="btn-primary" onclick="downloadQuickReport('monthly')"><i class="fas fa-download"></i> Download CSV</button>
                </div>
            </div>
            <p style="margin-top:20px; color:#94A3B8; text-align:center; font-size:12px;">
                <i class="fas fa-info-circle"></i> PDF export requires iTextSharp. All other formats are available instantly.
            </p>
        </div>

    </div><!-- /content-area -->
</div><!-- /main-content -->

<!-- ===== CONFIRM DELETE MODAL ===== -->
<div id="confirmModal" class="modal">
    <div class="modal-content">
        <h3><i class="fas fa-exclamation-triangle" style="color:var(--red); margin-right:8px;"></i> Confirm Delete</h3>
        <p id="confirmMessage" style="color:var(--text-secondary); font-size:14px; line-height:1.6;">Are you sure you want to delete this record? This action cannot be undone.</p>
        <div class="modal-buttons">
            <button class="btn-cancel" onclick="closeConfirmModal()">Cancel</button>
            <button class="btn-confirm" id="confirmDeleteBtn">Yes, Delete</button>
        </div>
    </div>
</div>

<!-- ===== ADD/EDIT MODAL ===== -->
<div id="operatorModal" class="modal">
    <div class="modal-content">
        <h3 id="modalTitle">Add New Operator</h3>
        <input type="hidden" id="entityType" value="operator" />
        <input type="hidden" id="entityId" />
        <input type="text"     id="opName"     placeholder="Full Name" />
        <input type="email"    id="opEmail"    placeholder="Email Address" />
        <input type="text"     id="opPhone"    placeholder="Phone Number" />
        <select id="opDepartment">
            <option value="">Select Department</option>
            <option value="Fire">Fire Department</option>
            <option value="Police">Police Department</option>
            <option value="Rescue">Rescue Department</option>
        </select>
        <input type="password" id="opPassword" placeholder="Password (leave blank to keep unchanged)" />
        <div class="modal-buttons">
            <button class="btn-primary" onclick="saveEntity()"><i class="fas fa-save"></i> Save</button>
            <button class="btn-cancel" onclick="closeModal('operatorModal')">Cancel</button>
        </div>
    </div>
</div>

<script>
    // ===== STATE =====
    let confirmCallback = null;
    let dashboardChartsLoaded = false;
    let analyticsChartsLoaded = false;
    let allCitizens = [];
    let allOperators = [];

    const CHART_DEFAULTS = {
        plugins: { legend: { labels: { color: '#6B7280', font: { family: 'Plus Jakarta Sans', size: 12 }, boxWidth: 12 } } },
        scales: {
            y: { ticks: { color: '#6B7280', font: { family: 'Plus Jakarta Sans' } }, grid: { color: '#F1F5F9' } },
            x: { ticks: { color: '#6B7280', font: { family: 'Plus Jakarta Sans' } }, grid: { color: '#F1F5F9' } }
        }
    };

    // ===== SIDEBAR TOGGLE =====
    function toggleSidebar() {
        const sb = document.getElementById('sidebar');
        const mc = document.getElementById('mainContent');
        sb.classList.toggle('collapsed');
        mc.classList.toggle('expanded');
    }

    // ===== DROPDOWN =====
    function toggleDropdown() { document.getElementById('adminDropdown').classList.toggle('active'); }
    window.addEventListener('click', e => {
        if (!e.target.closest('.user-menu')) document.getElementById('adminDropdown').classList.remove('active');
    });

    // ===== SECTION NAV =====
    const sectionMeta = {
        dashboard: { title: 'Dashboard', sub: 'Overview of your city\'s incident response', icon: 'fas fa-chart-pie' },
        incidents:  { title: 'All Incidents', sub: 'Browse and filter incident records', icon: 'fas fa-list-alt' },
        operators:  { title: 'Operators', sub: 'Manage operator accounts and departments', icon: 'fas fa-users-cog' },
        citizens:   { title: 'Citizens', sub: 'Manage registered citizen accounts', icon: 'fas fa-user' },
        analytics:  { title: 'Analytics', sub: 'Charts and insights across departments', icon: 'fas fa-chart-line' },
        reports:    { title: 'Reports', sub: 'Generate and download incident reports', icon: 'fas fa-file-alt' },
    };

    function showSection(section) {
        document.querySelectorAll('.nav-item').forEach(item => {
            item.classList.toggle('active', item.getAttribute('data-page') === section);
        });
        ['dashboard','incidents','operators','citizens','analytics','reports'].forEach(s => {
            document.getElementById(s + 'Section').classList.toggle('hide', s !== section);
        });
        const meta = sectionMeta[section];
        document.getElementById('topbarIcon').innerHTML = `<i class="${meta.icon}"></i>`;
        document.getElementById('topbarTitle').innerText = meta.title;
        document.getElementById('topbarSub').innerText = meta.sub;

        if (section === 'incidents')  loadAllIncidents();
        if (section === 'operators')  loadOperators();
        if (section === 'citizens')   loadCitizens();
        if (section === 'analytics')  { if (!analyticsChartsLoaded) loadAnalytics(); else resizeAnalyticsCharts(); }
        if (section === 'dashboard')  { if (!dashboardChartsLoaded) loadDashboardCharts(); else resizeDashboardCharts(); }
    }

    function resizeDashboardCharts() {
        [window.trendChart, window.severityChart].forEach(c => c && c.resize());
    }
    function resizeAnalyticsCharts() {
        [window.deptChart, window.analyticsSevChart, window.trendDetailChart].forEach(c => c && c.resize());
    }

    // ===== CHART HELPERS =====
    function showChartError(canvasId, errId, msg) {
        const c = document.getElementById(canvasId);
        const e = document.getElementById(errId);
        if (c) c.style.display = 'none';
        if (e) { e.classList.remove('hide'); e.innerText = msg; }
    }
    function hideChartError(canvasId, errId) {
        const c = document.getElementById(canvasId);
        const e = document.getElementById(errId);
        if (c) c.style.display = 'block';
        if (e) e.classList.add('hide');
    }
    function safeDestroy(chart) { if (chart && typeof chart.destroy === 'function') chart.destroy(); }

    // ===== DASHBOARD CHARTS =====
    function loadDashboardCharts() {
        fetch('/Admin/GetAnalyticsJson', { credentials: 'same-origin' })
            .then(r => { if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.json(); })
            .then(data => {
                if (!data.trend || !data.severity) throw new Error('Invalid data format');

                hideChartError('trendChart', 'trendChartError');
                safeDestroy(window.trendChart);
                window.trendChart = new Chart(document.getElementById('trendChart').getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: data.trend.map(t => t.date),
                        datasets: [{ label: 'Incidents', data: data.trend.map(t => t.total), borderColor: '#2563EB', backgroundColor: 'rgba(37,99,235,0.08)', fill: true, tension: 0.4, pointBackgroundColor: '#2563EB', pointRadius: 4 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, ...CHART_DEFAULTS }
                });

                hideChartError('severityChart', 'severityChartError');
                safeDestroy(window.severityChart);
                window.severityChart = new Chart(document.getElementById('severityChart').getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Critical','High','Medium','Low'],
                        datasets: [{ data: [data.severity.critical, data.severity.high, data.severity.medium, data.severity.low], backgroundColor: ['#DC2626','#F97316','#F59E0B','#10B981'], borderWidth: 0, hoverOffset: 6 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '65%', plugins: CHART_DEFAULTS.plugins }
                });

                dashboardChartsLoaded = true;
            })
            .catch(err => {
                showChartError('trendChart', 'trendChartError', 'Could not load trend data: ' + err.message);
                showChartError('severityChart', 'severityChartError', 'Could not load severity data: ' + err.message);
            });
    }

    // ===== INCIDENTS =====
    async function loadAllIncidents() {
        const status   = document.getElementById('statusFilter').value;
        const severity = document.getElementById('severityFilter').value;
        let url = '/Admin/GetAllIncidentsJson';
        const params = [];
        if (status)   params.push(`status=${encodeURIComponent(status)}`);
        if (severity) params.push(`severity=${encodeURIComponent(severity)}`);
        if (params.length) url += '?' + params.join('&');

        const tbody = document.getElementById('allIncidentsTable');
        tbody.innerHTML = '<tr><td colspan="7"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Loading...</p></div></td></tr>';

        try {
            const res = await fetch(url, { credentials: 'same-origin' });
            const incidents = await res.json();
            tbody.innerHTML = '';
            if (!incidents.length) {
                tbody.innerHTML = '<tr><td colspan="7"><div class="empty-state"><i class="fas fa-folder-open"></i><p>No incidents found</p></div></td></tr>';
                return;
            }
            incidents.forEach(i => {
                const row = tbody.insertRow();
                row.innerHTML = `
                    <td><strong>${escapeHtml(i.title)}</strong></td>
                    <td class="td-muted">${escapeHtml(i.location)}</td>
                    <td class="td-muted">${i.department || '—'}</td>
                    <td><span class="badge badge-${i.severity?.toLowerCase()}">${i.severity}</span></td>
                    <td><span class="status-badge status-${i.status?.toLowerCase().replace(/ /g,'')}">${i.status}</span></td>
                    <td class="td-muted">${new Date(i.reportedAt).toLocaleString()}</td>
                    <td><a href="/Admin/IncidentDetail/${i.id}" class="btn-view">View</a></td>`;
            });
        } catch (err) { console.error(err); }
    }

    function clearFilters() {
        document.getElementById('statusFilter').value   = '';
        document.getElementById('severityFilter').value = '';
        loadAllIncidents();
    }

    function escapeHtml(text) {
        return text ? String(text).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m])) : '';
    }

    // ===== OPERATORS =====
    async function loadOperators() {
        try {
            const res = await fetch('/Admin/GetOperatorsJson', { credentials: 'same-origin' });
            allOperators = await res.json();
            renderOperatorsTable(allOperators);
        } catch (err) { console.error(err); }
    }
    function renderOperatorsTable(operators) {
        const tbody = document.getElementById('operatorsTable');
        if (!operators.length) { tbody.innerHTML = '<tr><td colspan="5"><div class="empty-state"><i class="fas fa-users-slash"></i><p>No operators found</p></div></td></tr>'; return; }
        tbody.innerHTML = '';
        operators.forEach(op => {
            const row = tbody.insertRow();
            row.innerHTML = `
                <td><strong>${escapeHtml(op.name)}</strong></td>
                <td class="td-muted">${escapeHtml(op.email)}</td>
                <td class="td-muted">${escapeHtml(op.phone || '—')}</td>
                <td>${op.department || '—'}</td>
                <td><div class="action-buttons">
                    <button class="btn-edit" onclick="editOperator('${op.id}')"><i class="fas fa-edit"></i> Edit</button>
                    <button class="btn-delete" onclick="deleteOperator('${op.id}')"><i class="fas fa-trash"></i> Delete</button>
                </div></td>`;
        });
    }

    function openAddOperatorModal() {
        document.getElementById('entityType').value = 'operator';
        document.getElementById('entityId').value   = '';
        document.getElementById('modalTitle').innerText = 'Add New Operator';
        ['opName','opEmail','opPhone','opPassword'].forEach(id => document.getElementById(id).value = '');
        document.getElementById('opDepartment').value = '';
        document.getElementById('opDepartment').style.display = 'block';
        document.getElementById('operatorModal').classList.add('active');
    }

    function editOperator(id) {
        const op = allOperators.find(o => o.id === id);
        if (!op) return;
        document.getElementById('entityType').value    = 'operator';
        document.getElementById('entityId').value      = op.id;
        document.getElementById('modalTitle').innerText = 'Edit Operator';
        document.getElementById('opName').value        = op.name || '';
        document.getElementById('opEmail').value       = op.email || '';
        document.getElementById('opPhone').value       = op.phone || '';
        document.getElementById('opDepartment').value  = op.department || '';
        document.getElementById('opDepartment').style.display = 'block';
        document.getElementById('opPassword').value   = '';
        document.getElementById('operatorModal').classList.add('active');
    }

    async function deleteOperator(id) {
        showConfirmModal('Delete this operator permanently?', async () => {
            const res = await fetch('/Admin/DeleteOperator', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({id}), credentials:'same-origin' });
            const result = await res.json();
            alert(result.message);
            loadOperators();
        });
    }

    // ===== CITIZENS =====
    async function loadCitizens() {
        try {
            const res = await fetch('/Admin/GetCitizensJson', { credentials: 'same-origin' });
            allCitizens = await res.json();
            renderCitizensTable(allCitizens);
        } catch (err) { console.error(err); }
    }
    function renderCitizensTable(citizens) {
        const tbody = document.getElementById('citizensTable');
        if (!citizens.length) { tbody.innerHTML = '<tr><td colspan="5"><div class="empty-state"><i class="fas fa-user-slash"></i><p>No citizens found</p></div></td></tr>'; return; }
        tbody.innerHTML = '';
        citizens.forEach(c => {
            const row = tbody.insertRow();
            row.innerHTML = `
                <td><strong>${escapeHtml(c.name)}</strong></td>
                <td class="td-muted">${escapeHtml(c.email)}</td>
                <td class="td-muted">${escapeHtml(c.phone || '—')}</td>
                <td><span class="badge badge-low">${escapeHtml(c.role)}</span></td>
                <td><div class="action-buttons">
                    <button class="btn-edit" onclick="editCitizen('${c.id}')"><i class="fas fa-edit"></i> Edit</button>
                    <button class="btn-delete" onclick="deleteCitizen('${c.id}')"><i class="fas fa-trash"></i> Delete</button>
                </div></td>`;
        });
    }

    function editCitizen(id) {
        const c = allCitizens.find(x => x.id === id);
        if (!c) return;
        document.getElementById('entityType').value    = 'citizen';
        document.getElementById('entityId').value      = c.id;
        document.getElementById('modalTitle').innerText = 'Edit Citizen';
        document.getElementById('opName').value        = c.name || '';
        document.getElementById('opEmail').value       = c.email || '';
        document.getElementById('opPhone').value       = c.phone || '';
        document.getElementById('opDepartment').style.display = 'none';
        document.getElementById('opPassword').value   = '';
        document.getElementById('operatorModal').classList.add('active');
    }

    async function deleteCitizen(id) {
        showConfirmModal('Delete this citizen permanently?', async () => {
            const res = await fetch('/Admin/DeleteCitizen', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({id}), credentials:'same-origin' });
            const result = await res.json();
            alert(result.message);
            loadCitizens();
        });
    }

    // ===== SAVE ENTITY =====
    async function saveEntity() {
        const entityType = document.getElementById('entityType').value;
        const id = document.getElementById('entityId').value;
        const data = {
            Id:           id,
            Name:         document.getElementById('opName').value.trim(),
            Email:        document.getElementById('opEmail').value.trim(),
            Phone:        document.getElementById('opPhone').value.trim(),
            PasswordHash: document.getElementById('opPassword').value,
            Department:   entityType === 'operator' ? document.getElementById('opDepartment').value : null,
            Role:         entityType === 'operator' ? 'Operator' : 'Citizen'
        };
        const url = entityType === 'operator'
            ? (id ? '/Admin/UpdateOperator?id=' + id : '/Admin/CreateOperator')
            : (id ? '/Admin/UpdateCitizen?id=' + id  : '/Admin/CreateCitizen');
        try {
            const res = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data), credentials:'same-origin' });
            const result = await res.json();
            if (result.success) { alert(result.message); closeModal('operatorModal'); entityType === 'operator' ? loadOperators() : loadCitizens(); }
            else alert('Error: ' + result.message);
        } catch { alert('Network error'); }
    }

    function closeModal(id) { document.getElementById(id).classList.remove('active'); }

    // ===== CONFIRM MODAL =====
    function showConfirmModal(message, onConfirm) {
        document.getElementById('confirmMessage').innerText = message;
        confirmCallback = onConfirm;
        document.getElementById('confirmModal').classList.add('active');
    }
    function closeConfirmModal() {
        document.getElementById('confirmModal').classList.remove('active');
        confirmCallback = null;
    }
    document.getElementById('confirmDeleteBtn').addEventListener('click', () => {
        if (confirmCallback) { confirmCallback(); closeConfirmModal(); }
    });
    window.onclick = e => {
        if (e.target.classList.contains('modal')) {
            e.target.classList.remove('active');
            if (e.target.id === 'confirmModal') closeConfirmModal();
        }
    };

    // ===== ANALYTICS =====
    function loadAnalytics() {
        fetch('/Admin/GetAnalyticsJson', { credentials: 'same-origin' })
            .then(r => { if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.json(); })
            .then(data => {
                if (!data.departments || !data.severity || !data.trend) throw new Error('Invalid data');

                hideChartError('deptChart','deptChartError');
                safeDestroy(window.deptChart);
                window.deptChart = new Chart(document.getElementById('deptChart').getContext('2d'), {
                    type: 'doughnut',
                    data: { labels: data.departments.map(d => d.department), datasets: [{ data: data.departments.map(d => d.count), backgroundColor: ['#DC2626','#2563EB','#10B981','#F59E0B'], borderWidth: 0, hoverOffset: 6 }] },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '60%', plugins: CHART_DEFAULTS.plugins }
                });

                hideChartError('analyticsSeverityChart','analyticsSeverityError');
                safeDestroy(window.analyticsSevChart);
                window.analyticsSevChart = new Chart(document.getElementById('analyticsSeverityChart').getContext('2d'), {
                    type: 'bar',
                    data: { labels: ['Critical','High','Medium','Low'], datasets: [{ label: 'Count', data: [data.severity.critical, data.severity.high, data.severity.medium, data.severity.low], backgroundColor: ['#DC2626','#F97316','#F59E0B','#10B981'], borderRadius: 6 }] },
                    options: { responsive: true, maintainAspectRatio: false, ...CHART_DEFAULTS, plugins: { legend: { display: false } } }
                });

                hideChartError('trendDetailChart','trendDetailError');
                safeDestroy(window.trendDetailChart);
                window.trendDetailChart = new Chart(document.getElementById('trendDetailChart').getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: data.trend.map(t => t.date),
                        datasets: [
                            { label: 'Total', data: data.trend.map(t => t.total), borderColor: '#2563EB', backgroundColor: 'rgba(37,99,235,0.07)', fill: true, tension: 0.4, pointRadius: 4, pointBackgroundColor: '#2563EB' },
                            { label: 'Resolved', data: data.trend.map(t => t.resolved), borderColor: '#10B981', backgroundColor: 'rgba(16,185,129,0.07)', fill: true, tension: 0.4, pointRadius: 4, pointBackgroundColor: '#10B981' }
                        ]
                    },
                    options: { responsive: true, maintainAspectRatio: false, ...CHART_DEFAULTS }
                });
                analyticsChartsLoaded = true;
            })
            .catch(err => {
                showChartError('deptChart','deptChartError','Could not load department data: '+err.message);
                showChartError('analyticsSeverityChart','analyticsSeverityError','Could not load severity data: '+err.message);
                showChartError('trendDetailChart','trendDetailError','Could not load trend data: '+err.message);
            });
    }

    // ===== REPORTS =====
    function toggleDownloadMenu() {
        const menu = document.getElementById('downloadMenu');
        menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        setTimeout(() => {
            window.addEventListener('click', function closeMenu(e) {
                if (!e.target.closest('.download-dropdown')) { menu.style.display = 'none'; window.removeEventListener('click', closeMenu); }
            });
        }, 10);
    }

    function downloadQuickReport(type) {
        const today = new Date().toISOString().split('T')[0];
        let start, end = today;
        if (type === 'today')   start = today;
        if (type === 'weekly')  start = new Date(Date.now() - 7*86400000).toISOString().split('T')[0];
        if (type === 'monthly') start = new Date(Date.now() - 30*86400000).toISOString().split('T')[0];
        window.open(`/Admin/ExportReport?startDate=${start}&endDate=${end}`, '_blank');
    }

    async function previewCount() {
        const start = document.getElementById('reportStartDate').value;
        const end   = document.getElementById('reportEndDate').value;
        const dept  = document.getElementById('reportDepartment').value;
        const sev   = document.getElementById('reportSeverity').value;
        let url = '/Admin/GetAllIncidentsJson';
        const params = [];
        if (start) params.push(`startDate=${start}`);
        if (end)   params.push(`endDate=${end}`);
        if (dept)  params.push(`department=${encodeURIComponent(dept)}`);
        if (sev)   params.push(`severity=${encodeURIComponent(sev)}`);
        if (params.length) url += '?' + params.join('&');
        try {
            const res = await fetch(url, { credentials: 'same-origin' });
            const incidents = await res.json();
            document.getElementById('previewResult').innerText = `${incidents.length} incidents found`;
        } catch { document.getElementById('previewResult').innerText = 'Error fetching count'; }
    }

    async function downloadCustomReport(format) {
        const start = document.getElementById('reportStartDate').value;
        const end   = document.getElementById('reportEndDate').value;
        const dept  = document.getElementById('reportDepartment').value;
        const sev   = document.getElementById('reportSeverity').value;

        const buildQuery = () => {
            const p = [];
            if (start) p.push(`startDate=${start}`);
            if (end)   p.push(`endDate=${end}`);
            if (dept)  p.push(`department=${encodeURIComponent(dept)}`);
            if (sev)   p.push(`severity=${encodeURIComponent(sev)}`);
            return p.join('&');
        };

        if (format === 'csv') {
            window.open('/Admin/ExportReport?' + buildQuery(), '_blank');
        } else if (format === 'json') {
            try {
                const res = await fetch('/Admin/GetAllIncidentsJson?' + buildQuery(), { credentials: 'same-origin' });
                const data = await res.json();
                const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = `IncidentReport_${new Date().toISOString().slice(0,10)}.json`;
                link.click();
                URL.revokeObjectURL(link.href);
            } catch { alert('Error generating JSON report.'); }
        } else if (format === 'pdf') {
            window.open('/Admin/ExportPdfReport?' + buildQuery(), '_blank');
        }
        document.getElementById('downloadMenu').style.display = 'none';
    }

    // ===== INIT =====
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof Chart === 'undefined') {
            document.querySelectorAll('.chart-canvas-wrapper').forEach(w => {
                w.innerHTML = '<p class="chart-error">Chart.js failed to load. Check your internet connection.</p>';
            });
        } else {
            loadDashboardCharts();
        }
    });
</script>
</body>
</html>