        <!-- ANALYTICS -->
        <div id="analyticsSection" class="hide">
            <div class="section-header"><h2 class="section-title"><i class="fas fa-chart-line"></i> Analytics Dashboard</h2></div>
            <div class="charts-grid">
                <div class="chart-card"><div class="chart-title"><i class="fas fa-building"></i> Department-wise Incidents</div><div class="chart-canvas-wrapper"><canvas id="deptChart"></canvas></div><div id="deptChartError" class="chart-error hide"></div></div>
                <div class="chart-card"><div class="chart-title"><i class="fas fa-chart-bar"></i> Severity Overview</div><div class="chart-canvas-wrapper"><canvas id="analyticsSeverityChart"></canvas></div><div id="analyticsSeverityError" class="chart-error hide"></div></div>
            </div>
            <div class="chart-card" style="margin-top:20px;">
                <div class="chart-title"><i class="fas fa-chart-area"></i> Weekly Trend — Total vs Resolved</div>
