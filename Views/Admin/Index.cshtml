document.addEventListener('DOMContentLoaded',()=>{
    updateNotificationBadge();
    if(typeof Chart==='undefined'){document.querySelectorAll('.chart-canvas-wrapper').forEach(w=>{w.innerHTML='<p class="chart-error">Chart.js failed to load.</p>';});}
    else{loadDashboardCharts();}
});
