    // ========== SAVE ENTITY ==========
    async function saveEntity() {
        const entityType = document.getElementById('entityType').value;
        const id = document.getElementById('entityId').value;
        const data = {
            Id:           id,
            Name:         document.getElementById('opName').value.trim(),
            Email:        document.getElementById('opEmail').value.trim(),
            Phone:        document.getElementById('opPhone').value.trim(),
            PasswordHash: document.getElementById('opPassword').value,
            Department:   entityType === 'operator' ? document.getElementById('opDepartment').value : null,
            Role:         entityType === 'operator' ? 'Operator' : 'Citizen'
        };
        const url = entityType === 'operator'
            ? (id ? '/Admin/UpdateOperator?id=' + id : '/Admin/CreateOperator')
            : (id ? '/Admin/UpdateCitizen?id=' + id  : '/Admin/CreateCitizen');
        try {
            const res = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data), credentials:'same-origin' });
