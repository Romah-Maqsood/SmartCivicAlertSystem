                        <div class="pm-strength-bar"><div class="pm-strength-fill" id="pwStrengthFill"></div></div>
                        <span class="pm-strength-text" id="pwStrengthText"></span>
                        <div class="pm-pw-reqs">
                            <div class="pm-pw-req" id="req-len"><i class="fas fa-circle" style="font-size:7px;"></i> 8+ chars</div>
                            <div class="pm-pw-req" id="req-up"><i class="fas fa-circle" style="font-size:7px;"></i> Uppercase</div>
