    // ========== ANALYTICS ==========
    function loadAnalytics() {
        fetch('/Admin/GetAnalyticsJson', { credentials: 'same-origin' })
            .then(r => { if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.json(); })
            .then(data => {
                if (!data.departments || !data.severity || !data.trend) throw new Error('Invalid data');
                const allowedDepts = ['Fire Department','Police Department','Rescue Department','Unassigned'];
                const deptCounts = {};
                allowedDepts.forEach(d => deptCounts[d] = 0);
                let othersCount = 0;
                data.departments.forEach(d => {
                    if (allowedDepts.includes(d.department)) deptCounts[d.department] += d.count;
                    else othersCount += d.count;
                });
                deptCounts['Unassigned'] += othersCount;
                const deptLabels = [], deptData = [];
                for (const [dept, cnt] of Object.entries(deptCounts)) { deptLabels.push(dept); deptData.push(cnt); }

                hideChartError('deptChart','deptChartError');
                safeDestroy(window.deptChart);
                window.deptChart = new Chart(document.getElementById('deptChart').getContext('2d'), {
                    type: 'doughnut',
                    data: { labels: deptLabels, datasets: [{ data: deptData, backgroundColor: ['#6366F1','#EC4899','#10B981','#F59E0B'], borderWidth: 0, hoverOffset: 6 }] },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '60%', plugins: CHART_DEFAULTS.plugins }
                });
                hideChartError('analyticsSeverityChart','analyticsSeverityError');
                safeDestroy(window.analyticsSevChart);
                window.analyticsSevChart = new Chart(document.getElementById('analyticsSeverityChart').getContext('2d'), {
                    type: 'bar',
                    data: { labels: ['Critical','High','Medium','Low'], datasets: [{ label: 'Count', data: [data.severity.critical, data.severity.high, data.severity.medium, data.severity.low], backgroundColor: ['#DC2626','#F97316','#F59E0B','#10B981'], borderRadius: 6 }] },
                    options: { responsive: true, maintainAspectRatio: false, ...CHART_DEFAULTS, plugins: { legend: { display: false } } }
                });
                hideChartError('trendDetailChart','trendDetailError');
                safeDestroy(window.trendDetailChart);
                window.trendDetailChart = new Chart(document.getElementById('trendDetailChart').getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: data.trend.map(t => t.date),
                        datasets: [
                            { label: 'Total', data: data.trend.map(t => t.total), borderColor: '#2563EB', backgroundColor: 'rgba(37,99,235,0.07)', fill: true, tension: 0.4, pointRadius: 4, pointBackgroundColor: '#2563EB' },
                            { label: 'Resolved', data: data.trend.map(t => t.resolved), borderColor: '#10B981', backgroundColor: 'rgba(16,185,129,0.07)', fill: true, tension: 0.4, pointRadius: 4, pointBackgroundColor: '#10B981' }
                        ]
                    },
                    options: { responsive: true, maintainAspectRatio: false, ...CHART_DEFAULTS }
                });
                analyticsChartsLoaded = true;
            })
            .catch(err => {
                showChartError('deptChart','deptChartError','Could not load department data: '+err.message);
                showChartError('analyticsSeverityChart','analyticsSeverityError','Could not load severity data: '+err.message);
                showChartError('trendDetailChart','trendDetailError','Could not load trend data: '+err.message);
            });
    }

