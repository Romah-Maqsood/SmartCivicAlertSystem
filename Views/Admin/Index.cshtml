                <div class="report-card"><div class="rc-icon"><i class="fas fa-calendar-week"></i></div><h3>Weekly Report</h3><p>Last 7 days summary</p><div class="download-dropdown"><button class="btn-primary" onclick="toggleQuickMenu('weekly')"><i class="fas fa-download"></i> Download <i class="fas fa-chevron-down" style="font-size:11px;"></i></button><div class="download-menu" id="quickMenu-weekly"><a href="#" onclick="downloadQuickReport('weekly','csv');return false;"><i class="fas fa-file-csv"></i> CSV</a><a href="#" onclick="downloadQuickReport('weekly','json');return false;"><i class="fas fa-file-code"></i> JSON</a><a href="#" onclick="downloadQuickReport('weekly','pdf');return false;"><i class="fas fa-file-pdf"></i> PDF</a></div></div></div>
