                <div id="trendDetailError" class="chart-error hide"></div>
            </div>
        </div>

        <!-- REPORTS -->
        <div id="reportsSection" class="hide">
            <div class="section-header"><h2 class="section-title"><i class="fas fa-file-alt"></i> Generate Reports</h2></div>
            <p style="color:var(--text-secondary);font-size:13px;margin-bottom:24px;">Export filtered incident reports in CSV, JSON, or PDF format.</p>
            <div class="chart-card" style="margin-bottom:28px;">
                <div class="chart-title"><i class="fas fa-sliders-h"></i> Custom Report</div>
                <div class="report-form-grid">
                    <div class="form-group"><label>Start Date</label><input type="date" id="reportStartDate" /></div>
                    <div class="form-group"><label>End Date</label><input type="date" id="reportEndDate" /></div>
                    <div class="form-group"><label>Department</label><select id="reportDepartment"><option value="">All Departments</option><option value="Fire Department">Fire</option><option value="Police Department">Police</option><option value="Rescue Department">Rescue</option></select></div>
                    <div class="form-group"><label>Severity</label><select id="reportSeverity"><option value="">All Severities</option><option value="Critical">Critical</option><option value="High">High</option><option value="Medium">Medium</option><option value="Low">Low</option></select></div>
                </div>
                <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
                    <button class="btn-ghost" onclick="previewCount()"><i class="fas fa-eye"></i> Preview Count</button>
                    <span id="previewResult" class="preview-result"></span>
                    <div class="download-dropdown">
                        <button class="btn-primary" onclick="toggleDownloadMenu()"><i class="fas fa-download"></i> Download <i class="fas fa-chevron-down" style="font-size:11px;"></i></button>
                        <div class="download-menu" id="downloadMenu">
                            <a href="#" onclick="downloadCustomReport('csv');return false;"><i class="fas fa-file-csv"></i> CSV</a>
                            <a href="#" onclick="downloadCustomReport('json');return false;"><i class="fas fa-file-code"></i> JSON</a>
                            <a href="#" onclick="downloadCustomReport('pdf');return false;"><i class="fas fa-file-pdf"></i> PDF</a>
                        </div>
                    </div>
                </div>
            </div>
            <h3 style="font-size:15px;font-weight:700;color:var(--text-primary);margin-bottom:14px;">Quick Presets</h3>
            <div class="report-cards">
                <div class="report-card"><div class="rc-icon"><i class="fas fa-calendar-day"></i></div><h3>Today's Report</h3><p>All incidents reported today</p><button class="btn-primary" onclick="downloadQuickReport('today')"><i class="fas fa-download"></i> Download CSV</button></div>
                <div class="report-card"><div class="rc-icon"><i class="fas fa-calendar-week"></i></div><h3>Weekly Report</h3><p>Last 7 days summary</p><button class="btn-primary" onclick="downloadQuickReport('weekly')"><i class="fas fa-download"></i> Download CSV</button></div>
                <div class="report-card"><div class="rc-icon"><i class="fas fa-calendar-alt"></i></div><h3>Monthly Report</h3><p>Last 30 days overview</p><button class="btn-primary" onclick="downloadQuickReport('monthly')"><i class="fas fa-download"></i> Download CSV</button></div>
            </div>
            <p style="margin-top:20px;color:#94A3B8;text-align:center;font-size:12px;"><i class="fas fa-info-circle"></i> PDF export requires iTextSharp.</p>
        </div>

        <!-- NOTIFICATIONS -->
        <div id="notificationsSection" class="hide">
