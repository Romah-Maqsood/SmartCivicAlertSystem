<script>
// ===== ACTIVITY LOG =====
const ACTIVITY_KEY='sc_admin_activity';
const ACTIVITY_ICONS={login:'fa-sign-in-alt',edit:'fa-edit',create:'fa-plus-circle',delete:'fa-trash',report:'fa-file-alt',view:'fa-eye',filter:'fa-filter'};
function loadActivityLog(){try{return JSON.parse(sessionStorage.getItem(ACTIVITY_KEY)||'[]');}catch{return[];}}
function saveActivityLog(log){try{sessionStorage.setItem(ACTIVITY_KEY,JSON.stringify(log.slice(0,20)));}catch{}}
function logActivity(type,title,meta){const log=loadActivityLog();log.unshift({type,title,meta,time:new Date().toISOString()});saveActivityLog(log);}
function timeAgo(iso){const diff=Math.floor((Date.now()-new Date(iso))/1000);if(diff<60)return'Just now';if(diff<3600)return Math.floor(diff/60)+' min ago';if(diff<86400)return Math.floor(diff/3600)+' hrs ago';return Math.floor(diff/86400)+'d ago';}
function renderActivityLog(){
    const el=document.getElementById('pmActivityList');if(!el)return;
    const log=loadActivityLog();const last5=log.slice(0,5);
    if(!last5.length){el.innerHTML='<div class="pm-act-empty"><i class="fas fa-history"></i>No activity recorded yet</div>';return;}
    el.innerHTML=last5.map(a=>`<div class="pm-activity-item"><div class="pm-act-icon ${a.type}"><i class="fas ${ACTIVITY_ICONS[a.type]||'fa-circle'}"></i></div><div class="pm-act-text"><div class="pm-act-title">${a.title}</div><div class="pm-act-meta">${a.meta}</div></div><span class="pm-act-badge ${a.type}">${a.type.charAt(0).toUpperCase()+a.type.slice(1)}</span><span class="pm-act-time">${timeAgo(a.time)}</span></div>`).join('');
}
function clearActivityLog(){sessionStorage.removeItem(ACTIVITY_KEY);renderActivityLog();showToast('Activity log cleared.','success');}
logActivity('login','Logged into Admin Dashboard','Smart Civic · Admin Panel');

// ===== STATE =====
let confirmCallback=null,dashboardChartsLoaded=false,analyticsChartsLoaded=false;
let allCitizens=[],allOperators=[];
let notifications=[{id:1,title:"New critical incident reported",time:"2 mins ago",read:false},{id:2,title:"Operator John Doe created",time:"1 hour ago",read:false},{id:3,title:"Monthly report generated",time:"3 hours ago",read:true},{id:4,title:"Server backup completed",time:"1 day ago",read:true}];

// ===== CLOCK =====
function updateClock(){const now=new Date();const h=now.getHours(),m=now.getMinutes();const ampm=h>=12?'PM':'AM';const hh=(h%12||12).toString().padStart(2,'0'),mm=m.toString().padStart(2,'0');const el=document.getElementById('clockDisplay');if(el)el.textContent=`${hh}:${mm} ${ampm}`;const dt=document.getElementById('dropdownTime');if(dt)dt.textContent=now.toLocaleDateString('en-PK',{day:'numeric',month:'short',year:'numeric'});}
setInterval(updateClock,1000);updateClock();

// ===== TOAST =====
function showToast(message,type='success'){const container=document.getElementById('toastContainer');const toast=document.createElement('div');toast.className=`toast ${type}`;const icon=type==='success'?'fa-check-circle':'fa-exclamation-circle';toast.innerHTML=`<i class="fas ${icon}"></i><span class="toast-msg">${message}</span><i class="fas fa-times toast-close" onclick="this.parentElement.remove()"></i>`;container.appendChild(toast);setTimeout(()=>{if(toast.parentElement)toast.remove();},4000);}

// ===== NOTIFICATIONS =====
function updateNotificationBadge(){const unread=notifications.filter(n=>!n.read).length;const badge=document.getElementById('notifBadge'),dot=document.getElementById('notifDotTop');if(badge){badge.innerText=unread;badge.style.display=unread>0?'inline-block':'none';}if(dot)dot.style.display=unread>0?'block':'none';}
function renderNotifications(){const container=document.getElementById('notificationList');if(!container)return;container.innerHTML=notifications.map(n=>`<div class="notification-item ${n.read?'':'unread'}" onclick="toggleNotificationRead(${n.id})"><div class="notif-icon"><i class="fas fa-bell"></i></div><div class="notif-content"><div class="notif-title">${n.title}</div><div class="notif-time">${n.time}</div></div><div class="notif-actions"><button class="btn-ghost btn-sm" onclick="event.stopPropagation();toggleNotificationRead(${n.id})"><i class="fas ${n.read?'fa-envelope':'fa-envelope-open'}"></i> ${n.read?'Unread':'Read'}</button></div></div>`).join('');}
function toggleNotificationRead(id){const n=notifications.find(x=>x.id===id);if(n){n.read=!n.read;updateNotificationBadge();renderNotifications();}}

function toggleSidebar(){document.getElementById('sidebar').classList.toggle('collapsed');document.getElementById('mainContent').classList.toggle('expanded');}
function toggleDropdown(event){event.stopPropagation();document.getElementById('adminDropdown').classList.toggle('active');document.getElementById('profileTrigger').classList.toggle('open');}
function closeDropdown(){document.getElementById('adminDropdown').classList.remove('active');document.getElementById('profileTrigger').classList.remove('open');}
window.addEventListener('click',e=>{if(!e.target.closest('.user-menu'))closeDropdown();});

// ===== PROFILE =====
function showProfile(){
    closeDropdown();renderActivityLog();
    const meta=document.getElementById('currentSessionMeta');
    if(meta){const ua=navigator.userAgent;const br=ua.includes('Edg')?'Edge':ua.includes('Chrome')?'Chrome':ua.includes('Firefox')?'Firefox':ua.includes('Safari')?'Safari':'Browser';const os=ua.includes('Windows')?'Windows':ua.includes('Mac')?'macOS':ua.includes('Linux')?'Linux':'Unknown';meta.textContent=`${br} · ${os} · ${new Date().toLocaleTimeString('en-PK',{hour:'2-digit',minute:'2-digit',hour12:true})}`;}
    fetch('/Admin/GetOperatorsJson',{credentials:'same-origin'}).then(r=>r.json()).then(ops=>{const el=document.getElementById('pmStatOperators');if(el)el.textContent=ops.length;}).catch(()=>{});
    document.getElementById('profileModal').classList.add('active');
    logActivity('view','Opened My Profile','Profile Modal');
}
function switchPmTab(tab,btn){document.querySelectorAll('.pm-tab').forEach(t=>t.classList.remove('active'));document.querySelectorAll('.pm-panel').forEach(p=>p.classList.remove('active'));btn.classList.add('active');document.getElementById('pmPanel-'+tab).classList.add('active');if(tab==='activity')renderActivityLog();}
function previewAvatar(event){const file=event.target.files[0];if(!file)return;if(file.size>2*1024*1024){showToast('Image must be under 2MB.','error');return;}const reader=new FileReader();reader.onload=e=>{const src=e.target.result;['pmAvatarLarge','topbarAvatar'].forEach(id=>{const el=document.getElementById(id);if(el)el.innerHTML=`<img src="${src}" alt="avatar" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"/>`;});};reader.readAsDataURL(file);logActivity('edit','Updated profile photo','Profile Settings');}

function togglePwVisibility(inputId,btnId){const input=document.getElementById(inputId),btn=document.getElementById(btnId);if(!input||!btn)return;const isHidden=input.type==='password';input.type=isHidden?'text':'password';btn.innerHTML=isHidden?'<i class="fas fa-eye-slash"></i>':'<i class="fas fa-eye"></i>';}

function checkPasswordStrength(){const pwd=document.getElementById('editPassword').value;const fill=document.getElementById('pwStrengthFill'),text=document.getElementById('pwStrengthText');const hasLen=pwd.length>=8,hasUp=/[A-Z]/.test(pwd),hasNum=/[0-9]/.test(pwd),hasSp=/[^A-Za-z0-9]/.test(pwd);const score=[hasLen,hasUp,hasNum,hasSp].filter(Boolean).length;const labels=['','Weak','Fair','Good','Strong'],colors=['','#DC2626','#F97316','#3B82F6','#10B981'],widths=['0%','25%','55%','78%','100%'];if(fill){fill.style.width=widths[score];fill.style.background=colors[score];}if(text){text.textContent=pwd?labels[score]:'';text.style.color=colors[score];}[['req-len',hasLen],['req-up',hasUp],['req-num',hasNum],['req-sp',hasSp]].forEach(([id,met])=>{const el=document.getElementById(id);if(el)el.classList.toggle('met',met);});}

async function saveProfile(){
    const name=document.getElementById('editName').value.trim();
    const currentPwd=document.getElementById('currentPassword').value;
    const newPwd=document.getElementById('editPassword').value;
    const confirmPwd=document.getElementById('editPasswordConfirm').value;
    if(!name){showToast('Name cannot be empty.','error');return;}
    if(newPwd||confirmPwd||currentPwd){if(!currentPwd){showToast('Please enter your current password.','error');return;}if(newPwd!==confirmPwd){showToast('New passwords do not match.','error');return;}if(newPwd.length<6){showToast('Password must be at least 6 characters.','error');return;}}
    const payload={Name:name,CurrentPassword:currentPwd,NewPassword:newPwd};
    try{const response=await fetch('/Admin/UpdateProfile',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload),credentials:'same-origin'});const result=await response.json();if(result.success){showToast(result.message||'Profile updated!','success');logActivity('edit','Updated profile',(newPwd?'Name + Password changed':'Name: '+name));closeModal('profileModal');}else{showToast(result.message||'Update failed.','error');}}catch(err){showToast('Network error.','error');console.error(err);}
}

// ===== SECTION NAV =====
function showSection(section){
    document.querySelectorAll('.nav-item').forEach(item=>{item.classList.toggle('active',item.getAttribute('data-page')===section);});
    ['dashboard','incidents','operators','citizens','analytics','reports','notifications'].forEach(s=>{document.getElementById(s+'Section').classList.toggle('hide',s!==section);});
    const subtitles={dashboard:"Manage your city's incident response",incidents:"All Incidents",operators:"Operators Management",citizens:"Citizens Management",analytics:"Analytics & Insights",reports:"Generate Reports",notifications:"Notifications"};
    const sub=document.getElementById('topbarSubtitle');if(sub)sub.textContent=subtitles[section]||'';
    if(section==='incidents'){loadAllIncidents();logActivity('view','Viewed All Incidents','Incidents Section');}
    if(section==='operators'){loadOperators();logActivity('view','Viewed Operators','Operators Section');}
    if(section==='citizens'){loadCitizens();logActivity('view','Viewed Citizens','Citizens Section');}
    if(section==='analytics'){if(!analyticsChartsLoaded)loadAnalytics();else resizeAnalyticsCharts();logActivity('view','Opened Analytics Dashboard','Analytics Section');}
    if(section==='dashboard'){if(!dashboardChartsLoaded)loadDashboardCharts();else resizeDashboardCharts();}
    if(section==='reports')logActivity('view','Opened Reports Section','Reports');
    if(section==='notifications')renderNotifications();
}
function resizeDashboardCharts(){[window.trendChart,window.severityChart].forEach(c=>c&&c.resize());}
function resizeAnalyticsCharts(){[window.deptChart,window.analyticsSevChart,window.trendDetailChart].forEach(c=>c&&c.resize());}

// ===== CHARTS =====
function showChartError(cId,eId,msg){const c=document.getElementById(cId),e=document.getElementById(eId);if(c)c.style.display='none';if(e){e.classList.remove('hide');e.innerText=msg;}}
function hideChartError(cId,eId){const c=document.getElementById(cId),e=document.getElementById(eId);if(c)c.style.display='block';if(e)e.classList.add('hide');}
function safeDestroy(chart){if(chart&&typeof chart.destroy==='function')chart.destroy();}
const CHART_DEFAULTS={plugins:{legend:{labels:{color:'#6B7280',font:{family:'Plus Jakarta Sans',size:12},boxWidth:12}}},scales:{y:{ticks:{color:'#6B7280',font:{family:'Plus Jakarta Sans'}},grid:{color:'#F1F5F9'}},x:{ticks:{color:'#6B7280',font:{family:'Plus Jakarta Sans'}},grid:{color:'#F1F5F9'}}}};
function loadDashboardCharts(){fetch('/Admin/GetAnalyticsJson',{credentials:'same-origin'}).then(r=>{if(!r.ok)throw new Error(`HTTP ${r.status}`);return r.json();}).then(data=>{if(!data.trend||!data.severity)throw new Error('Invalid data format');hideChartError('trendChart','trendChartError');safeDestroy(window.trendChart);window.trendChart=new Chart(document.getElementById('trendChart').getContext('2d'),{type:'line',data:{labels:data.trend.map(t=>t.date),datasets:[{label:'Incidents',data:data.trend.map(t=>t.total),borderColor:'#2563EB',backgroundColor:'rgba(37,99,235,0.08)',fill:true,tension:0.4,pointBackgroundColor:'#2563EB',pointRadius:4}]},options:{responsive:true,maintainAspectRatio:false,...CHART_DEFAULTS}});hideChartError('severityChart','severityChartError');safeDestroy(window.severityChart);window.severityChart=new Chart(document.getElementById('severityChart').getContext('2d'),{type:'doughnut',data:{labels:['Critical','High','Medium','Low'],datasets:[{data:[data.severity.critical,data.severity.high,data.severity.medium,data.severity.low],backgroundColor:['#DC2626','#F97316','#F59E0B','#10B981'],borderWidth:0,hoverOffset:6}]},options:{responsive:true,maintainAspectRatio:false,cutout:'65%',plugins:CHART_DEFAULTS.plugins}});dashboardChartsLoaded=true;}).catch(err=>{showChartError('trendChart','trendChartError','Could not load trend data: '+err.message);showChartError('severityChart','severityChartError','Could not load severity data: '+err.message);});}

// ===== INCIDENTS =====
async function loadAllIncidents(){const status=document.getElementById('statusFilter').value,severity=document.getElementById('severityFilter').value;let url='/Admin/GetAllIncidentsJson';const params=[];if(status)params.push(`status=${encodeURIComponent(status)}`);if(severity)params.push(`severity=${encodeURIComponent(severity)}`);if(params.length)url+='?'+params.join('&');const tbody=document.getElementById('allIncidentsTable');tbody.innerHTML='<tr><td colspan="7"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Loading...</p></div></td></tr>';try{const res=await fetch(url,{credentials:'same-origin'});const incidents=await res.json();tbody.innerHTML='';if(!incidents.length){tbody.innerHTML='<tr><td colspan="7"><div class="empty-state"><i class="fas fa-folder-open"></i><p>No incidents found</p></div></td></tr>';return;}incidents.forEach(i=>{const row=tbody.insertRow();row.innerHTML=`<td><strong>${escapeHtml(i.title)}</strong></td><td class="td-muted">${escapeHtml(i.location)}</td><td class="td-muted">${i.department||'—'}</td><td><span class="badge badge-${i.severity?.toLowerCase()}">${i.severity}</span></td><td><span class="status-badge status-${i.status?.toLowerCase().replace(/ /g,'')}">${i.status}</span></td><td class="td-muted">${new Date(i.reportedAt).toLocaleString()}</td><td><button class="btn-view" onclick="viewIncidentDetail('${i.id}')"><i class="fas fa-eye"></i> View</button></td>`;});if(status||severity)logActivity('filter',`Filtered incidents (${incidents.length} results)`,'Status: '+(status||'All')+' · Severity: '+(severity||'All'));}catch(err){console.error(err);}}
function clearFilters(){document.getElementById('statusFilter').value='';document.getElementById('severityFilter').value='';loadAllIncidents();}
function escapeHtml(text){return text?String(text).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m])):''; }

// ===== OPERATORS =====
async function loadOperators(){try{const res=await fetch('/Admin/GetOperatorsJson',{credentials:'same-origin'});allOperators=await res.json();renderOperatorsTable(allOperators);}catch(err){console.error(err);}}
function renderOperatorsTable(operators){const tbody=document.getElementById('operatorsTable');if(!operators.length){tbody.innerHTML='<tr><td colspan="5"><div class="empty-state"><i class="fas fa-users-slash"></i><p>No operators found</p></div></td></tr>';return;}tbody.innerHTML='';operators.forEach(op=>{const row=tbody.insertRow();row.innerHTML=`<td><strong>${escapeHtml(op.name)}</strong></td><td class="td-muted">${escapeHtml(op.email)}</td><td class="td-muted">${escapeHtml(op.phone||'—')}</td><td>${op.department||'—'}</td><td><div class="action-buttons"><button class="btn-edit" onclick="editOperator('${op.id}')"><i class="fas fa-edit"></i> Edit</button><button class="btn-delete" onclick="deleteOperator('${op.id}','${escapeHtml(op.name)}')"><i class="fas fa-trash"></i> Delete</button></div></td>`;});}
function openAddOperatorModal(){document.getElementById('entityType').value='operator';document.getElementById('entityId').value='';document.getElementById('modalTitle').innerText='Add New Operator';['opName','opEmail','opPhone','opPassword'].forEach(id=>document.getElementById(id).value='');document.getElementById('opDepartment').value='';document.getElementById('opDepartment').style.display='block';document.getElementById('operatorModal').classList.add('active');}
function editOperator(id){const op=allOperators.find(o=>o.id===id);if(!op)return;document.getElementById('entityType').value='operator';document.getElementById('entityId').value=op.id;document.getElementById('modalTitle').innerText='Edit Operator';document.getElementById('opName').value=op.name||'';document.getElementById('opEmail').value=op.email||'';document.getElementById('opPhone').value=op.phone||'';document.getElementById('opDepartment').value=op.department||'';document.getElementById('opDepartment').style.display='block';document.getElementById('opPassword').value='';document.getElementById('operatorModal').classList.add('active');}
async function deleteOperator(id,name){showConfirmModal('You are about to permanently delete this operator:',name,async()=>{const res=await fetch('/Admin/DeleteOperator',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id}),credentials:'same-origin'});const result=await res.json();if(result.success){showToast('Operator deleted successfully.','success');logActivity('delete','Deleted Operator: '+name,'Operators Management');}else showToast(result.message,'error');loadOperators();});}

// ===== CITIZENS =====
async function loadCitizens(){try{const res=await fetch('/Admin/GetCitizensJson',{credentials:'same-origin'});allCitizens=await res.json();renderCitizensTable(allCitizens);}catch(err){console.error(err);}}
function renderCitizensTable(citizens){const tbody=document.getElementById('citizensTable');if(!citizens.length){tbody.innerHTML='<tr><td colspan="5"><div class="empty-state"><i class="fas fa-user-slash"></i><p>No citizens found</p></div></td></tr>';return;}tbody.innerHTML='';citizens.forEach(c=>{const row=tbody.insertRow();row.innerHTML=`<td><strong>${escapeHtml(c.name)}</strong></td><td class="td-muted">${escapeHtml(c.email)}</td><td class="td-muted">${escapeHtml(c.phone||'—')}</td><td><span class="badge badge-low">${escapeHtml(c.role)}</span></td><td><div class="action-buttons"><button class="btn-delete" onclick="deleteCitizen('${c.id}','${escapeHtml(c.name)}')"><i class="fas fa-trash"></i> Delete</button></div></td>`;});}
async function deleteCitizen(id,name){showConfirmModal('You are about to permanently delete this citizen:',name,async()=>{const res=await fetch('/Admin/DeleteCitizen',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id}),credentials:'same-origin'});const result=await res.json();if(result.success){showToast('Citizen deleted successfully.','success');logActivity('delete','Deleted Citizen: '+name,'Citizens Management');}else showToast(result.message,'error');loadCitizens();});}

// ===== SAVE ENTITY =====
async function saveEntity(){const entityType=document.getElementById('entityType').value,id=document.getElementById('entityId').value;const data={Id:id,Name:document.getElementById('opName').value.trim(),Email:document.getElementById('opEmail').value.trim(),Phone:document.getElementById('opPhone').value.trim(),PasswordHash:document.getElementById('opPassword').value,Department:entityType==='operator'?document.getElementById('opDepartment').value:null,Role:entityType==='operator'?'Operator':'Citizen'};const url=entityType==='operator'?(id?'/Admin/UpdateOperator?id='+id:'/Admin/CreateOperator'):(id?'/Admin/UpdateCitizen?id='+id:'/Admin/CreateCitizen');try{const res=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data),credentials:'same-origin'});const result=await res.json();if(result.success){showToast(result.message,'success');const action=id?'edit':'create';logActivity(action,(id?'Updated':'Created')+' '+(entityType==='operator'?'Operator':'Citizen')+': '+data.Name,(entityType==='operator'?'Operators':'Citizens')+' Management');closeModal('operatorModal');entityType==='operator'?loadOperators():loadCitizens();}else showToast(result.message,'error');}catch{showToast('Network error','error');}}

function closeModal(id){document.getElementById(id).classList.remove('active');}
function showConfirmModal(message,entityName,onConfirm){document.getElementById('confirmMessage').innerText=message;const chip=document.getElementById('deleteNameChip');if(entityName){chip.innerText=entityName;chip.style.display='inline-block';}else{chip.style.display='none';}confirmCallback=onConfirm;document.getElementById('confirmModal').classList.add('active');}
function closeConfirmModal(){document.getElementById('confirmModal').classList.remove('active');confirmCallback=null;}
document.getElementById('confirmDeleteBtn').addEventListener('click',()=>{if(confirmCallback){confirmCallback();closeConfirmModal();}});
window.onclick=e=>{if(e.target.classList.contains('modal')){e.target.classList.remove('active');if(e.target.id==='confirmModal')closeConfirmModal();}if(e.target.classList.contains('profile-modal-overlay'))e.target.classList.remove('active');};

// ===== ANALYTICS =====
function loadAnalytics(){fetch('/Admin/GetAnalyticsJson',{credentials:'same-origin'}).then(r=>{if(!r.ok)throw new Error(`HTTP ${r.status}`);return r.json();}).then(data=>{if(!data.departments||!data.severity||!data.trend)throw new Error('Invalid data');const allowedDepts=['Fire Department','Police Department','Rescue Department','Unassigned'];const deptCounts={};allowedDepts.forEach(d=>deptCounts[d]=0);let othersCount=0;data.departments.forEach(d=>{if(allowedDepts.includes(d.department))deptCounts[d.department]+=d.count;else othersCount+=d.count;});deptCounts['Unassigned']+=othersCount;const deptLabels=[],deptData=[];for(const[dept,cnt]of Object.entries(deptCounts)){deptLabels.push(dept);deptData.push(cnt);}hideChartError('deptChart','deptChartError');safeDestroy(window.deptChart);window.deptChart=new Chart(document.getElementById('deptChart').getContext('2d'),{type:'doughnut',data:{labels:deptLabels,datasets:[{data:deptData,backgroundColor:['#6366F1','#EC4899','#10B981','#F59E0B'],borderWidth:0,hoverOffset:6}]},options:{responsive:true,maintainAspectRatio:false,cutout:'60%',plugins:CHART_DEFAULTS.plugins}});hideChartError('analyticsSeverityChart','analyticsSeverityError');safeDestroy(window.analyticsSevChart);window.analyticsSevChart=new Chart(document.getElementById('analyticsSeverityChart').getContext('2d'),{type:'bar',data:{labels:['Critical','High','Medium','Low'],datasets:[{label:'Count',data:[data.severity.critical,data.severity.high,data.severity.medium,data.severity.low],backgroundColor:['#DC2626','#F97316','#F59E0B','#10B981'],borderRadius:6}]},options:{responsive:true,maintainAspectRatio:false,...CHART_DEFAULTS,plugins:{legend:{display:false}}}});hideChartError('trendDetailChart','trendDetailError');safeDestroy(window.trendDetailChart);window.trendDetailChart=new Chart(document.getElementById('trendDetailChart').getContext('2d'),{type:'line',data:{labels:data.trend.map(t=>t.date),datasets:[{label:'Total',data:data.trend.map(t=>t.total),borderColor:'#2563EB',backgroundColor:'rgba(37,99,235,0.07)',fill:true,tension:0.4,pointRadius:4,pointBackgroundColor:'#2563EB'},{label:'Resolved',data:data.trend.map(t=>t.resolved),borderColor:'#10B981',backgroundColor:'rgba(16,185,129,0.07)',fill:true,tension:0.4,pointRadius:4,pointBackgroundColor:'#10B981'}]},options:{responsive:true,maintainAspectRatio:false,...CHART_DEFAULTS}});analyticsChartsLoaded=true;}).catch(err=>{showChartError('deptChart','deptChartError','Could not load department data: '+err.message);showChartError('analyticsSeverityChart','analyticsSeverityError','Could not load severity data: '+err.message);showChartError('trendDetailChart','trendDetailError','Could not load trend data: '+err.message);});}

// ===== REPORTS =====
function toggleDownloadMenu(){const menu=document.getElementById('downloadMenu');menu.style.display=menu.style.display==='block'?'none':'block';setTimeout(()=>{window.addEventListener('click',function closeMenu(e){if(!e.target.closest('.download-dropdown')){menu.style.display='none';window.removeEventListener('click',closeMenu);}});},10);}
function toggleQuickMenu(type){const menu=document.getElementById('quickMenu-'+type);const isOpen=menu.style.display==='block';document.querySelectorAll('[id^="quickMenu-"]').forEach(m=>m.style.display='none');if(!isOpen){menu.style.display='block';}setTimeout(()=>{window.addEventListener('click',function closeQuick(e){if(!e.target.closest('.download-dropdown')){menu.style.display='none';window.removeEventListener('click',closeQuick);}});},10);}
function downloadQuickReport(type,format){const today=new Date().toISOString().split('T')[0];let start,end=today;if(type==='today')start=today;if(type==='weekly')start=new Date(Date.now()-7*86400000).toISOString().split('T')[0];if(type==='monthly')start=new Date(Date.now()-30*86400000).toISOString().split('T')[0];logActivity('report',`Downloaded ${type} ${format.toUpperCase()} report`,'Reports');if(format==='csv'){window.open(`/Admin/ExportReport?startDate=${start}&endDate=${end}`,'_blank');}else if(format==='json'){fetch(`/Admin/GetAllIncidentsJson?startDate=${start}&endDate=${end}`,{credentials:'same-origin'}).then(r=>r.json()).then(data=>{const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});const link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download=`IncidentReport_${new Date().toISOString().slice(0,10)}.json`;link.click();URL.revokeObjectURL(link.href);}).catch(()=>showToast('Error generating JSON report.','error'));}else if(format==='pdf'){window.open(`/Admin/ExportPdfReport?startDate=${start}&endDate=${end}`,'_blank');}const menu=document.getElementById('quickMenu-'+type);if(menu)menu.style.display='none';}
async function previewCount(){const start=document.getElementById('reportStartDate').value,end=document.getElementById('reportEndDate').value,dept=document.getElementById('reportDepartment').value,sev=document.getElementById('reportSeverity').value;let url='/Admin/GetAllIncidentsJson';const params=[];if(start)params.push(`startDate=${start}`);if(end)params.push(`endDate=${end}`);if(dept)params.push(`department=${encodeURIComponent(dept)}`);if(sev)params.push(`severity=${encodeURIComponent(sev)}`);if(params.length)url+='?'+params.join('&');try{const res=await fetch(url,{credentials:'same-origin'});const incidents=await res.json();document.getElementById('previewResult').innerText=`${incidents.length} incidents found`;}catch{document.getElementById('previewResult').innerText='Error fetching count';}}
async function downloadCustomReport(format){const start=document.getElementById('reportStartDate').value,end=document.getElementById('reportEndDate').value,dept=document.getElementById('reportDepartment').value,sev=document.getElementById('reportSeverity').value;const buildQuery=()=>{const p=[];if(start)p.push(`startDate=${start}`);if(end)p.push(`endDate=${end}`);if(dept)p.push(`department=${encodeURIComponent(dept)}`);if(sev)p.push(`severity=${encodeURIComponent(sev)}`);return p.join('&');};logActivity('report','Downloaded Custom '+format.toUpperCase()+' Report','Reports');if(format==='csv'){window.open('/Admin/ExportReport?'+buildQuery(),'_blank');}else if(format==='json'){try{const res=await fetch('/Admin/GetAllIncidentsJson?'+buildQuery(),{credentials:'same-origin'});const data=await res.json();const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});const link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download=`IncidentReport_${new Date().toISOString().slice(0,10)}.json`;link.click();URL.revokeObjectURL(link.href);}catch{showToast('Error generating JSON report.','error');}}else if(format==='pdf'){window.open('/Admin/ExportPdfReport?'+buildQuery(),'_blank');}document.getElementById('downloadMenu').style.display='none';}

// ===== INCIDENT DETAIL MODAL =====
async function viewIncidentDetail(incidentId){
    const modal=document.getElementById('incidentDetailModal');
    const content=document.getElementById('incidentDetailModalContent');
    content.innerHTML='<div style="text-align:center;padding:50px 20px;color:#9CA3AF;"><i class="fas fa-spinner fa-spin" style="font-size:24px;display:block;margin-bottom:12px;"></i>Loading incident details...</div>';
    modal.classList.add('active');
    try{
        const res=await fetch(`/Admin/GetIncidentDetailJson?id=${incidentId}`,{credentials:'same-origin'});
        if(!res.ok)throw new Error('Incident not found');
        const inc=await res.json();
        const sevClass=`badge-${inc.severity.toLowerCase()}`;
        const statClass=`status-${inc.status.toLowerCase().replace(' ','')}`;
        const statIcon=inc.status==='Resolved'?'fa-check-circle':'fa-hourglass-half';
        let citizenHtml='';
        if(inc.citizen){
            citizenHtml=`<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px;">
                <div class="incident-info-card"><div class="incident-detail-label"><i class="fas fa-user"></i> Name</div><div class="incident-detail-value">${escapeHtml(inc.citizen.name)}</div></div>
                <div class="incident-info-card"><div class="incident-detail-label"><i class="fas fa-envelope"></i> Email</div><div class="incident-detail-value">${escapeHtml(inc.citizen.email)}</div></div>
                <div class="incident-info-card"><div class="incident-detail-label"><i class="fas fa-phone"></i> Phone</div><div class="incident-detail-value">${escapeHtml(inc.citizen.phone||'N/A')}</div></div>
                <div class="incident-info-card"><div class="incident-detail-label"><i class="fas fa-id-badge"></i> Role</div><div class="incident-detail-value">${escapeHtml(inc.citizen.role)}</div></div>
            </div>`;
        }else{
            citizenHtml='<div style="color:#9CA3AF;font-style:italic;font-size:13px;display:flex;align-items:center;gap:6px;padding:10px 0;"><i class="fas fa-user-slash"></i> Unknown — reported without login</div>';
        }
        content.innerHTML=`
            <div style="margin-bottom:16px;">
                <div style="font-size:18px;font-weight:700;color:#374151;margin-bottom:8px;">${escapeHtml(inc.title)}</div>
                <div style="display:flex;gap:7px;flex-wrap:wrap;">
                    <span class="badge ${sevClass}">${escapeHtml(inc.severity)}</span>
                    <span class="status-badge ${statClass}"><i class="fas ${statIcon}" style="font-size:10px;"></i> ${escapeHtml(inc.status)}</span>
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;">
                <div class="incident-info-card"><div class="incident-detail-label"><i class="fas fa-map-marker-alt"></i> Location</div><div class="incident-detail-value">${escapeHtml(inc.location||'Not specified')}</div></div>
                <div class="incident-info-card"><div class="incident-detail-label"><i class="fas fa-building"></i> Department</div><div class="incident-detail-value">${escapeHtml(inc.department||'Unassigned')}</div></div>
                <div class="incident-info-card"><div class="incident-detail-label"><i class="fas fa-calendar-alt"></i> Reported At</div><div class="incident-detail-value">${new Date(inc.reportedAt).toLocaleString()}</div></div>
                <div class="incident-info-card"><div class="incident-detail-label"><i class="fas fa-clock"></i> Last Updated</div><div class="incident-detail-value">${new Date(inc.updatedAt).toLocaleString()}</div></div>
                <div class="incident-info-card" style="grid-column:span 2;"><div class="incident-detail-label"><i class="fas fa-align-left"></i> Description</div><div class="incident-detail-value" style="white-space:pre-wrap;">${escapeHtml(inc.description||'No description provided.')}</div></div>
            </div>
            <div style="border-top:1px solid #E5E7EB;padding-top:14px;">
                <div class="incident-detail-label" style="margin-bottom:4px;"><i class="fas fa-user"></i> Reported By</div>
                ${citizenHtml}
            </div>`;
        logActivity('view','Viewed Incident: '+inc.title,'Incident #'+incidentId);
    }catch(err){
        content.innerHTML='<div style="text-align:center;padding:40px 20px;color:#DC2626;"><i class="fas fa-exclamation-circle" style="font-size:24px;display:block;margin-bottom:10px;"></i>Could not load incident details.</div>';
        console.error(err);
    }
}
function closeIncidentDetailModal(){document.getElementById('incidentDetailModal').classList.remove('active');}

