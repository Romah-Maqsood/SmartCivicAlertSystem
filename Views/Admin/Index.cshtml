<script>
    // ========== GLOBAL STATE ==========
    let confirmCallback = null;
    let dashboardChartsLoaded = false;
    let analyticsChartsLoaded = false;
    let allCitizens = [];
    let allOperators = [];

    let notifications = [
        { id:1, title:"New critical incident reported", time:"2 mins ago", read:false },
        { id:2, title:"Operator John Doe created", time:"1 hour ago", read:false },
        { id:3, title:"Monthly report generated", time:"3 hours ago", read:true },
        { id:4, title:"Server backup completed", time:"1 day ago", read:true }
    ];

    const activityLog = [
        { action: "Logged in from Chrome · Windows", time: "2 hours ago", icon: "fa-sign-in-alt" },
        { action: "Updated operator Jane Doe", time: "5 hours ago", icon: "fa-user-edit" },
        { action: "Deleted incident #103", time: "1 day ago", icon: "fa-trash" },
        { action: "Generated monthly report", time: "2 days ago", icon: "fa-file-alt" },
        { action: "Changed password", time: "3 days ago", icon: "fa-lock" },
        { action: "Added operator Mike Chen", time: "5 days ago", icon: "fa-user-plus" },
    ];

    // ========== CLOCK ==========
    function updateClock() {
        const now = new Date();
        const h = now.getHours(), m = now.getMinutes();
        const ampm = h >= 12 ? 'PM' : 'AM';
        const hh = (h % 12 || 12).toString().padStart(2, '0');
        const mm = m.toString().padStart(2, '0');
        const el = document.getElementById('clockDisplay');
        if (el) el.textContent = `${hh}:${mm} ${ampm}`;
        const dt = document.getElementById('dropdownTime');
        if (dt) dt.textContent = now.toLocaleDateString('en-PK', { day:'numeric', month:'short', year:'numeric' });
    }
    setInterval(updateClock, 1000);
    updateClock();

    // ========== GLOBAL SEARCH ==========
    function handleGlobalSearch() {
        const q = document.getElementById('globalSearch').value.trim().toLowerCase();
        if (!q) return;
        // Navigate to incidents and filter
        showSection('incidents');
        setTimeout(() => {
            const rows = document.querySelectorAll('#allIncidentsTable tr');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = (!q || text.includes(q)) ? '' : 'none';
            });
        }, 600);
    }

    // ========== TOAST ==========
    function showToast(message, type = 'success') {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';
        toast.innerHTML = `<i class="fas ${icon}"></i><span class="toast-msg">${message}</span><i class="fas fa-times toast-close" onclick="this.parentElement.remove()"></i>`;
        container.appendChild(toast);
        setTimeout(() => { if (toast.parentElement) toast.remove(); }, 4000);
    }

    // ========== NOTIFICATIONS ==========
    function updateNotificationBadge() {
        const unread = notifications.filter(n => !n.read).length;
        const badge = document.getElementById('notifBadge');
        const dot = document.getElementById('notifDotTop');
        const count = document.getElementById('dropdownNotifCount');
        if (badge) { badge.innerText = unread; badge.style.display = unread > 0 ? 'inline-block' : 'none'; }
        if (dot) dot.style.display = unread > 0 ? 'block' : 'none';
        if (count) count.textContent = unread;
    }
    function renderNotifications() {
