    function checkPasswordStrength() {
        const pwd = document.getElementById('editPassword').value;
        const fill = document.getElementById('pwStrengthFill');
        const text = document.getElementById('pwStrengthText');
        if (!fill) return;
        if (!pwd) { fill.style.width = '0'; text.textContent = ''; return; }
        let strength = 0;
        if (pwd.length >= 8) strength++;
        if (/[A-Z]/.test(pwd)) strength++;
        if (/[0-9]/.test(pwd)) strength++;
        if (/[^A-Za-z0-9]/.test(pwd)) strength++;
        const levels = ['', 'Weak', 'Fair', 'Good', 'Strong'];
        const colors = ['', '#DC2626', '#F59E0B', '#3B82F6', '#10B981'];
        const widths = ['0%', '25%', '55%', '78%', '100%'];
        fill.style.width = widths[strength];
        fill.style.background = colors[strength];
        text.textContent = levels[strength];
        text.style.color = colors[strength];
    }

    function saveProfile() {
        const name = document.getElementById('editName').value.trim();
        const currentPwd = document.getElementById('currentPassword').value;
        const newPwd = document.getElementById('editPassword').value;
        const confirmPwd = document.getElementById('editPasswordConfirm').value;
        if (!name) { showToast('Name cannot be empty.', 'error'); return; }
        if (newPwd || confirmPwd) {
            if (!currentPwd) { showToast('Please enter your current password.', 'error'); return; }
            if (newPwd !== confirmPwd) { showToast('New passwords do not match.', 'error'); return; }
            if (newPwd.length < 6) { showToast('Password must be at least 6 characters.', 'error'); return; }
        }
        // TODO: call backend
        showToast('Profile updated successfully!', 'success');
        closeModal('profileModal');
    }

