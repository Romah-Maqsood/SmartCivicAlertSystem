    async function downloadCustomReport(format) {
        const start = document.getElementById('reportStartDate').value;
        const end   = document.getElementById('reportEndDate').value;
        const dept  = document.getElementById('reportDepartment').value;
        const sev   = document.getElementById('reportSeverity').value;
        const buildQuery = () => {
            const p = [];
            if (start) p.push(`startDate=${start}`);
            if (end)   p.push(`endDate=${end}`);
            if (dept)  p.push(`department=${encodeURIComponent(dept)}`);
            if (sev)   p.push(`severity=${encodeURIComponent(sev)}`);
            return p.join('&');
        };
        if (format === 'csv') {
            window.open('/Admin/ExportReport?' + buildQuery(), '_blank');
        } else if (format === 'json') {
            try {
                const res = await fetch('/Admin/GetAllIncidentsJson?' + buildQuery(), { credentials: 'same-origin' });
                const data = await res.json();
                const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = `IncidentReport_${new Date().toISOString().slice(0,10)}.json`;
                link.click();
                URL.revokeObjectURL(link.href);
            } catch { showToast('Error generating JSON report.', 'error'); }
        } else if (format === 'pdf') {
            window.open('/Admin/ExportPdfReport?' + buildQuery(), '_blank');
        }
        document.getElementById('downloadMenu').style.display = 'none';
    }

    // ========== INIT ==========
    document.addEventListener('DOMContentLoaded', () => {
        updateNotificationBadge();
        if (typeof Chart === 'undefined') {
            document.querySelectorAll('.chart-canvas-wrapper').forEach(w => {
                w.innerHTML = '<p class="chart-error">Chart.js failed to load. Check your internet connection.</p>';
            });
        } else {
            loadDashboardCharts();
        }
    });
</script>
</body>
</html>
