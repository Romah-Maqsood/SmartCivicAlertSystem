            if (result.success) {
                showToast(result.message, 'success');
                closeModal('operatorModal');
                entityType === 'operator' ? loadOperators() : loadCitizens();
            } else {
                showToast(result.message, 'error');
            }
        } catch { showToast('Network error', 'error'); }
    }

