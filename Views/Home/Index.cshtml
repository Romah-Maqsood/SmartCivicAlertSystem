<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <i class="fas fa-city"></i> SMART CIVIC <span>ALERT</span>
        </a>
        <div class="nav-links">
            <a href="/Account/Login"><i class="fas fa-sign-in-alt"></i> Login</a>
            <a href="/Account/Register"><i class="fas fa-user-plus"></i> Register</a>
        </div>
    </nav>

    <div class="container">

        <!-- HERO -->
        <div class="hero-section">
            <div class="hero-badge">
                <i class="fas fa-robot"></i> AI-Powered Incident Management
            </div>
            <h1 class="hero-title">
                <span class="gradient-text">Smart Civic</span><br />
                Alert System
            </h1>
            <p class="hero-subtitle">
                Report city problems instantly, get real-time updates, and let AI
                route incidents to the right department automatically.
            </p>
            <div class="hero-buttons">
                <a href="/Incident/Create" class="btn btn-primary">
                    <i class="fas fa-exclamation-triangle"></i> Report Incident
                </a>
                <a href="/Incident/Map" class="btn btn-ghost">
                    <i class="fas fa-map-marker-alt"></i> View Live Map
                </a>
            </div>
        </div>

        <!-- FEATURES -->
        <div class="section-label">Core Features</div>
        <h2 class="section-title">Why Choose Smart Civic Alert?</h2>
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon-box"><i class="fas fa-robot"></i></div>
                <h3>AI Severity Predictor</h3>
                <p>AI automatically detects incident severity from your description.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon-box"><i class="fas fa-route"></i></div>
                <h3>Real-time Routing</h3>
                <p>Incidents auto-routed to Fire, Police, or Rescue departments.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon-box"><i class="fas fa-map-marker-alt"></i></div>
                <h3>Live Map Tracking</h3>
                <p>Track incidents on map with color-coded severity markers.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon-box"><i class="fas fa-comment-dots"></i></div>
                <h3>AI Chatbot Assistant</h3>
                <p>Ask about incident status anytime, day or night.</p>
            </div>
        </div>

        <!-- HOW IT WORKS -->
        <div class="section-label">Process</div>
        <h2 class="section-title">How It Works</h2>
        <div class="steps-container">
            <div class="step">
                <div class="step-number">1</div>
                <div class="step-icon-box"><i class="fas fa-edit"></i></div>
                <h4>Report Issue</h4>
                <p>Citizen reports incident via web form</p>
            </div>
            <div class="step-arrow"><i class="fas fa-arrow-right"></i></div>
            <div class="step">
                <div class="step-number">2</div>
                <div class="step-icon-box"><i class="fas fa-microchip"></i></div>
                <h4>AI Analysis</h4>
                <p>AI predicts severity and routes to department</p>
            </div>
            <div class="step-arrow"><i class="fas fa-arrow-right"></i></div>
            <div class="step">
                <div class="step-number">3</div>
                <div class="step-icon-box"><i class="fas fa-truck"></i></div>
                <h4>Department Response</h4>
                <p>Operator accepts and updates status</p>
            </div>
            <div class="step-arrow"><i class="fas fa-arrow-right"></i></div>
            <div class="step">
                <div class="step-number">4</div>
                <div class="step-icon-box"><i class="fas fa-check-circle"></i></div>
                <h4>Issue Resolved</h4>
                <p>Status updated, citizen notified</p>
            </div>
        </div>

        <!-- STATS -->
        <div class="stats-grid">
            <div class="stat-card stat-blue">
                <div class="stat-value">24/7</div>
                <div class="stat-label"><i class="fas fa-clock"></i> Reporting Available</div>
            </div>
            <div class="stat-card stat-purple">
                <div class="stat-value">AI</div>
                <div class="stat-label"><i class="fas fa-brain"></i> Powered Detection</div>
            </div>
            <div class="stat-card stat-green">
                <div class="stat-value">Live</div>
                <div class="stat-label"><i class="fas fa-bell"></i> Notifications</div>
            </div>
            <div class="stat-card stat-amber">
                <div class="stat-value">3+</div>
                <div class="stat-label"><i class="fas fa-building"></i> Departments</div>
            </div>
        </div>

        <!-- FAQ -->
        <div class="faq-section">
            <h2>Frequently Asked Questions</h2>
            <div class="faq-container">

                <div class="faq-item active">
                    <button class="faq-question" onclick="toggleFAQ(this)">
                        <span>How do I report an incident?</span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    <div class="faq-answer">
                        <p>Click the <a href="/Incident/Create">"Report Incident"</a> button on this page. No login needed — fill out the form and our AI will automatically route it to the correct department.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question" onclick="toggleFAQ(this)">
                        <span>Do I need to create an account to report an issue?</span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    <div class="faq-answer">
                        <p>No account required. However, <a href="/Account/Register">registering</a> lets you track your reports, receive status updates, and view your reporting history. It only takes a minute!</p>
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question" onclick="toggleFAQ(this)">
                        <span>What happens after I submit a report?</span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    <div class="faq-answer">
                        <p>Our AI analyzes the severity and category, then auto-routes to the right department (Fire, Police, or Rescue). The operator reviews and updates the status — registered users receive real-time notifications.</p>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- FOOTER -->
    <footer class="footer">
        <p><i class="far fa-copyright"></i> 2026 Smart Civic Alert System — AI-Powered City Incident Management</p>
    </footer>

    <script>
        function toggleFAQ(button) {
            const faqItem = button.parentElement;
            const isActive = faqItem.classList.contains('active');
            document.querySelectorAll('.faq-item').forEach(item => {
                item.classList.remove('active');
            });
            if (!isActive) {
                faqItem.classList.add('active');
            }
        }
    </script>

</body>
</html>
