@{
    Layout = null;
    ViewData["Title"] = "Register - Smart Civic Alert";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: #E8EDF5;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Navbar - New Theme */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: #FFFFFF;
            border-bottom: 1px solid #EAECF0;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
        }

        .navbar-brand {
            color: #1A1F36;
            font-size: 1.25rem;
            font-weight: 700;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .navbar-brand i {
                color: #2563EB;
            }

            .navbar-brand span {
                color: #2563EB;
            }

        .nav-links a {
            color: #6B7280;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.875rem;
            font-weight: 500;
            transition: color 0.3s ease;
        }

            .nav-links a:hover {
                color: #2563EB;
            }

        .register-container {
            width: 100%;
            max-width: 500px;
            padding: 2rem;
            margin-top: 80px;
        }

        .register-card {
            background: #FFFFFF;
            border: 1px solid #EAECF0;
            border-radius: 24px;
            padding: 2rem;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
        }

        .logo {
            text-align: center;
            margin-bottom: 2rem;
        }

            .logo i {
                font-size: 3rem;
                color: #2563EB;
                margin-bottom: 0.5rem;
            }

            .logo h2 {
                color: #1A1F36;
                font-size: 1.5rem;
                font-weight: 700;
            }

            .logo span {
                color: #2563EB;
            }

        .input-group {
            margin-bottom: 1.5rem;
        }

            .input-group label {
                display: block;
                color: #6B7280;
                font-size: 0.75rem;
                font-weight: 500;
                margin-bottom: 0.5rem;
            }

        .input-wrapper {
            position: relative;
        }

            .input-wrapper i {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: #94A3B8;
            }

        .input-group input {
            width: 100%;
            padding: 0.75rem 1rem 0.75rem 2.5rem;
            background: #FFFFFF;
            border: 1px solid #EAECF0;
            border-radius: 12px;
            color: #1A1F36;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

            .input-group input:focus {
                outline: none;
                border-color: #2563EB;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
            }

            .input-group input::placeholder {
                color: #94A3B8;
            }

        .btn-register {
            width: 100%;
            padding: 0.75rem;
            background: #2563EB;
            border: none;
            border-radius: 40px;
            color: white;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

            .btn-register:hover {
                background: #1D4ED8;
                transform: translateY(-1px);
            }

        .login-link {
            text-align: center;
            color: #6B7280;
            font-size: 0.75rem;
            margin-top: 1.5rem;
        }

            .login-link a {
                color: #2563EB;
                text-decoration: none;
                font-weight: 500;
            }

                .login-link a:hover {
                    text-decoration: underline;
                }

        .alert-error {
            background: #FEF2F2;
            color: #DC2626;
            padding: 0.75rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
            border-left: 3px solid #DC2626;
            font-size: 0.75rem;
        }

        .password-hint {
            font-size: 0.65rem;
            color: #94A3B8;
            margin-top: 0.25rem;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .navbar {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }

            .register-container {
                padding: 1rem;
                margin-top: 120px;
            }
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <i class="fas fa-city"></i> SMART CIVIC <span>ALERT</span>
        </a>
        <div class="nav-links">
            <a href="/Account/Login"><i class="fas fa-sign-in-alt"></i> Login</a>
        </div>
    </nav>

    <div class="register-container">
        <div class="register-card">
            <div class="logo">
                <i class="fas fa-user-plus"></i>
                <h2>Create <span>Account</span></h2>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-error">@ViewBag.Error</div>
            }

            <form method="post" action="/Account/Register">
                <div class="input-group">
                    <label>Full Name</label>
                    <div class="input-wrapper">
                        <i class="fas fa-user"></i>
                        <input type="text" name="name" placeholder="Enter your full name" required>
                    </div>
                </div>

                <div class="input-group">
                    <label>Email Address</label>
                    <div class="input-wrapper">
                        <i class="fas fa-envelope"></i>
                        <input type="email" name="email" placeholder="Enter your email" required>
                    </div>
                </div>

                <div class="input-group">
                    <label>Phone Number (Optional)</label>
                    <div class="input-wrapper">
                        <i class="fas fa-phone"></i>
                        <input type="tel" name="phone" placeholder="Enter your phone number">
                    </div>
                </div>

                <div class="input-group">
                    <label>Password</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock"></i>
                        <input type="password" name="password" placeholder="Create a password" required>
                    </div>
                    <div class="password-hint">Password must be at least 6 characters</div>
                </div>

                <div class="input-group">
                    <label>Confirm Password</label>
                    <div class="input-wrapper">
                        <i class="fas fa-check-circle"></i>
                        <input type="password" name="confirmPassword" placeholder="Confirm your password" required>
                    </div>
                </div>

                <button type="submit" class="btn-register">
                    <i class="fas fa-user-plus"></i> Register
                </button>

                <div class="login-link">
                    Already have an account? <a href="/Account/Login">Login here</a>
                </div>
            </form>
        </div>
    </div>

</body>
</html>